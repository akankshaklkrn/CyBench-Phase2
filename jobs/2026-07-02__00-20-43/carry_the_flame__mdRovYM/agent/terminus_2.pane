[?2004lcat << 'EOF' > test_add.py
import socket
def run():
    s = socket.socket()
    s.connect(("target", 8133))
    s.recv(1024)
    def query(pt_int):
        pt = pt_int.to_bytes(5, 'big')
        s.sendall(pt.hex().encode() + b"\n")
        resp = b""
        while b"pt: " not in resp:
            resp += s.recv(1024)
        return int.from_bytes(bytes.fromhex(resp.decode().split("\n")[0].strip()), 'big')
    
    c0 = query(0)
    cx = query(100)
    cy = query(200)
    cxy = query(300)
    
    calc = (cx + cy - c0) % (2**40)
    print("Is additive affine?", calc == cxy)
    print("cxy:", cxy)
    print("calc:", calc)
    s.close()
run()
EOF
