[280.293518, "i", "cat << 'EOF' >> /target.c\n    if (chunk->canary_hdr != expected_canary) return -4;\n    uint64_t *canary_ftr = (uint64_t*)((uint8_t*)chunk + sizeof(sec_chunk_t) + aligned_size);\n    if (*canary_ftr != expected_canary) return -4;\n    \n    chunk->state = CHUNK_STATE_FREE;\n    chunk->user_size = 0;\n    chunk->canary_hdr = 0;\n    \n    chunk->next_enc = (uint64_t)(uintptr_t)heap->freelist_head ^ (heap->heap_cookie ^ ((uint64_t)(uintptr_t)chunk >> 4));\n    heap->freelist_head = chunk;\n    \n    return 0;\n}\nEOF\n"]
[280.486375, "i", "cat << 'EOF' >> /target.c\n\nint sec_check_integrity(sec_heap_t *heap) {\n    if (!heap) return -1;\n    uint32_t offset = 0;\n    while (offset < SEC_HEAP_POOL_SIZE) {\n        sec_chunk_t *curr = (sec_chunk_t*)(heap->memory_pool + offset);\n        if (curr->total_size < SEC_MIN_CHUNK_SIZE || offset + curr->total_size > SEC_HEAP_POOL_SIZE) {\n            return -5;\n        }\n        if (curr->state == CHUNK_STATE_ALLOCATED) {\nEOF\n"]
[280.703533, "i", "cat << 'EOF' >> /target.c\n            uint32_t aligned_size = (curr->user_size + 7) & ~7;\n            uint64_t expected = heap->heap_cookie ^ (uint64_t)(uintptr_t)curr ^ curr->user_size;\n            if (curr->canary_hdr != expected) return -4;\n            uint64_t *canary_ftr = (uint64_t*)((uint8_t*)curr + sizeof(sec_chunk_t) + aligned_size);\n            if (*canary_ftr != expected) return -4;\n        }\n        offset += curr->total_size;\n    }\n    return 0;\n}\nEOF\n"]
