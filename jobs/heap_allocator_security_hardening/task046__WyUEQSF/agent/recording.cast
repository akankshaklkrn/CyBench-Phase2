[279.880226, "i", "cat << 'EOF' >> /target.c\n    uint64_t expected_canary = heap->heap_cookie ^ (uint64_t)(uintptr_t)curr ^ curr->user_size;\n    curr->canary_hdr = expected_canary;\n    uint64_t *canary_ftr = (uint64_t*)((uint8_t*)curr + sizeof(sec_chunk_t) + aligned_size);\n    *canary_ftr = expected_canary;\n    \n    return (void*)((uint8_t*)curr + sizeof(sec_chunk_t));\n}\n\nint sec_free(sec_heap_t *heap, void *ptr) {\n    if (!heap || !ptr) return -1;\nEOF\n"]
