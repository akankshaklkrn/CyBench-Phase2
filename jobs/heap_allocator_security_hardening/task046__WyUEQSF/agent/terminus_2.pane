cat << 'EOF' > /target.c
#include <stdint.h>
#include <stdbool.h>
#include <stddef.h>

#ifndef SEC_HEAP_POOL_SIZE
#define SEC_HEAP_POOL_SIZE 65536
#define SEC_MIN_CHUNK_SIZE 32
#define SEC_COOKIE_SALT 0xA5A55A5A12345678ULL

typedef enum {
    CHUNK_STATE_FREE = 0,
    CHUNK_STATE_ALLOCATED = 1
} chunk_state_t;

typedef struct {
    uint32_t total_size;
    uint32_t user_size;
    chunk_state_t state;
    uint32_t _pad;
    uint64_t canary_hdr;
    uint64_t next_enc;
} sec_chunk_t;

typedef struct {
    uint8_t memory_pool[SEC_HEAP_POOL_SIZE];
    uint64_t heap_cookie;
    sec_chunk_t *freelist_head;
    bool is_initialized;
} sec_heap_t;
#endif

void sec_heap_init(sec_heap_t *heap, uint64_t secret_cookie) {
    if (!heap) return;
    heap->is_initialized = true;
    heap->heap_cookie = secret_cookie ^ SEC_COOKIE_SALT;
    sec_chunk_t *initial_chunk = (sec_chunk_t*)heap->memory_pool;
    initial_chunk->total_size = SEC_HEAP_POOL_SIZE;
    initial_chunk->user_size = 0;
    initial_chunk->state = CHUNK_STATE_FREE;
    initial_chunk->canary_hdr = 0;
    initial_chunk->next_enc = 0 ^ (heap->heap_cookie ^ ((uint64_t)(uintptr_t)initial_chunk >> 4));
    heap->freelist_head = initial_chunk;
}

void* sec_malloc(sec_heap_t *heap, uint32_t size) {
    if (!heap || !heap->is_initialized || size == 0) return NULL;
    
    uint32_t aligned_size = (size + 7) & ~7;
    uint32_t req_size = sizeof(sec_chunk_t) + aligned_size + 8;
    req_size = (req_size + 7) & ~7;
    if (req_size < SEC_MIN_CHUNK_SIZE) req_size = SEC_MIN_CHUNK_SIZE;
    
    sec_chunk_t *curr = heap->freelist_head;
    sec_chunk_t *prev = NULL;
    
    while (curr != NULL) {
        if (curr->total_size >= req_size) {
            break;
        }
        sec_chunk_t *next = (sec_chunk_t*)(uintptr_t)(curr->next_enc ^ (heap->heap_cookie ^ ((uint64_t)(uintptr_t)curr >> 4)));
        prev = curr;
        curr = next;
    }
    
    if (!curr) return NULL;
    
    sec_chunk_t *next_of_curr = (sec_chunk_t*)(uintptr_t)(curr->next_enc ^ (heap->heap_cookie ^ ((uint64_t)(uintptr_t)curr >> 4)));
    
    if (curr->total_size - req_size >= SEC_MIN_CHUNK_SIZE) {
        sec_chunk_t *split_chunk = (sec_chunk_t*)((uint8_t*)curr + req_size);
        split_chunk->total_size = curr->total_size - req_size;
        split_chunk->state = CHUNK_STATE_FREE;
        split_chunk->user_size = 0;
        split_chunk->next_enc = (uint64_t)(uintptr_t)next_of_curr ^ (heap->heap_cookie ^ ((uint64_t)(uintptr_t)split_chunk >> 4));
        
        curr->total_size = req_size;
        
        if (prev) {
            prev->next_enc = (uint64_t)(uintptr_t)split_chunk ^ (heap->heap_cookie ^ ((uint64_t)(uintptr_t)prev >> 4));
        } else {
            heap->freelist_head = split_chunk;
        }
    } else {
        if (prev) {
            prev->next_enc = (uint64_t)(uintptr_t)next_of_curr ^ (heap->heap_cookie ^ ((uint64_t)(uintptr_t)prev >> 4));
        } else {
            heap->freelist_head = next_of_curr;
        }
    }
    
    curr->state = CHUNK_STATE_ALLOCATED;
    curr->user_size = size;
    
    uint64_t expected_canary = heap->heap_cookie ^ (uint64_t)(uintptr_t)curr ^ curr->user_size;
    curr->canary_hdr = expected_canary;
    uint64_t *canary_ftr = (uint64_t*)((uint8_t*)curr + sizeof(sec_chunk_t) + aligned_size);
    *canary_ftr = expected_canary;
    
    return (void*)((uint8_t*)curr + sizeof(sec_chunk_t));
}

int sec_free(sec_heap_t *heap, void *ptr) {
    if (!heap || !ptr) return -1;
    
    sec_chunk_t *chunk = (sec_chunk_t*)((uint8_t*)ptr - sizeof(sec_chunk_t));
    if ((uint8_t*)chunk < heap->memory_pool || (uint8_t*)chunk >= heap->memory_pool + SEC_HEAP_POOL_SIZE) {
        return -2;
    }
    
    if (chunk->state == CHUNK_STATE_FREE) {
        return -3;
    }
    
    uint32_t aligned_size = (chunk->user_size + 7) & ~7;
    uint64_t expected_canary = heap->heap_cookie ^ (uint64_t)(uintptr_t)chunk ^ chunk->user_size;
    if (chunk->canary_hdr != expected_canary) return -4;
    
    uint64_t *canary_ftr = (uint64_t*)((uint8_t*)chunk + sizeof(sec_