[754.873974, "i", "cat << 'EOF' > target.c\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdint.h>\n#include <stddef.h>\n#include <string.h>\n#include <sys/mman.h>\n\nstatic int x86_reg(int vreg) {\n    if (vreg == 0) return 0; // eax\n    if (vreg == 1) return 1; // ecx\n    if (vreg == 2) return 2; // edx\n    if (vreg == 3) return 6; // esi\n    return 0;\n}\n\nint (*jit_compile(const uint8_t *bytecode, size_t len))(void) {\n    if (!bytecode || len == 0) return NULL;\n    \n    size_t cap = len * 8 + 4096;\n    uint8_t *code = mmap(NULL, cap, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);\n    if (code == MAP_FAILED) return NULL;\n    \n    size_t *ins_start = malloc(len * sizeof(size_t));\n    size_t num_ins = 0;\n    size_t pc = 0;\n    \n    while (pc < len) {\n        uint8_t op = bytecode[pc];\n        ins_start[num_ins] = pc;\n        if (op == 1) { pc += 6; }\n        else if (op == 2 || op == 3 || op == 4 || op == 5 || op == 7) { pc += 3; }\n        else if (op == 6 || op == 8) { pc += 2; }\n        else { break; }\n "]
[754.874031, "i", "       num_ins++;\n    }\n    \n    size_t *emit_offset = malloc((num_ins + 1) * sizeof(size_t));\n    size_t out_sz = 0;\n    \n    #define EMIT1(b) code[out_sz++] = (uint8_t)(b)\n    #define EMIT2(b1, b2) do { EMIT1(b1); EMIT1(b2); } while(0)\n    #define EMIT4(dw) do { uint32_t __v = (dw); memcpy(&code[out_sz], &__v, 4); out_sz += 4; } while(0)\n\n    for (size_t i = 0; i < num_ins; i++) {\n        emit_offset[i] = out_sz;\n        size_t bpc = ins_start[i];\n        uint8_t op = bytecode[bpc];\n        \n        if (op == 1) {\n            uint8_t reg = bytecode[bpc+1];\n            uint32_t imm;\n            memcpy(&imm, &bytecode[bpc+2], 4);\n            EMIT1(0xB8 + x86_reg(reg));\n            EMIT4(imm);\n        } else if (op == 2) { \n            uint8_t dst = bytecode[bpc+1];\n            uint8_t src = bytecode[bpc+2];\n            EMIT2(0x01, 0xC0 | (x86_reg(src) << 3) | x86_reg(dst));\n        } else if (op == 3) { \n            uint8_t dst = bytecode[bpc+1];\n            uint8_t src = bytecode[bpc+2];\n            EMIT2(0x"]
[754.874221, "i", "29, 0xC0 | (x86_reg(src) << 3) | x86_reg(dst));\n        } else if (op == 4) { \n            uint8_t dst = bytecode[bpc+1];\n            uint8_t src = bytecode[bpc+2];\n            EMIT1(0x0F);\n            EMIT2(0xAF, 0xC0 | (x86_reg(dst) << 3) | x86_reg(src));\n        } else if (op == 5) { \n            uint8_t dst = bytecode[bpc+1];\n            uint8_t src = bytecode[bpc+2];\n            EMIT2(0x89, 0xC0 | (x86_reg(src) << 3) | x86_reg(dst));\n        } else if (op == 6) { \n            EMIT1(0xE9);\n            EMIT4(0); \n        } else if (op == 7) { \n            uint8_t reg = bytecode[bpc+1];\n            EMIT2(0x85, 0xC0 | (x86_reg(reg) << 3) | x86_reg(reg)); \n            EMIT2(0x0F, 0x84);\n            EMIT4(0); \n        } else if (op == 8) { \n            uint8_t reg = bytecode[bpc+1];\n            if (x86_reg(reg) != 0) { \n                EMIT2(0x89, 0xC0 | (x86_reg(reg) << 3) | 0); \n            }\n            EMIT1(0xC3); \n        }\n    }\n    emit_offset[num_ins] = out_sz;\n    \n    for (size_t i = 0; i < num_ins;"]
