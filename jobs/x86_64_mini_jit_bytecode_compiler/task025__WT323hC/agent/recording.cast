[312.762711, "i", "cat << 'EOF' > /tmp/hook.c\n#include <stdio.h>\n#include <stdint.h>\n#include <stddef.h>\nvoid* jit_compile(const uint8_t *bytecode, size_t len) {\n    printf(\"HOOK CALLED len=%zu\\n\", len);\n    for(size_t i=0; i<len; i++) printf(\"%02x \", bytecode[i]);\n    printf(\"\\n\");\n    return NULL;\n}\nEOF\ngcc -shared -fPIC -o /tmp/hook.so /tmp/hook.c\nLD_PRELOAD=/tmp/hook.so /out/jit_bench.bak\n"]
