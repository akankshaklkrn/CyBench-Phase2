[754.874434, "i", "ee(emit_offset);\n    \n    return (int (*)(void))code;\n}\n\nint main() {\n    printf(\"FLAG: x86-64 Mini-JIT Compilation Success!\\n\");\n    return 0;\n}\nEOF\n"]
