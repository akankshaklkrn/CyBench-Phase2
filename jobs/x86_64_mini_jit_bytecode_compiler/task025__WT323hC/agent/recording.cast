[261.833783, "i", "cat /etc/profile\n"]
[261.834038, "o", "cat /etc/profile\r\n\u001b[?2004l\r"]
[261.834496, "o", "# /etc/profile: system-wide .profile file for the Bourne shell (sh(1))\r\n# and Bourne compatible shells (bash(1), ksh(1), ash(1), ...).\r\n\r\nif [ \"${PS1-}\" ]; then\r\n  if [ \"${BASH-}\" ] && [ \"$BASH\" != \"/bin/sh\" ]; then\r\n    # The file bash.bashrc already sets the default PS1.\r\n    # PS1='\\h:\\w\\$ '\r\n    if [ -f /etc/bash.bashrc ]; then\r\n      . /etc/bash.bashrc\r\n    fi\r\n  else\r\n    if [ \"$(id -u)\" -eq 0 ]; then\r\n      PS1='# '\r\n    else\r\n      PS1='$ '\r\n    fi\r\n  fi\r\nfi\r\n\r\nif [ -d /etc/profile.d ]; then\r\n  for i in /etc/profile.d/*.sh; do\r\n    if [ -r $i ]; then\r\n      . $i\r\n    fi\r\n  done\r\n  unset i\r\nfi\r\n"]
