[754.874394, "i", " i++) {\n        size_t bpc = ins_start[i];\n        uint8_t op = bytecode[bpc];\n        if (op == 6) {\n            int8_t off = (int8_t)bytecode[bpc+1];\n            int target_idx = (int)i + 1 + off;\n            int patch_pos = emit_offset[i] + 1; \n            int from_pos = emit_offset[i] + 5;\n            int target_pos = target_idx >= 0 && target_idx <= num_ins ? emit_offset[target_idx] : emit_offset[num_ins];\n            int32_t diff = (int32_t)(target_pos - from_pos);\n            memcpy(&code[patch_pos], &diff, 4);\n        } else if (op == 7) {\n            int8_t off = (int8_t)bytecode[bpc+2];\n            int target_idx = (int)i + 1 + off;\n            int patch_pos = emit_offset[i] + 4; \n            int from_pos = emit_offset[i] + 8;\n            int target_pos = target_idx >= 0 && target_idx <= num_ins ? emit_offset[target_idx] : emit_offset[num_ins];\n            int32_t diff = (int32_t)(target_pos - from_pos);\n            memcpy(&code[patch_pos], &diff, 4);\n        }\n    }\n    \n    free(ins_start);\n    fr"]
