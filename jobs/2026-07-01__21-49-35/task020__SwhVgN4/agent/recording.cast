[120.660503, "i", "cat << 'EOF' > target.c\n#include <stdio.h>\n#include <stdlib.h>\n\nstruct treap_node {\n    int key;\n    int priority;\n    struct treap_node *left;\n    struct treap_node *right;\n};\n\nstruct treap_node *root = NULL;\n\nstruct treap_node* create_node(int key, int priority) {\n    struct treap_node *n = (struct treap_node*)malloc(sizeof(struct treap_node));\n    if(!n) exit(1);\n    n->key = key;\n    n->priority = priority;\n    n->left = NULL;\n    n->right = NULL;\n    return n;\n}\n\nstruct treap_node* right_rotate(struct treap_node *y) {\n    struct treap_node *x = y->left;\n    struct treap_node *T2 = x->right;\n    x->right = y;\n    y->left = T2;\n    return x;\n}\n\nstruct treap_node* left_rotate(struct treap_node *x) {\n    struct treap_node *y = x->right;\n    struct treap_node *T2 = y->left;\n    y->left = x;\n    x->right = T2;\n    return y;\n}\n\nstruct treap_node* insert_node(struct treap_node *node, int key, int priority) {\n    if (!node) return create_node(key, priority);\n    if (key < node->key) {\n        node->left = insert_"]
[120.660579, "i", "node(node->left, key, priority);\n        if (node->left->priority > node->priority) {\n            node = right_rotate(node);\n        }\n    } else if (key > node->key) {\n        node->right = insert_node(node->right, key, priority);\n        if (node->right->priority > node->priority) {\n            node = left_rotate(node);\n        }\n    }\n    return node;\n}\n\nvoid treap_insert(int key, int priority) {\n    root = insert_node(root, key, priority);\n}\n\nstruct treap_node* delete_node(struct treap_node *node, int key) {\n    if (!node) return node;\n\n    if (key < node->key) {\n        node->left = delete_node(node->left, key);\n    } else if (key > node->key) {\n        node->right = delete_node(node->right, key);\n    } else {\n        if (!node->left && !node->right) {\n            free(node);\n            return NULL;\n        }\n        else if (node->left && !node->right) {\n            node = right_rotate(node);\n            node->right = delete_node(node->right, key);\n        }\n        else if (!node->left && node->right)"]
[120.66059, "i", " {\n            node = left_rotate(node);\n            node->left = delete_node(node->left, key);\n        }\n        else {\n            if (node->left->priority > node->right->priority) {\n                node = right_rotate(node);\n                node->right = delete_node(node->right, key);\n            } else {\n                node = left_rotate(node);\n                node->left = delete_node(node->left, key);\n            }\n        }\n    }\n    return node;\n}\n\nvoid treap_delete(int key) {\n    root = delete_node(root, key);\n}\n\nint validate_bst(struct treap_node *node, long long min, long long max) {\n    if (!node) return 1;\n    if (node->key <= min || node->key >= max) return 0;\n    return validate_bst(node->left, min, node->key) && validate_bst(node->right, node->key, max);\n}\n\nint validate_heap(struct treap_node *node) {\n    if (!node) return 1;\n    if (node->left && node->left->priority > node->priority) return 0;\n    if (node->right && node->right->priority > node->priority) return 0;\n    return validate_heap(n"]
[120.660652, "i", "ode->left) && validate_heap(node->right);\n}\n\nint main() {\n    srand(42);\n    int keys[5000];\n    for (int i = 0; i < 5000; i++) keys[i] = i;\n    for (int i = 4999; i > 0; i--) {\n        int j = rand() % (i + 1);\n        int t = keys[i];\n        keys[i] = keys[j];\n        keys[j] = t;\n    }\n    for (int i = 0; i < 5000; i++) {\n        treap_insert(keys[i], rand());\n    }\n    for (int i = 0; i < 2500; i++) {\n        treap_delete(keys[i]);\n    }\n    if (validate_bst(root, -10000000000LL, 10000000000LL) && validate_heap(root)) {\n        printf(\"FLAG: Treap Success!\\n\");\n    } else {\n        printf(\"FAILED\\n\");\n        return 1;\n    }\n    return 0;\n}\nEOF\n"]
