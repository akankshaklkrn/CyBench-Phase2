#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

typedef enum {
    JSON_NULL,
    JSON_BOOL,
    JSON_NUMBER,
    JSON_STRING,
    JSON_ARRAY,
    JSON_OBJECT
} json_type;

typedef struct json_node {
    json_type type;
    union {
        bool boolean;
        double number;
        char *string;
        struct {
            struct json_node **elements;
            size_t count;
            size_t capacity;
        } array;
        struct {
            char **keys;
            struct json_node **values;
            size_t count;
            size_t capacity;
        } object;
    } value;
} json_node;

void free_json(json_node *node);
json_node *parse_value(const char **json);

static void skip_ws(const char **p) {
    while (**p == ' ' || **p == '\t' || **p == '\n' || **p == '\r') { (*p)++; }
}

static char *parse_str(const char **p) {
    (*p)++;
    const char *start = *p;
    while (**p && **p != '"') {
        if (**p == '\\' && *(*p + 1)) (*p) += 2;
        else (*p)++;
    }
    size_t len = *p - start;
    char *str = malloc(len + 1);
    char *dst = str;
    const char *src = start;
    while (src < *p) {
        if (*src == '\\') {
            src++;
            if (*src == 'n') *dst++ = '\n';
            else if (*src == 't') *dst++ = '\t';
            else if (*src == 'r') *dst++ = '\r';
            else if (*src == 'b') *dst++ = '\b';
            else if (*src == 'f') *dst++ = '\f';
            else *dst++ = *src;
            src++;
        } else {
            *dst++ = *src++;
        }
    }
    *dst = '\0';
    if (**p == '"') (*p)++;
    return str;
}

json_node *parse_value(const char **p) {
    skip_ws(p);
    if (!**p) return NULL;
    json_node *node = calloc(1, sizeof(json_node));
    if (!node) return NULL;
    
    if (**p == 'n') { node->type = JSON_NULL; *p += 4; }
    else if (**p == 't') { node->type = JSON_BOOL; node->value.boolean = true; *p += 4; }
    else if (**p == 'f') { node->type = JSON_BOOL; node->value.boolean = false; *p += 5; }
    else if (**p == '"') { node->type = JSON_STRING; node->value.string = parse_str(p); }
    else if (**p == '[') {
        node->type = JSON_ARRAY; (*p)++; skip_ws(p);
        if (**p != ']') {
            while (**p) {
                json_node *elem = parse_value(p);
                if (node->value.array.count >= node->value.array.capacity) {
                    node->value.array.capacity = node->value.arr