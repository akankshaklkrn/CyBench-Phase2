def polymul_ntt(a, b):
    c = [0]*256
    for i in range(64):
        z = zetas[64 + i]
        a0, a1 = a[4*i], a[4*i+1]
        b0, b1 = b[4*i], b[4*i+1]
        c[4*i]   = (a0*b0 + a1*b1*z) % q
        c[4*i+1] = (a0*b1 + a1*b0) % q
        z = (-z) % q
        a0, a1 = a[4*i+2], a[4*i+3]
        b0, b1 = b[4*i+2], b[4*i+3]
        c[4*i+2] = (a0*b0 + a1*b1*z) % q
        c[4*i+3] = (a0*b1 + a1*b0) % q
    return c
def real_polymul(a, b):
    c = [0]*256
    for i in range(256):
        for j in range(256):
            if i+j < 256:
                c[i+j] = (c[i+j] + a[i]*b[j]) % q
            else:
                c[(i+j)%256] = (c[(i+j)%256] - a[i]*b[j]) % q
    return c
a = [i for i in range(256)]
b = [(3*i+7)%q for i in range(256)]
na = ntt(a)
nb = ntt(b)
nc = polymul_ntt(na, nb)
rc = inv_ntt(nc)
ec = real_polymul(a, b)
print("Match:", rc == ec)
