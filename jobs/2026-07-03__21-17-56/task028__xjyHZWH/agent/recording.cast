[781.97507, "o", ">         c[4*i] = (a0*b0 + a1*b1*z) % Q;\r\n"]
[781.975144, "o", "\u001b[?2004l\r"]
[781.975185, "o", "\u001b[?2004h> "]
[781.975239, "o", "        c[4*i+1] = (a0*b1 + a1*b0) % Q;\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.97531, "o", "        z = (Q - z) % Q;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.975346, "o", "        a0 = a[4*i+2]; a1 = a[4*i+3];\r\n\u001b[?2004l\r\u001b[?2004h"]
[781.97545, "o", ">         b0 = b[4*i+2]; b1 = b[4*i+3];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.975623, "o", "        c[4*i+2] = (a0*b0 + a1*b1*z) % Q;\r\n\u001b[?2004l\r\u001b[?2004h>         c[4*i+3] = (a0*b1 + a1*b0) % Q;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[781.975698, "o", "> "]
[781.975773, "o", "    for(int i=0; i<256; i++) { if (c[i] < 0) c[i] += Q; }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.97586, "o", "void poly_add(int16_t *c, const int16_t *a, const int16_t *b) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.975935, "o", "    for (int i = 0; i < 256; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.976012, "o", "        c[i] = (a[i] + b[i]) % Q;\r\n\u001b[?2004l\r\u001b[?2004h>         if (c[i] < 0) c[i] += Q;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[781.976038, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.976211, "o", "void poly_sub(int16_t *c, const int16_t *a, const int16_t *b) {\r\n\u001b[?2004l\r\u001b[?2004h>     for (int i = 0; i < 256; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.976277, "o", "        c[i] = (a[i] - b[i]) % Q;\r\n\u001b[?2004l\r\u001b[?2004h>         if (c[i] < 0) c[i] += Q;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.976353, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[781.976479, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> void sample_cbd(int16_t *poly, const uint8_t *seed) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.976597, "o", "    // Simple PRNG from seed for dummy purposes\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.976678, "o", "    uint32_t state = seed[0] | (seed[1]<<8) | (seed[2]<<16) | (seed[3]<<24);\r\n\u001b[?2004l\r\u001b[?2004h>     if (state == 0) state = 123456789;\r\n\u001b[?2004l\r\u001b[?2004h"]
[781.976753, "o", ">     for(int i=0; i<256; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.976879, "o", "        int a1 = (state >> 0) & 1;\r\n\u001b[?2004l\r\u001b[?2004h>         int a2 = (state >> 1) & 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.976967, "o", "        int b1 = (state >> 2) & 1;\r\n\u001b[?2004l\r\u001b[?2004h>         int b2 = (state >> 3) & 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.977059, "o", "        int e = (a1 + a2) - (b1 + b2);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.97708, "o", "        poly[i] = (e + Q) % Q;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.977134, "o", "        state ^= state << 13;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.97719, "o", "        state ^= state >> 17;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.977311, "o", "        state ^= state << 5;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.977458, "o", "void ring_lwe_encrypt(int16_t *c1, int16_t *c2, const int16_t *pub_key_pk, const int16_t *pub_key_a, const uint8_t *msg) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.977525, "o", "    int16_t r[256], e1[256], e2[256];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.977605, "o", "    uint8_t s_r[32], s_e1[32], s_e2[32];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.977724, "o", "    for(int i=0; i<32; i++) s_r[i] = rand() & 0xff;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.97774, "o", "    for(int i=0; i<32; i++) s_e1[i] = rand() & 0xff;\r\n\u001b[?2004l\r\u001b[?2004h"]
[781.977787, "o", "> "]
[781.977879, "o", "    for(int i=0; i<32; i++) s_e2[i] = rand() & 0xff;\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.977933, "o", "    sample_cbd(r, s_r);\r\n\u001b[?2004l\r\u001b[?2004h>     sample_cbd(e1, s_e1);\r\n"]
[781.977953, "o", "\u001b[?2004l\r\u001b[?2004h"]
[781.978076, "o", ">     sample_cbd(e2, s_e2);\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[781.978138, "o", "\u001b[?2004h>     ntt(r);\r\n\u001b[?2004l\r\u001b[?2004h"]
[781.97824, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h>     int16_t Ar[256];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.97839, "o", "    poly_basemul(Ar, pub_key_a, r);\r\n\u001b[?2004l\r\u001b[?2004h>     inv_ntt(Ar);\r\n\u001b[?2004l\r\u001b[?2004h>     poly_add(c1, Ar, e1);\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[781.978431, "o", "> "]
[781.978569, "o", "    int16_t pkr[256];\r\n\u001b[?2004l\r\u001b[?2004h>     poly_basemul(pkr, pub_key_pk, r);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.978586, "o", "    inv_ntt(pkr);\r\n\u001b[?2004l\r"]
[781.978657, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     int16_t m_poly[256];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.978722, "o", "    for(int i=0; i<32; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.978817, "o", "        for(int j=0; j<8; j++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.978947, "o", "            m_poly[8*i+j] = ((msg[i] >> j) & 1) ? 1665 : 0;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.979044, "o", "    poly_add(c2, pkr, e2);\r\n\u001b[?2004l\r\u001b[?2004h>     poly_add(c2, c2, m_poly);\r\n\u001b[?2004l\r"]
[781.979067, "o", "\u001b[?2004h> "]
[781.979076, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[781.979098, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.979263, "o", "void ring_lwe_decrypt(uint8_t *msg, const int16_t *c1, const int16_t *c2, const int16_t *secret_key) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.979318, "o", "    int16_t c1_ntt[256];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.97935, "o", "    memcpy(c1_ntt, c1, 256 * sizeof(int16_t));\r\n\u001b[?2004l\r"]
[781.979431, "o", "\u001b[?2004h>     ntt(c1_ntt);\r\n\u001b[?2004l\r\u001b[?2004h>     "]
[781.979466, "o", "\r\n\u001b[?2004l\r"]
[781.979538, "o", "\u001b[?2004h>     int16_t sc1[256];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.979633, "o", "    poly_basemul(sc1, secret_key, c1_ntt);\r\n\u001b[?2004l\r\u001b[?2004h>     inv_ntt(sc1);\r\n\u001b[?2004l\r"]
[781.979726, "o", "\u001b[?2004h> "]
[781.979743, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[781.979848, "o", ">     int16_t v[256];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.979873, "o", "    poly_sub(v, c2, sc1);\r\n\u001b[?2004l\r"]
[781.979928, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.979966, "o", "    for(int i=0; i<32; i++) {\r\n\u001b[?2004l\r"]
[781.980021, "o", "\u001b[?2004h> "]
[781.980229, "o", "        msg[i] = 0;\r\n\u001b[?2004l\r\u001b[?2004h>         for(int j=0; j<8; j++) {\r\n\u001b[?2004l\r"]
[781.980259, "o", "\u001b[?2004h> "]
[781.980399, "o", "            int16_t val = v[8*i+j];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.980487, "o", "            if (val > Q/2) val = Q - val;\r\n\u001b[?2004l\r\u001b[?2004h>             if (val > Q/4) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[781.980516, "o", "> "]
[781.980623, "o", "                msg[i] |= (1 << j);\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n"]
[781.980747, "o", "\u001b[?2004l\r"]
[781.980843, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.980861, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[781.98091, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.980936, "o", "int main() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[781.981084, "o", ">     srand(42);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.981187, "o", "    int16_t sk[256];\r\n\u001b[?2004l\r\u001b[?2004h>     uint8_t sk_seed[32] = {1};\r\n\u001b[?2004l\r\u001b[?2004h>     sample_cbd(sk, sk_seed);\r\n\u001b[?2004l\r"]
[781.981271, "o", "\u001b[?2004h> "]
[781.981287, "o", "    ntt(sk);\r\n\u001b[?2004l\r\u001b[?2004h"]
[781.98133, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.981408, "o", "    int16_t A[256];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.981546, "o", "    for(int i=0; i<256; i++) A[i] = rand() % Q;\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     int16_t e[256];\r\n\u001b[?2004l\r\u001b[?2004h>     uint8_t e_seed[32] = {2};\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.981653, "o", "    sample_cbd(e, e_seed);\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     int16_t Ask[256];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.981729, "o", "    poly_basemul(Ask, A, sk);\r\n\u001b[?2004l\r\u001b[?2004h>     inv_ntt(Ask);\r\n\u001b[?2004l\r\u001b[?2004h"]
[781.981784, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.981915, "o", "    int16_t pk[256]; // actually pk should be in NTT domain, wait, Kyber encrypts by multiplying pk in NTT.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.982043, "o", "    // Since A is already in NTT domain implicitly (we just generated it), let's ensure t is in NTT domain.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.982111, "o", "    // t = A*s + e. Since we want t in NTT domain...\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.982235, "o", "    poly_add(pk, Ask, e);\r\n\u001b[?2004l\r\u001b[?2004h>     ntt(pk); // pk is now in NTT domain\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[781.982253, "o", "\u001b[?2004h"]
[781.982361, "o", ">     for(int test=0; test<10000; test++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[781.982376, "o", "> "]
[781.982425, "o", "        uint8_t msg[32];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.982517, "o", "        for(int i=0; i<32; i++) msg[i] = rand() & 0xff;\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[781.982542, "o", "> "]
[781.982599, "o", "        int16_t c1[256];\r\n\u001b[?2004l\r\u001b[?2004h>         int16_t c2[256];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.982682, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.982784, "o", "        ring_lwe_encrypt(c1, c2, pk, A, msg);\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         uint8_t msg_dec[32];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.982865, "o", "        ring_lwe_decrypt(msg_dec, c1, c2, sk);\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[781.982889, "o", "\u001b[?2004h> "]
[781.982979, "o", "        if (memcmp(msg, msg_dec, 32) != 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.983059, "o", "            printf(\"Failed at test %d\\n\", test);\r\n\u001b[?2004l\r\u001b[?2004h>             return 1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[781.983073, "o", "> "]
[781.983126, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[781.983147, "o", "\u001b[?2004h> "]
[781.983247, "o", "    printf(\"FLAG: Post-Quantum Ring-LWE NTT Cryptography Success!\\n\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.983262, "o", "    return 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.983271, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[781.983366, "o", "> ''')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[781.983389, "o", "EOF\r\n\u001b[?2004l\r"]
