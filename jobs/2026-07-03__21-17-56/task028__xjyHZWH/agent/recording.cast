[538.038928, "i", "i] = (p[i] * inv128) % q\n    return p\ndef polymul_ntt(a, b):\n    c = [0]*256\n    for i in range(64):\n        z = zetas[64 + i]\n        a0, a1 = a[4*i], a[4*i+1]\n        b0, b1 = b[4*i], b[4*i+1]\n        c[4*i]   = (a0*b0 + a1*b1*z) % q\n        c[4*i+1] = (a0*b1 + a1*b0) % q\n        z = (-z) % q\n        a0, a1 = a[4*i+2], a[4*i+3]\n        b0, b1 = b[4*i+2], b[4*i+3]\n        c[4*i+2] = (a0*b0 + a1*b1*z) % q\n        c[4*i+3] = (a0*b1 + a1*b0) % q\n    return c\ndef real_polymul(a, b):\n    c = [0]*256\n    for i in range(256):\n        for j in range(256):\n            if i+j < 256:\n                c[i+j] = (c[i+j] + a[i]*b[j]) % q\n            else:\n                c[(i+j)%256] = (c[(i+j)%256] - a[i]*b[j]) % q\n    return c\na = [i for i in range(256)]\nb = [(3*i+7)%q for i in range(256)]\nna = ntt(a)\nnb = ntt(b)\nnc = polymul_ntt(na, nb)\nrc = inv_ntt(nc)\nec = real_polymul(a, b)\nprint(\"Match:\", rc == ec)\nEOF\npython3 test4.py\n"]
