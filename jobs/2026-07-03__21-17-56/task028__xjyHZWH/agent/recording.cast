[694.492444, "i", "i] = (p[i] * inv128) % q\n    return p\ndef basemul_ntt(a, b, c_array):\n    c = [0]*256\n    for i in range(128):\n        z = c_array[i]\n        a0, a1 = a[2*i], a[2*i+1]\n        b0, b1 = b[2*i], b[2*i+1]\n        c[2*i]   = (a0*b0 + a1*b1*z) % q\n        c[2*i+1] = (a0*b1 + a1*b0) % q\n    return c\ndef real_polymul(a, b):\n    c = [0]*256\n    for i in range(256):\n        for j in range(256):\n            if i+j < 256:\n                c[i+j] = (c[i+j] + a[i]*b[j]) % q\n            else:\n                c[(i+j)%256] = (c[(i+j)%256] - a[i]*b[j]) % q\n    return c\nx2 = [0]*256\nx2[2] = 1\nntt_x2 = ntt(x2)\nc_array = [ntt_x2[2*i] for i in range(128)]\n\na = [(i*13)%q for i in range(256)]\nb = [(3*i+7)%q for i in range(256)]\nna = ntt(a)\nnb = ntt(b)\nnc = basemul_ntt(na, nb, c_array)\nrc = inv_ntt(nc)\nec = real_polymul(a, b)\nprint(\"Match:\", rc == ec)\nEOF\npython3 test7.py\n"]
