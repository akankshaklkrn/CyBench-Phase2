[1180.164329, "o", "                poly[j] = t;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.164422, "o", "                poly[j + len] = pmod((int64_t)diff * z);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.164443, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.164504, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1180.164629, "o", ">         len *= 2;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     int32_t inv128 = 3303; \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.164763, "o", "    for (int i = 0; i < 256; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.164781, "o", "        poly[i] = pmod((int64_t)poly[i] * inv128);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.164895, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.165, "o", "void poly_basemul(int16_t *c, const int16_t *a, const int16_t *b) {\r\n\u001b[?2004l\r\u001b[?2004h>     for (int i = 0; i < 64; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.165123, "o", "        int64_t z = zetas[64 + i];\r\n\u001b[?2004l\r\u001b[?2004h>         int64_t a0 = a[4*i], a1 = a[4*i+1];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.165236, "o", "        int64_t b0 = b[4*i], b1 = b[4*i+1];\r\n\u001b[?2004l\r\u001b[?2004h>         c[4*i] = pmod(a0*b0 + a1*b1*z);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.165371, "o", "        c[4*i+1] = pmod(a0*b1 + a1*b0);\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.165553, "o", "        z = Q - z;\r\n\u001b[?2004l\r\u001b[?2004h>         a0 = a[4*i+2]; a1 = a[4*i+3];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.165692, "o", "        b0 = b[4*i+2]; b1 = b[4*i+3];\r\n\u001b[?2004l\r\u001b[?2004h>         c[4*i+2] = pmod(a0*b0 + a1*b1*z);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.166015, "o", "        c[4*i+3] = pmod(a0*b1 + a1*b0);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1180.166044, "o", "\u001b[?2004h> "]
[1180.166136, "o", "void poly_add(int16_t *c, const int16_t *a, const int16_t *b) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.166235, "o", "    for (int i = 0; i < 256; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>         c[i] = pmod(a[i] + b[i]);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1180.166263, "o", "> }\r\n\u001b[?2004l\r"]
[1180.166356, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.16647, "o", "void poly_sub(int16_t *c, const int16_t *a, const int16_t *b) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.166586, "o", "    for (int i = 0; i < 256; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>         c[i] = pmod(a[i] - b[i]);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1180.166702, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> void sample_cbd(int16_t *poly, const uint8_t *seed) {\r\n\u001b[?2004l\r"]
[1180.166786, "o", "\u001b[?2004h> "]
[1180.166946, "o", "    uint32_t state = seed[0] | ((uint32_t)seed[1]<<8) | ((uint32_t)seed[2]<<16) | ((uint32_t)seed[3]<<24);\r\n\u001b[?2004l\r\u001b[?2004h>     if (state == 0) state = 123456789;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1180.167053, "o", ">     for(int i=0; i<256; i++) {\r\n\u001b[?2004l\r"]
[1180.167168, "o", "\u001b[?2004h> "]
[1180.167269, "o", "        int a1 = (state >> 0) & 1;\r\n\u001b[?2004l\r\u001b[?2004h>         int a2 = (state >> 1) & 1;\r\n"]
[1180.167286, "o", "\u001b[?2004l\r"]
[1180.167407, "o", "\u001b[?2004h>         int b1 = (state >> 2) & 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.167443, "o", "        int b2 = (state >> 3) & 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.167551, "o", "        int e = (a1 + a2) - (b1 + b2);\r\n\u001b[?2004l\r\u001b[?2004h>         poly[i] = pmod(e);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.167606, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h>         state ^= state << 13;\r\n"]
[1180.167715, "o", "\u001b[?2004l\r\u001b[?2004h>         state ^= state >> 17;\r\n\u001b[?2004l\r"]
[1180.167851, "o", "\u001b[?2004h> "]
[1180.167883, "o", "        state ^= state << 5;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.16809, "o", "void ring_lwe_encrypt(int16_t *c1, int16_t *c2, const int16_t *pub_key_pk, const int16_t *pub_key_a, const uint8_t *msg) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.168113, "o", "    int16_t r[256], e1[256], e2[256];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.168218, "o", "    uint8_t s_r[32], s_e1[32], s_e2[32];\r\n\u001b[?2004l\r\u001b[?2004h>     for(int i=0; i<32; i++) {\r\n\u001b[?2004l\r"]
[1180.168313, "o", "\u001b[?2004h> "]
[1180.168335, "o", "        s_r[i] = rand() & 0xff;\r\n\u001b[?2004l\r\u001b[?2004h>         s_e1[i] = rand() & 0xff;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.168403, "o", "        s_e2[i] = rand() & 0xff;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.168503, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.168588, "o", "    sample_cbd(r, s_r);\r\n\u001b[?2004l\r\u001b[?2004h>     sample_cbd(e1, s_e1);\r\n\u001b[?2004l\r\u001b[?2004h>     sample_cbd(e2, s_e2);\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.168651, "o", "    ntt(r);\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.168754, "o", "    int16_t Ar[256];\r\n\u001b[?2004l\r\u001b[?2004h>     poly_basemul(Ar, pub_key_a, r);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.168873, "o", "    inv_ntt(Ar);\r\n\u001b[?2004l\r\u001b[?2004h>     poly_add(c1, Ar, e1);\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[1180.168954, "o", "\u001b[?2004h"]
[1180.169046, "o", ">     int16_t pkr[256];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.169108, "o", "    poly_basemul(pkr, pub_key_pk, r);\r\n\u001b[?2004l\r\u001b[?2004h>     inv_ntt(pkr);\r\n\u001b[?2004l\r"]
[1180.169173, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     int16_t m_poly[256];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.169275, "o", "    for(int i=0; i<32; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>         for(int j=0; j<8; j++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.169379, "o", "            m_poly[8*i+j] = ((msg[i] >> j) & 1) ? ((Q+1)/2) : 0;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.169397, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1180.169446, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.169506, "o", "    poly_add(c2, pkr, e2);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.169542, "o", "    poly_add(c2, c2, m_poly);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1180.169622, "o", "\u001b[?2004h> "]
[1180.169751, "o", "void ring_lwe_decrypt(uint8_t *msg, const int16_t *c1, const int16_t *c2, const int16_t *secret_key) {\r\n\u001b[?2004l\r\u001b[?2004h>     int16_t c1_ntt[256];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.16988, "o", "    memcpy(c1_ntt, c1, 256 * sizeof(int16_t));\r\n\u001b[?2004l\r\u001b[?2004h>     ntt(c1_ntt);\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     int16_t sc1[256];\r\n\u001b[?2004l\r\u001b[?2004h"]
[1180.169904, "o", "> "]
[1180.169981, "o", "    poly_basemul(sc1, secret_key, c1_ntt);\r\n\u001b[?2004l\r\u001b[?2004h>     inv_ntt(sc1);\r\n\u001b[?2004l\r\u001b[?2004h"]
[1180.169999, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[1180.170052, "o", ">     int16_t v[256];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.170108, "o", "    poly_sub(v, c2, sc1);\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[1180.170192, "o", "\u001b[?2004h>     for(int i=0; i<32; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>         msg[i] = 0;\r\n\u001b[?2004l\r\u001b[?2004h"]
[1180.170264, "o", ">         for(int j=0; j<8; j++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.170351, "o", "            int16_t val = v[8*i+j];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.170369, "o", "            if (val > Q/2) val = Q - val;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.170432, "o", "            if (val > Q/4) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.170524, "o", "                msg[i] |= (1 << j);\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[1180.170539, "o", ">     }\r\n\u001b[?2004l\r"]
[1180.170578, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.170697, "o", "int main() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[1180.170709, "o", "> "]
[1180.170723, "o", "    srand(42);\r\n\u001b[?2004l\r"]
[1180.170763, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[1180.170794, "o", "\u001b[?2004h>     int16_t sk[256];\r\n\u001b[?2004l\r"]
[1180.170805, "o", "\u001b[?2004h> "]
[1180.170892, "o", "    uint8_t sk_seed[32] = {1, 2, 3, 4};\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.170907, "o", "    sample_cbd(sk, sk_seed);\r\n\u001b[?2004l\r\u001b[?2004h"]
[1180.171072, "o", ">     ntt(sk);\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     int16_t A[256];\r\n\u001b[?2004l\r"]
[1180.171093, "o", "\u001b[?2004h"]
[1180.171176, "o", "> "]
[1180.171372, "o", "    for(int i=0; i<256; i++) A[i] = rand() % Q;\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     int16_t e[256];\r\n\u001b[?2004l\r\u001b[?2004h>     uint8_t e_seed[32] = {5, 6, 7, 8};\r\n\u001b[?2004l\r\u001b[?2004h>     sample_cbd(e, e_seed);\r\n\u001b[?2004l\r"]
[1180.171406, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.171487, "o", "    int16_t Ask[256];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.171513, "o", "    poly_basemul(Ask, A, sk);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.171583, "o", "    inv_ntt(Ask);\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     int16_t pk[256];\r\n\u001b[?2004l\r"]
[1180.171602, "o", "\u001b[?2004h> "]
[1180.171704, "o", "    poly_add(pk, Ask, e);\r\n\u001b[?2004l\r\u001b[?2004h>     ntt(pk);\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[1180.171737, "o", "> "]
[1180.171842, "o", "    for(int test=0; test<10000; test++) {\r\n\u001b[?2004l\r\u001b[?2004h>         uint8_t msg[32];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.17196, "o", "        for(int i=0; i<32; i++) msg[i] = rand() & 0xff;\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.171979, "o", "        int16_t c1[256];\r\n\u001b[?2004l\r\u001b[?2004h"]
[1180.172083, "o", ">         int16_t c2[256];\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.172151, "o", "        ring_lwe_encrypt(c1, c2, pk, A, msg);\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.172279, "o", "        uint8_t msg_dec[32];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.172297, "o", "        ring_lwe_decrypt(msg_dec, c1, c2, sk);"]
[1180.172355, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[1180.172393, "o", "\u001b[?2004h> "]
[1180.172465, "o", "        if (memcmp(msg, msg_dec, 32) != 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.172552, "o", "            printf(\"Failed at test %d\\n\", test);\r\n\u001b[?2004l\r\u001b[?2004h>             return 1;\r\n\u001b[?2004l\r"]
[1180.172621, "o", "\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[1180.172717, "o", "\u001b[?2004h> "]
[1180.172742, "o", "    printf(\"FLAG: Post-Quantum Ring-LWE NTT Cryptography Success!\\n\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1180.172794, "o", "    return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[1180.172888, "o", "\u001b[?2004h> ''')\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
