[895.824481, "o", "        b0 = b[4*i+2]; b1 = b[4*i+3];\r\n\u001b[?2004l\r\u001b[?2004h"]
[895.824554, "o", ">         c[4*i+2] = (a0*b0 + a1*b1*z) % Q;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.824637, "o", "        c[4*i+3] = (a0*b1 + a1*b0) % Q;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.824716, "o", "    for(int i=0; i<256; i++) { if (c[i] < 0) c[i] += Q; }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[895.824817, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.824922, "o", "void poly_add(int16_t *c, const int16_t *a, const int16_t *b) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.824948, "o", "    for (int i = 0; i < 256; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.825005, "o", "        c[i] = (a[i] + b[i]) % Q;\r\n\u001b[?2004l\r\u001b[?2004h>         if (c[i] < 0) c[i] += Q;\r\n\u001b[?2004l\r"]
[895.825036, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[895.82522, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[895.825238, "o", "\u001b[?2004h> "]
[895.825346, "o", "void poly_sub(int16_t *c, const int16_t *a, const int16_t *b) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.825464, "o", "    for (int i = 0; i < 256; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.82553, "o", "        c[i] = (a[i] - b[i]) % Q;\r\n\u001b[?2004l\r\u001b[?2004h>         if (c[i] < 0) c[i] += Q;\r\n\u001b[?2004l\r"]
[895.825566, "o", "\u001b[?2004h>     }\r\n"]
[895.825578, "o", "\u001b[?2004l\r"]
[895.825693, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.825783, "o", "void sample_cbd(int16_t *poly, const uint8_t *seed) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.825911, "o", "    uint32_t state = seed[0] | (seed[1]<<8) | (seed[2]<<16) | (seed[3]<<24);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.825985, "o", "    if (state == 0) state = 123456789;\r\n\u001b[?2004l\r\u001b[?2004h>     for(int i=0; i<256; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.826073, "o", "        int a1 = (state >> 0) & 1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[895.826154, "o", ">         int a2 = (state >> 1) & 1;\r\n\u001b[?2004l\r\u001b[?2004h>         int b1 = (state >> 2) & 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.826295, "o", "        int b2 = (state >> 3) & 1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.826392, "o", "        int e = (a1 + a2) - (b1 + b2);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.826411, "o", "        poly[i] = (e + Q) % Q;\r\n\u001b[?2004l\r"]
[895.826484, "o", "\u001b[?2004h>         state ^= state << 13;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.826546, "o", "        state ^= state >> 17;\r\n\u001b[?2004l\r"]
[895.826565, "o", "\u001b[?2004h> "]
[895.826584, "o", "        state ^= state << 5;\r\n\u001b[?2004l\r"]
[895.82659, "o", "\u001b[?2004h> "]
[895.826666, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[895.826765, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.826881, "o", "void ring_lwe_encrypt(int16_t *c1, int16_t *c2, const int16_t *pub_key_pk, const int16_t *pub_key_a, const uint8_t *msg) {\r\n\u001b[?2004l\r"]
[895.826939, "o", "\u001b[?2004h> "]
[895.827006, "o", "    int16_t r[256], e1[256], e2[256];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.827129, "o", "    uint8_t s_r[32], s_e1[32], s_e2[32];\r\n\u001b[?2004l\r\u001b[?2004h>     for(int i=0; i<32; i++) {\r\n\u001b[?2004l\r"]
[895.827189, "o", "\u001b[?2004h>         s_r[i] = rand() & 0xff;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.82725, "o", "        s_e1[i] = rand() & 0xff;\r\n\u001b[?2004l\r\u001b[?2004h"]
[895.827266, "o", "> "]
[895.827311, "o", "        s_e2[i] = rand() & 0xff;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.82739, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.827449, "o", "    sample_cbd(r, s_r);\r\n\u001b[?2004l\r\u001b[?2004h>     sample_cbd(e1, s_e1);\r\n\u001b[?2004l\r"]
[895.827467, "o", "\u001b[?2004h> "]
[895.82754, "o", "    sample_cbd(e2, s_e2);\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     ntt(r);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.827623, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     int16_t Ar[256];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.827728, "o", "    poly_basemul(Ar, pub_key_a, r);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.827784, "o", "    inv_ntt(Ar);\r\n\u001b[?2004l\r\u001b[?2004h>     poly_add(c1, Ar, e1);\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
[895.827838, "o", "\u001b[?2004l\r\u001b[?2004h>     int16_t pkr[256];\r\n\u001b[?2004l\r"]
[895.8279, "o", "\u001b[?2004h"]
[895.828004, "o", ">     poly_basemul(pkr, pub_key_pk, r);\r\n\u001b[?2004l\r\u001b[?2004h"]
[895.828031, "o", ">     inv_ntt(pkr);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.828079, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.828187, "o", "    int16_t m_poly[256];\r\n\u001b[?2004l\r\u001b[?2004h>     for(int i=0; i<32; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.82827, "o", "        for(int j=0; j<8; j++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.828347, "o", "            m_poly[8*i+j] = ((msg[i] >> j) & 1) ? 1665 : 0;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.828367, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.828491, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     poly_add(c2, pkr, e2);\r\n\u001b[?2004l\r\u001b[?2004h>     poly_add(c2, c2, m_poly);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[895.828612, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.828688, "o", "void ring_lwe_decrypt(uint8_t *msg, const int16_t *c1, const int16_t *c2, const int16_t *secret_key) {\r\n\u001b[?2004l\r\u001b[?2004h>     int16_t c1_ntt[256];\r\n\u001b[?2004l\r"]
[895.828708, "o", "\u001b[?2004h> "]
[895.82878, "o", "    memcpy(c1_ntt, c1, 256 * sizeof(int16_t));\r\n\u001b[?2004l\r\u001b[?2004h"]
[895.828883, "o", ">     ntt(c1_ntt);\r\n\u001b[?2004l\r"]
[895.829046, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.829121, "o", "    int16_t sc1[256];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.82919, "o", "    poly_basemul(sc1, secret_key, c1_ntt);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.829309, "o", "    inv_ntt(sc1);\r\n\u001b[?2004l\r"]
[895.829328, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[895.829385, "o", "\u001b[?2004h> "]
[895.829545, "o", "    int16_t v[256];\r\n\u001b[?2004l\r\u001b[?2004h>     poly_sub(v, c2, sc1);\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.82957, "o", "    for(int i=0; i<32; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.82964, "o", "        msg[i] = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.829739, "o", "        for(int j=0; j<8; j++) {\r\n\u001b[?2004l\r\u001b[?2004h>             int16_t val = v[8*i+j];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.829825, "o", "            if (val > Q/2) val = Q - val;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.829914, "o", "            if (val > Q/4) {\r\n\u001b[?2004l\r\u001b[?2004h>                 msg[i] |= (1 << j);\r\n\u001b[?2004l\r\u001b[?2004h>             }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.829936, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h"]
[895.83001, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.830065, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.830237, "o", "int main() {\r\n\u001b[?2004l\r\u001b[?2004h>     srand(42);\r\n\u001b[?2004l\r\u001b[?2004h>     int16_t sk[256];\r\n\u001b[?2004l\r\u001b[?2004h>     uint8_t sk_seed[32] = {1, 2, 3, 4};\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.830352, "o", "    sample_cbd(sk, sk_seed);\r\n\u001b[?2004l\r\u001b[?2004h>     ntt(sk);\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.830471, "o", "    int16_t A[256];\r\n\u001b[?2004l\r\u001b[?2004h>     for(int i=0; i<256; i++) A[i] = rand() % Q;\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.830549, "o", "    int16_t e[256];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.83061, "o", "    uint8_t e_seed[32] = {5, 6, 7, 8};\r\n\u001b[?2004l\r\u001b[?2004h>     sample_cbd(e, e_seed);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.830665, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[895.830757, "o", "> "]
[895.830849, "o", "    int16_t Ask[256];\r\n\u001b[?2004l\r\u001b[?2004h>     poly_basemul(Ask, A, sk);\r\n\u001b[?2004l\r\u001b[?2004h"]
[895.830898, "o", ">     inv_ntt(Ask);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.831001, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     int16_t pk[256];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.831164, "o", "    poly_add(pk, Ask, e);\r\n\u001b[?2004l\r\u001b[?2004h>     ntt(pk);\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     for(int test=0; test<10000; test++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[895.831265, "o", ">         uint8_t msg[32];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.831371, "o", "        for(int i=0; i<32; i++) msg[i] = rand() & 0xff;\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h>         int16_t c1[256];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.831469, "o", "        int16_t c2[256];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.83156, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h"]
[895.831633, "o", ">         ring_lwe_encrypt(c1, c2, pk, A, msg);\r\n\u001b[?2004l\r"]
[895.831648, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[895.831703, "o", "\u001b[?2004h> "]
[895.831719, "o", "        uint8_t msg_dec[32];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.831807, "o", "        ring_lwe_decrypt(msg_dec, c1, c2, sk);\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r\u001b[?2004h"]
[895.831827, "o", "> "]
[895.8319, "o", "        if (memcmp(msg, msg_dec, 32) != 0) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.831969, "o", "            printf(\"Failed at test %d\\n\", test);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.832131, "o", "            return 1;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[895.832236, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.832355, "o", "    printf(\"FLAG: Post-Quantum Ring-LWE NTT Cryptography Success!\\n\");"]
[895.832375, "o", "\r\n\u001b[?2004l\r"]
[895.832435, "o", "\u001b[?2004h"]
[895.832493, "o", ">     return 0;\r\n\u001b[?2004l\r"]
[895.832542, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> ''')\r\n\u001b[?2004l\r\u001b[?2004h"]
