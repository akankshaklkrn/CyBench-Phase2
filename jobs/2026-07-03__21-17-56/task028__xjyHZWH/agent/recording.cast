[782.46981, "o", "\u001b[?2004hroot@7290a6fc1a90:/# "]
[895.817992, "i", "cat << 'EOF' > build.py\nimport sys\nq = 3329\nzeta = 17\nzetas = [pow(zeta, int('{:07b}'.format(i)[::-1], 2), q) for i in range(128)]\n\nwith open('target.c', 'w') as f:\n    f.write('#include <stdint.h>\\n#include <stdio.h>\\n#include <stdlib.h>\\n#include <string.h>\\n\\n#define N 256\\n#define Q 3329\\n\\nconst int16_t zetas[128] = {\\n')\n    f.write('    ' + ', '.join(map(str, zetas)) + '\\n')\n    f.write(r'''};\n\nvoid ntt(int16_t *poly) {\n    int len = 128;\n    int k = 1;\n    while (len >= 2) {\n        for (int start = 0; start < 256; start += 2 * len) {\n            int32_t z = zetas[k++];\n            for (int j = start; j < start + len; j++) {\n                int32_t t = (z * poly[j + len]) % Q;\n                int32_t p0 = poly[j];\n                poly[j + len] = (p0 - t) % Q;\n                if (poly[j + len] < 0) poly[j + len] += Q;\n                poly[j] = (p0 + t) % Q;\n            }\n        }\n        len /= 2;\n    }\n}\n\nvoid inv_ntt(int16_t *poly) {\n    int len = 2;\n    int k = 127;\n    while (len <= 128) {\n       "]
[895.8182, "i", " for (int start = 0; start < 256; start += 2 * len) {\n            int32_t z = zetas[k--];\n            for (int j = start; j < start + len; j++) {\n                int32_t p0 = poly[j];\n                int32_t p1 = poly[j + len];\n                poly[j] = (p0 + p1) % Q;\n                poly[j + len] = (p0 - p1) % Q;\n                if(poly[j+len] < 0) poly[j+len] += Q;\n                poly[j + len] = (poly[j + len] * z) % Q;\n            }\n        }\n        len *= 2;\n    }\n    int32_t inv128 = 3303; \n    for (int i = 0; i < 256; i++) {\n        poly[i] = (poly[i] * inv128) % Q;\n    }\n}\n\nvoid poly_basemul(int16_t *c, const int16_t *a, const int16_t *b) {\n    for (int i = 0; i < 64; i++) {\n        int64_t z = zetas[64 + i];\n        int64_t a0 = a[4*i], a1 = a[4*i+1];\n        int64_t b0 = b[4*i], b1 = b[4*i+1];\n        c[4*i] = (a0*b0 + a1*b1*z) % Q;\n        c[4*i+1] = (a0*b1 + a1*b0) % Q;\n        \n        z = (Q - z) % Q;\n        a0 = a[4*i+2]; a1 = a[4*i+3];\n        b0 = b[4*i+2]; b1 = b[4*i+3];\n        c[4*i+2] ="]
[895.818246, "o", "cat << 'EOF' > build.py\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> q = 3329\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.818273, "i", " (a0*b0 + a1*b1*z) % Q;\n        c[4*i+3] = (a0*b1 + a1*b0) % Q;\n    }\n    for(int i=0; i<256; i++) { if (c[i] < 0) c[i] += Q; }\n}\n\nvoid poly_add(int16_t *c, const int16_t *a, const int16_t *b) {\n    for (int i = 0; i < 256; i++) {\n        c[i] = (a[i] + b[i]) % Q;\n        if (c[i] < 0) c[i] += Q;\n    }\n}\n\nvoid poly_sub(int16_t *c, const int16_t *a, const int16_t *b) {\n    for (int i = 0; i < 256; i++) {\n        c[i] = (a[i] - b[i]) % Q;\n        if (c[i] < 0) c[i] += Q;\n    }\n}\n\nvoid sample_cbd(int16_t *poly, const uint8_t *seed) {\n    uint32_t state = seed[0] | (seed[1]<<8) | (seed[2]<<16) | (seed[3]<<24);\n    if (state == 0) state = 123456789;\n    for(int i=0; i<256; i++) {\n        int a1 = (state >> 0) & 1;\n        int a2 = (state >> 1) & 1;\n        int b1 = (state >> 2) & 1;\n        int b2 = (state >> 3) & 1;\n        int e = (a1 + a2) - (b1 + b2);\n        poly[i] = (e + Q) % Q;\n        state ^= state << 13;\n        state ^= state >> 17;\n        state ^= state << 5;\n    }\n}\n\nvoid ring_lwe_encrypt(int16_t *c"]
[895.818279, "o", "zeta = 17\r\n\u001b[?2004l\r\u001b[?2004h> "]
[895.818293, "i", "1, int16_t *c2, const int16_t *pub_key_pk, const int16_t *pub_key_a, const uint8_t *msg) {\n    int16_t r[256], e1[256], e2[256];\n    uint8_t s_r[32], s_e1[32], s_e2[32];\n    for(int i=0; i<32; i++) {\n        s_r[i] = rand() & 0xff;\n        s_e1[i] = rand() & 0xff;\n        s_e2[i] = rand() & 0xff;\n    }\n    \n    sample_cbd(r, s_r);\n    sample_cbd(e1, s_e1);\n    sample_cbd(e2, s_e2);\n    \n    ntt(r);\n    \n    int16_t Ar[256];\n    poly_basemul(Ar, pub_key_a, r);\n    inv_ntt(Ar);\n    poly_add(c1, Ar, e1);\n    \n    int16_t pkr[256];\n    poly_basemul(pkr, pub_key_pk, r);\n    inv_ntt(pkr);\n    \n    int16_t m_poly[256];\n    for(int i=0; i<32; i++) {\n        for(int j=0; j<8; j++) {\n            m_poly[8*i+j] = ((msg[i] >> j) & 1) ? 1665 : 0;\n        }\n    }\n    \n    poly_add(c2, pkr, e2);\n    poly_add(c2, c2, m_poly);\n}\n\nvoid ring_lwe_decrypt(uint8_t *msg, const int16_t *c1, const int16_t *c2, const int16_t *secret_key) {\n    int16_t c1_ntt[256];\n    memcpy(c1_ntt, c1, 256 * sizeof(int16_t));\n    ntt(c1_ntt);\n    \n   "]
[895.818417, "i", " int16_t sc1[256];\n    poly_basemul(sc1, secret_key, c1_ntt);\n    inv_ntt(sc1);\n    \n    int16_t v[256];\n    poly_sub(v, c2, sc1);\n    \n    for(int i=0; i<32; i++) {\n        msg[i] = 0;\n        for(int j=0; j<8; j++) {\n            int16_t val = v[8*i+j];\n            if (val > Q/2) val = Q - val;\n            if (val > Q/4) {\n                msg[i] |= (1 << j);\n            }\n        }\n    }\n}\n\nint main() {\n    srand(42);\n    int16_t sk[256];\n    uint8_t sk_seed[32] = {1, 2, 3, 4};\n    sample_cbd(sk, sk_seed);\n    ntt(sk);\n    \n    int16_t A[256];\n    for(int i=0; i<256; i++) A[i] = rand() % Q;\n    \n    int16_t e[256];\n    uint8_t e_seed[32] = {5, 6, 7, 8};\n    sample_cbd(e, e_seed);\n    \n    int16_t Ask[256];\n    poly_basemul(Ask, A, sk);\n    inv_ntt(Ask);\n    \n    int16_t pk[256];\n    poly_add(pk, Ask, e);\n    ntt(pk);\n    \n    for(int test=0; test<10000; test++) {\n        uint8_t msg[32];\n        for(int i=0; i<32; i++) msg[i] = rand() & 0xff;\n        \n        int16_t c1[256];\n        int16_t c2[256];\n       "]
[895.818447, "o", "zetas = [pow(zeta, int('{:07b}'.format(i)[::-1], 2), q) for i in range(128)]\r\n\u001b[?2004l\r"]
[895.818573, "i", " \n        ring_lwe_encrypt(c1, c2, pk, A, msg);\n        \n        uint8_t msg_dec[32];\n        ring_lwe_decrypt(msg_dec, c1, c2, sk);\n        \n        if (memcmp(msg, msg_dec, 32) != 0) {\n            printf(\"Failed at test %d\\n\", test);\n            return 1;\n        }\n    }\n    \n    printf(\"FLAG: Post-Quantum Ring-LWE NTT Cryptography Success!\\n\");\n    return 0;\n}\n''')\nEOF\npython3 build.py\n"]
