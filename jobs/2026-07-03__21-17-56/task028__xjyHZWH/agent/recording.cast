[208.403554, "i", "cat << 'EOF' > test.py\nimport sys\nq = 3329\nzeta = 17\nzetas = [pow(zeta, int('{:07b}'.format(i)[::-1], 2), q) for i in range(128)]\ndef ntt(poly):\n    p = poly.copy()\n    k = 1\n    length = 128\n    while length >= 2:\n        for start in range(0, 256, 2 * length):\n            z = zetas[k]\n            k += 1\n            for j in range(start, start + length):\n                t = (z * p[j + length]) % q\n                p[j + length] = (p[j] - t) % q\n                p[j] = (p[j] + t) % q\n        length //= 2\n    return p\ndef inv_ntt(poly):\n    p = poly.copy()\n    k = 127\n    length = 2\n    while length <= 128:\n        for start in range(0, 256, 2 * length):\n            z = zetas[k]\n            k -= 1\n            for j in range(start, start + length):\n                t = p[j]\n                u = p[j + length]\n                p[j] = (t + u) % q\n                p[j + length] = ((t - u) * z) % q\n        length *= 2\n    for i in range(256):\n        p[i] = (p[i] * pow(128, q-2, q)) % q\n    return p\ndef basemul(a, b):\n   "]
[208.403748, "i", " c = [0]*256\n    for i in range(128):\n        z = zetas[64 + i]\n        a0, a1 = a[2*i], a[2*i+1]\n        b0, b1 = b[2*i], b[2*i+1]\n        c[2*i] = (a0*b0 + a1*b1*z) % q\n        c[2*i+1] = (a0*b1 + a1*b0) % q\n    return c\ndef polymul(a, b):\n    c = [0]*256\n    for i in range(256):\n        for j in range(256):\n            if i+j < 256:\n                c[i+j] = (c[i+j] + a[i]*b[j]) % q\n            else:\n                c[(i+j)%256] = (c[(i+j)%256] - a[i]*b[j]) % q\n    return c\na = [i for i in range(256)]\nb = [(3*i+7)%q for i in range(256)]\nna = ntt(a)\nnb = ntt(b)\nnc = basemul(na, nb)\nrc = inv_ntt(nc)\nec = polymul(a, b)\nprint(\"Match:\", rc == ec)\nEOF\npython3 test.py\n"]
