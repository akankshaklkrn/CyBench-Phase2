[896.555759, "o", "\u001b[1mtarget.c:86:71:\u001b[1m\u001b[31m runtime error: \u001b[1m\u001b[0m\u001b[1mleft shift of 234 by 24 places cannot be represented in type 'int'\u001b[1m\u001b[0m\r\n"]
[896.555811, "o", "Failed at test 0\r\n"]
[897.339702, "o", "\u001b[?2004hroot@7290a6fc1a90:/# "]
[1039.467602, "i", "cat << 'EOF' > check.py\nimport sys\nq = 3329\nzeta = 17\nzetas = [pow(zeta, int('{:07b}'.format(i)[::-1], 2), q) for i in range(128)]\nzetas_inv = [pow(z, q-2, q) for z in zetas]\n\ndef ntt(poly):\n    p = poly.copy()\n    k = 1\n    length = 128\n    while length >= 2:\n        for start in range(0, 256, 2 * length):\n            z = zetas[k]\n            k += 1\n            for j in range(start, start + length):\n                t = (z * p[j + length]) % q\n                p[j + length] = (p[j] - t) % q\n                p[j] = (p[j] + t) % q\n        length //= 2\n    return p\n\ndef inv_ntt(poly):\n    p = poly.copy()\n    k = 127\n    length = 2\n    while length <= 128:\n        for start in range(0, 256, 2 * length):\n            z = zetas_inv[k]\n            k -= 1\n            for j in range(start, start + length):\n                t = p[j]\n                u = p[j + length]\n                p[j] = (t + u) % q\n                p[j + length] = ((t - u) * z) % q\n        length *= 2\n    inv128 = 3303\n    for i in range(256):\n        p[i"]
[1039.467808, "i", "] = (p[i] * inv128) % q\n    return p\n\ndef polymul_ntt(a, b):\n    c = [0]*256\n    for i in range(64):\n        z = zetas[64 + i]\n        a0, a1 = a[4*i], a[4*i+1]\n        b0, b1 = b[4*i], b[4*i+1]\n        c[4*i]   = (a0*b0 + a1*b1*z) % q\n        c[4*i+1] = (a0*b1 + a1*b0) % q\n        z = (q - z) % q\n        a0, a1 = a[4*i+2], a[4*i+3]\n        b0, b1 = b[4*i+2], b[4*i+3]\n        c[4*i+2] = (a0*b0 + a1*b1*z) % q\n        c[4*i+3] = (a0*b1 + a1*b0) % q\n    return c\n\ndef real_polymul(a, b):\n    c = [0]*256\n    for i in range(256):\n        for j in range(256):\n            if i+j < 256:\n                c[i+j] = (c[i+j] + a[i]*b[j]) % q\n            else:\n                c[(i+j)%256] = (c[(i+j)%256] - a[i]*b[j]) % q\n    return c\n\na = [(i*13)%q for i in range(256)]\nb = [(3*i+7)%q for i in range(256)]\nna = ntt(a)\nnb = ntt(b)\nnc = polymul_ntt(na, nb)\nrc = inv_ntt(nc)\nec = real_polymul(a, b)\nprint(\"Match:\", rc == ec)\nprint(\"rc[0:5]:\", rc[0:5])\nprint(\"ec[0:5]:\", ec[0:5])\nEOF\npython3 check.py\n"]
[1039.467861, "o", "cat << 'EOF' > check.py\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r"]
[1039.467887, "o", "\u001b[?2004h> q = 3329\r\n\u001b[?2004l\r"]
[1039.46802, "o", "\u001b[?2004h> zeta = 17\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1039.468132, "o", "zetas = [pow(zeta, int('{:07b}'.format(i)[::-1], 2), q) for i in range(128)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[1039.468206, "o", "zetas_inv = [pow(z, q-2, q) for z in zetas]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[1039.468237, "o", "\u001b[?2004h> def ntt(poly):"]
[1039.46825, "o", "\r\n\u001b[?2004l\r"]
[1039.468272, "o", "\u001b[?2004h"]
