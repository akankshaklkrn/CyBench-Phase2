[?2004l[?2004h> bool skiplist_insert(skiplist_t *sl, int key, int top_level) {
[?2004l[?2004h>     skiplist_node *new_node = malloc(sizeof(skiplist_node));
[?2004l[?2004h>     if (!new_node) return false;
[?2004l[?2004h>     new_node->key = key;
[?2004l[?2004h>     new_node->top_level = top_level;
[?2004l[?2004h>     for(int i = 0; i <= top_level; i++) {
[?2004l[?2004h>         atomic_init(&new_node->next[i], NULL);
[?2004l[?2004h>     }
[?2004l[?2004h>     
[?2004l[?2004h>     skiplist_node *preds[MAX_LEVEL];
[?2004l[?2004h>     skiplist_node *succs[MAX_LEVEL];
[?2004l[?2004h> 
[?2004l[?2004h> retry:
[?2004l[?2004h>     ;
[?2004l[?2004h>     skiplist_node *pred = sl->head;
[?2004l[?2004h>     for (int level = MAX_LEVEL - 1; level >= 0; level--) {
[?2004l[?2004h>         skiplist_node *curr = atomic_load(&pred->next[level]);
[?2004l[?2004h>         while (curr != NULL && curr->key < key) {
[?2004l[?2004h>             pred = curr;
[?2004l[?2004h>             curr = atomic_load(&pred->next[level]);
[?2004l[?2004h>         }
[?2004l[?2004h>         if (curr != NULL && curr->key == key) {
[?2004l[?2004h>             free(new_node);
[?2004l[?2004h>             return false;
[?2004l[?2004h>         }
[?2004l[?2004h>         preds[level] = pred;
[?2004l[?2004h>         succs[level] = curr;
[?2004l[?2004h>     }
[?2004l[?2004h>     
[?2004l[?2004h>     skiplist_node *expected = succs[0];
[?2004l[?2004h>     while (true) {
[?2004l[?2004h>         atomic_store(&new_node->next[0], expected);
[?2004l[?2004h>         if (atomic_compare_exchange_weak(&preds[0]->next[0], &expected, new_node)) {
[?2004l[?2004h>             break;
[?2004l[?2004h>         }
[?2004l[?2004h>         if (expected == succs[0]) {
[?2004l[?2004h>             continue;
[?2004l[?2004h>         }
[?2004l[?2004h>         goto retry;
[?2004l[?2004h>     }
[?2004l[?2004h>     
[?2004l[?2004h>     for (int level = 1; level <= top_level; level++) {
[?2004l[?2004h>         expected = succs[level];
[?2004l[?2004h>         while (true) {
[?2004l[?2004h>             atomic_store(&new_node->next[level], expected);
[?2004l[?2004h>             if (atomic_compare_exchange_weak(&preds[level]->next[level], &expected, new_node)) {
[?2004l[?2004h>                 break;
[?2004l[?2004h>             }
[?2004l[?2004h>             if (expected == succs[level]) {
[?2004l[?2004h>                 continue;
[?2004l[?2004h>             }
[?2004l[?2004h>             skiplist_node *p = sl->head;
[?2004l[?2004h>             skiplist_node *c;
[?2004l[?2004h>             for (int l = MAX_LEVEL - 1; l >= level; l--) {
[?2004l[?2004h>                 c = atomic_load(&p->next[l]);
[?2004l[?2004h>                 while (c != NULL && c->key < key) {
[?2004l[?2004h>                     p = c;
[?2004l[?2004h>                     c = atomic_load(&p->next[l]);
[?2004l[?2004h>                 }
[?2004l[?2004h>             }
[?2004l[?2004h>             preds[level] = p;
[?2004l[?2004h>             succs[level] = c;
[?2004l[?2004h>             expected = c;
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h>     return true;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> bool skiplist_search(skiplist_t *sl, int key) {
[?2004l[?2004h>     skiplist_node *pred = sl->head;
[?2004l[?2004h>     for (int level = MAX_LEVEL - 1; level >= 0; level--) {
[?2004l[?2004h>         skiplist_node *curr = atomic_load(&pred->next[level]);
[?2004l[?2004h>         while (curr != NULL && curr->key < key) {
[?2004l[?2004h>             pred = curr;
[?2004l[?2004h>             curr = atomic_load(&pred->next[level]);
[?2004l[?2004h>         }
[?2004l[?2004h>         if (curr != NULL && curr->key == key) {
[?2004l[?2004h>             return true;
[?2004l[?2004h>         }
[?2004l[?2004h>     }
[?2004l[?2004h>     return false;
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> int random_level(void) {
