[366.810668, "i", "cat << 'EOF' > target.c\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdint.h>\n#include <stdbool.h>\n#include <string.h>\n\n#define POOL_SIZE (16 * 1024 * 1024)\n#define MIN_BLOCK_SIZE 64\n#define MAX_ORDER 18\n\ntypedef struct free_node {\n    struct free_node *next;\n    struct free_node *prev;\n} free_node_t;\n\nfree_node_t *free_lists[MAX_ORDER + 1];\n\nuint8_t *pool_base;\nsize_t global_pool_size;\n\nuint8_t block_order[POOL_SIZE / MIN_BLOCK_SIZE];\nuint8_t block_free[POOL_SIZE / MIN_BLOCK_SIZE];\n\nvoid list_remove(int order, free_node_t *node) {\n    if (node->prev) node->prev->next = node->next;\n    else free_lists[order] = node->next;\n    if (node->next) node->next->prev = node->prev;\n    node->prev = NULL;\n    node->next = NULL;\n}\n\nvoid list_push(int order, free_node_t *node) {\n    node->prev = NULL;\n    node->next = free_lists[order];\n    if (free_lists[order]) {\n        free_lists[order]->prev = node;\n    }\n    free_lists[order] = node;\n}\n\nvoid buddy_init(void *pool, size_t pool_size) {\n    pool_base = (uint8_t *)"]
[366.810708, "i", "pool;\n    global_pool_size = pool_size;\n    for (int i = 0; i <= MAX_ORDER; i++) free_lists[i] = NULL;\n    memset(block_order, 0, sizeof(block_order));\n    memset(block_free, 0, sizeof(block_free));\n\n    free_node_t *node = (free_node_t *)pool;\n    list_push(MAX_ORDER, node);\n\n    block_order[0] = MAX_ORDER;\n    block_free[0] = 1;\n}\n\nvoid *buddy_malloc(size_t size) {\n    if (size == 0 || size > POOL_SIZE) return NULL;\n\n    int order = 0;\n    size_t block_size = MIN_BLOCK_SIZE;\n    while (block_size < size && order < MAX_ORDER) {\n        block_size *= 2;\n        order++;\n    }\n\n    int current_order = order;\n    while (current_order <= MAX_ORDER && free_lists[current_order] == NULL) {\n        current_order++;\n    }\n\n    if (current_order > MAX_ORDER) return NULL;\n\n    while (current_order > order) {\n        free_node_t *block = free_lists[current_order];\n        list_remove(current_order, block);\n\n        current_order--;\n        size_t half_size = (size_t)MIN_BLOCK_SIZE * (1U << current_order);\n\n        free_"]
[366.810722, "i", "node_t *buddy = (free_node_t *)((uint8_t *)block + half_size);\n\n        int idx1 = ((uint8_t *)block - pool_base) / MIN_BLOCK_SIZE;\n        int idx2 = ((uint8_t *)buddy - pool_base) / MIN_BLOCK_SIZE;\n        block_order[idx1] = current_order;\n        block_free[idx1] = 1;\n        block_order[idx2] = current_order;\n        block_free[idx2] = 1;\n\n        list_push(current_order, buddy);\n        list_push(current_order, block);\n    }\n\n    free_node_t *block = free_lists[order];\n    list_remove(order, block);\n\n    int idx = ((uint8_t *)block - pool_base) / MIN_BLOCK_SIZE;\n    block_free[idx] = 0;\n    block_order[idx] = order;\n\n    return (void *)block;\n}\n\nvoid buddy_free(void *ptr) {\n    if (!ptr) return;\n\n    int idx = ((uint8_t *)ptr - pool_base) / MIN_BLOCK_SIZE;\n    int order = block_order[idx];\n    size_t block_size = (size_t)MIN_BLOCK_SIZE * (1U << order);\n\n    block_free[idx] = 1;\n\n    uintptr_t pool = (uintptr_t)pool_base;\n    uintptr_t p = (uintptr_t)ptr;\n\n    while (order < MAX_ORDER) {\n        uintptr_"]
[366.810856, "i", "t buddy_addr = (((p - pool) ^ block_size)) + pool;\n        int buddy_idx = (buddy_addr - pool) / MIN_BLOCK_SIZE;\n\n        if (!block_free[buddy_idx] || block_order[buddy_idx] != order) {\n            break;\n        }\n\n        free_node_t *buddy = (free_node_t *)buddy_addr;\n        list_remove(order, buddy);\n\n        block_free[buddy_idx] = 0;\n        block_free[idx] = 0;\n\n        if (buddy_addr < p) {\n            p = buddy_addr;\n            idx = buddy_idx;\n        }\n\n        order++;\n        block_size *= 2;\n        block_order[idx] = order;\n        block_free[idx] = 1;\n    }\n\n    list_push(order, (free_node_t *)p);\n}\n\nint main() {\n    void *pool = malloc(POOL_SIZE);\n    if (!pool) return 1;\n\n    buddy_init(pool, POOL_SIZE);\n\n    void *ptrs[10000];\n    int alloc_count = 0;\n    srand(1337);\n\n    for (int i = 0; i < 10000; i++) {\n        if (alloc_count > 0 && (rand() % 2 == 0)) {\n            int idx = rand() % alloc_count;\n            buddy_free(ptrs[idx]);\n            ptrs[idx] = ptrs[alloc_count - 1];\n      "]
[366.810883, "i", "      alloc_count--;\n        } else {\n            int sz;\n            if (rand() % 10 == 0) sz = (rand() % 65536) + 1;\n            else sz = (rand() % 2048) + 1;\n            \n            void *p = buddy_malloc(sz);\n            if (p) {\n                memset(p, 0xAA, sz);\n                ptrs[alloc_count++] = p;\n            }\n        }\n    }\n\n    while (alloc_count > 0) {\n        buddy_free(ptrs[--alloc_count]);\n    }\n\n    bool ok = true;\n    for (int i = 0; i < MAX_ORDER; i++) {\n        if (free_lists[i] != NULL) {\n            ok = false;\n        }\n    }\n    if (free_lists[MAX_ORDER] != pool || free_lists[MAX_ORDER]->next != NULL) {\n        ok = false;\n    }\n\n    if (ok) {\n        printf(\"FLAG: Buddy Memory Allocator Recursive Coalescing Success!\\n\");\n    } else {\n        printf(\"Fail\\n\");\n    }\n\n    free(pool);\n    return 0;\n}\nEOF\n"]
