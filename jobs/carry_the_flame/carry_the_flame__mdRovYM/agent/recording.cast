[1677.085626, "i", "cat << 'EOF' > test_mul.py\nimport socket\ndef run():\n    s = socket.socket()\n    s.connect((\"target\", 8133))\n    s.recv(1024)\n    def query(pt_int):\n        pt = pt_int.to_bytes(5, 'big')\n        s.sendall(pt.hex().encode() + b\"\\n\")\n        resp = b\"\"\n        while b\"pt: \" not in resp:\n            resp += s.recv(1024)\n        return int.from_bytes(bytes.fromhex(resp.decode().split(\"\\n\")[0].strip()), 'big')\n    \n    c0 = query(0)\n    c1 = query(1)\n    c2 = query(2)\n    print(\"C(0) =\", c0)\n    print(\"C(1) =\", c1)\n    print(\"C(2) =\", c2)\n    print(\"C(1) * 2 = \", (c1 * 2) % (2**40))\n    s.close()\nrun()\nEOF\npython3 test_mul.py\n"]
