[2686.11533, "i", "cat << 'EOF' > test_mt.py\nimport socket, time\ndef query_C0():\n    s = socket.socket()\n    s.connect((\"target\", 8133))\n    s.recv(1024)\n    s.sendall(b\"00\"*5 + b\"\\n\")\n    resp = b\"\"\n    while b\"pt: \" not in resp:\n        resp += s.recv(1024)\n    s.close()\n    return int.from_bytes(bytes.fromhex(resp.decode().split(\"\\n\")[0].strip()), 'big')\n\nvals = [query_C0() for _ in range(5)]\nprint(\"C(0) ints:\", vals)\nEOF\npython3 test_mt.py\n"]
