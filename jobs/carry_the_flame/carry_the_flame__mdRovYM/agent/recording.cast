[138.215163, "i", "cat << 'EOF' > interact.py\nimport socket\ndef run():\n    s = socket.socket()\n    s.connect((\"target\", 8133))\n    data = s.recv(1024).decode()\n    \n    def query(pt):\n        s.sendall(pt.encode() + b\"\\n\")\n        resp = b\"\"\n        while b\"pt: \" not in resp:\n            chunk = s.recv(1024)\n            if not chunk: break\n            resp += chunk\n        res_str = resp.decode()\n        # The response is ciphertext\\npt: \n        return res_str.split(\"\\n\")[0].strip()\n    \n    print(\"Q1:\", query(\"00\"*5))\n    print(\"Q2:\", query(\"00\"*5))\n    print(\"Q3:\", query(\"01\"*5))\n    s.close()\nrun()\nEOF\npython3 interact.py\n"]
