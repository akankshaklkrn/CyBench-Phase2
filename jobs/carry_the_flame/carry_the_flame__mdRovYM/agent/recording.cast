[1131.917969, "i", "cat << 'EOF' > test_pipe.py\nimport socket, time\ns = socket.socket()\ns.connect((\"target\", 8133))\ns.recv(1024)\n# Send a huge block that will take time to process\ns.sendall(b\"00\" * 5 * 1000000 + b\"\\n\")\n# Immediately close the socket completely\ns.close()\n# Do this 5 times to surely trigger the error\nfor _ in range(5):\n    s = socket.socket()\n    s.connect((\"target\", 8133))\n    s.recv(1024)\n    s.sendall(b\"00\" * 5 * 500000 + b\"\\n\")\n    s.close()\nEOF\npython3 test_pipe.py\n"]
