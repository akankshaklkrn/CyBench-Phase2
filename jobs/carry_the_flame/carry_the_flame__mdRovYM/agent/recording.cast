[384.33862, "i", "cat << 'EOF' > test_empty.py\nimport socket\ns = socket.socket()\ns.connect((\"target\", 8133))\ns.recv(1024)\ns.sendall(b\"\\n\")\nresp = b\"\"\nwhile True:\n    try:\n        s.settimeout(1)\n        chunk = s.recv(1024)\n        if not chunk: break\n        resp += chunk\n    except timeout:\n        break\n    except:\n        break\nprint(\"Empty response:\", resp.decode())\ns.close()\nEOF\npython3 test_empty.py\n"]
