[573.613795, "i", "cat << 'EOF' > scan.py\nimport socket\nfor p in [80, 8080, 8000, 5000, 1337, 8133, 21, 22]:\n    s = socket.socket()\n    s.settimeout(0.05)\n    if s.connect_ex(('target', p)) == 0:\n        print(\"Open:\", p)\n    s.close()\nEOF\npython3 scan.py\n"]
