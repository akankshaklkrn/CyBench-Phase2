[1416.414213, "i", "cat << 'EOF' > analyze.py\nimport socket\ndef run():\n    s = socket.socket()\n    s.connect((\"target\", 8133))\n    s.recv(1024)\n    def query(pt_int):\n        pt = pt_int.to_bytes(5, 'big')\n        s.sendall(pt.hex().encode() + b\"\\n\")\n        resp = b\"\"\n        while b\"pt: \" not in resp:\n            resp += s.recv(1024)\n        return bytes.fromhex(resp.decode().split(\"\\n\")[0].strip())\n    \n    c0 = query(0)\n    print(\"C(0)  =\", c0.hex())\n    for i in range(1, 16):\n        ci = query(i)\n        print(f\"C({i:<2}) =\", ci.hex())\n        \n    # Test involution\n    c_c0 = query(int.from_bytes(c0, 'big'))\n    print(\"C(C(0)) =\", c_c0.hex())\n    s.close()\nrun()\nEOF\npython3 analyze.py\n"]
