[737.92739, "i", "cat << 'EOF' > fuzz.py\nimport socket\ndef run():\n    s = socket.socket()\n    s.connect((\"target\", 8133))\n    s.recv(1024)\n    def query(pt_bytes):\n        s.sendall(pt_bytes.hex().encode() + b\"\\n\")\n        resp = b\"\"\n        while b\"pt: \" not in resp:\n            chunk = s.recv(1024)\n            if not chunk: break\n            resp += chunk\n        return resp.decode()\n    \n    patterns = [b\"\\xff\"*5, b\"\\x00\\xff\\x00\\xff\\x00\", b\"\\x7f\"*5, b\"\\x80\"*5, b\"\\x00\"*4 + b\"\\x10\"]\n    for p in patterns:\n        res = query(p)\n        if \"Traceback\" in res:\n            print(f\"Crash with {p.hex()}:\\n\", res)\n    print(\"Fuzzing complete.\")\n    s.close()\nrun()\nEOF\npython3 fuzz.py\n"]
