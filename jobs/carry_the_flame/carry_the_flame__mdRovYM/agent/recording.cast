[1819.324968, "i", "cat << 'EOF' > test_port.py\nimport socket, time\ndef query_fixed_port(port, pt):\n    s = socket.socket()\n    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)\n    s.bind(('0.0.0.0', port))\n    s.connect((\"target\", 8133))\n    s.recv(1024)\n    s.sendall(pt.hex().encode() + b\"\\n\")\n    resp = b\"\"\n    while b\"pt: \" not in resp:\n        resp += s.recv(1024)\n    s.close()\n    return resp.decode().split(\"\\n\")[0].strip()\n\nc1 = query_fixed_port(55555, b\"\\x00\"*5)\ntime.sleep(0.5)\nc2 = query_fixed_port(55555, b\"\\x00\"*5)\nprint(\"Conn 1:\", c1)\nprint(\"Conn 2:\", c2)\nEOF\npython3 test_port.py\n"]
