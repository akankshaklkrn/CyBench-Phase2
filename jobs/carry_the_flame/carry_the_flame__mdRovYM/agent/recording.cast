[226.374087, "i", "cat << 'EOF' > diff.py\nimport socket\ndef run():\n    s = socket.socket()\n    s.connect((\"target\", 8133))\n    data = s.recv(1024).decode()\n    \n    def query(pt_bytes):\n        s.sendall(pt_bytes.hex().encode() + b\"\\n\")\n        resp = b\"\"\n        while b\"pt: \" not in resp:\n            chunk = s.recv(1024)\n            if not chunk: break\n            resp += chunk\n        res_str = resp.decode()\n        return bytes.fromhex(res_str.split(\"\\n\")[0].strip())\n    \n    pt0 = b\"\\x00\" * 5\n    ct0 = query(pt0)\n    print(f\"C(0) = {ct0.hex()}\")\n    \n    for i in range(40):\n        pt = bytearray(5)\n        pt[i // 8] ^= (1 << (7 - (i % 8)))\n        ct = query(bytes(pt))\n        diff = bytes(a ^ b for a, b in zip(ct0, ct))\n        hw = bin(int.from_bytes(diff, 'big')).count('1')\n        print(f\"Bit {i} flipped -> Diff HW: {hw}, Diff: {diff.hex()}\")\n        \n    s.close()\nrun()\nEOF\npython3 diff.py\n"]
