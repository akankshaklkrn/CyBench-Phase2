[593.871088, "i", "cat << 'EOF' > test_echo.py\nimport socket\nfor i in range(5):\n    s = socket.socket()\n    s.connect((\"target\", 8133))\n    s.recv(1024)\n    \n    s.sendall(b\"00\"*5 + b\"\\n\")\n    resp = b\"\"\n    while b\"pt: \" not in resp:\n        resp += s.recv(1024)\n    c = resp.split(b\"\\n\")[0].strip()\n    s.sendall(c + b\"\\n\")\n    r2 = b\"\"\n    while b\"pt: \" not in r2:\n        chunk = s.recv(1024)\n        if not chunk: break\n        r2 += chunk\n    c2 = r2.split(b\"\\n\")[0].strip()\n    if c == c2 or b\"dice\" in r2:\n        print(\"Found something:\", r2)\n    s.close()\nprint(\"Done\")\nEOF\npython3 test_echo.py\n"]
