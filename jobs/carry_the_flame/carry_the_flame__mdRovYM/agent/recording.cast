[571.638173, "i", "cat << 'EOF' > test_keys.py\nimport socket, concurrent.futures\ndef get_enc():\n    s = socket.socket()\n    s.connect((\"target\", 8133))\n    s.recv(1024)\n    s.sendall(b\"00\"*5 + b\"\\n\")\n    r = s.recv(1024).split(b\"\\n\")[0].decode()\n    s.close()\n    return r\nwith concurrent.futures.ThreadPoolExecutor(max_workers=10) as exe:\n    res = list(exe.map(lambda x: get_enc(), range(10)))\nprint(\"Unique C(0) keys:\", len(set(res)))\nprint(res)\nEOF\npython3 test_keys.py\n"]
