[952.633346, "i", "cat << 'EOF' > test_add.py\nimport socket\ndef run():\n    s = socket.socket()\n    s.connect((\"target\", 8133))\n    s.recv(1024)\n    def query(pt_int):\n        pt = pt_int.to_bytes(5, 'big')\n        s.sendall(pt.hex().encode() + b\"\\n\")\n        resp = b\"\"\n        while b\"pt: \" not in resp:\n            resp += s.recv(1024)\n        return int.from_bytes(bytes.fromhex(resp.decode().split(\"\\n\")[0].strip()), 'big')\n    \n    c0 = query(0)\n    cx = query(100)\n    cy = query(200)\n    cxy = query(300)\n    \n    calc = (cx + cy - c0) % (2**40)\n    print(\"Is additive affine?\", calc == cxy)\n    print(\"cxy:\", cxy)\n    print(\"calc:\", calc)\n    s.close()\nrun()\nEOF\npython3 test_add.py\n"]
[952.633687, "o", "cat << 'EOF' > test_add.py\r\nimport socket\r\ndef run():\r\n    s = socket.socket()\r\n    s.connect((\"target\", 8133))\r\n    s.recv(1024)\r\n    def query(pt_int):\r\n        pt = pt_int.to_bytes(5, 'big')\r\n        s.sendall(pt.hex().encode() + b\"\\n\")\r\n        resp = b\"\"\r\n        while b\"pt: \" not in resp:\r\n            resp += s.recv(1024)\r\n        return int.from_bytes(bytes.fromhex(resp.decode().split(\"\\n\")[0].strip()), 'big')\r\n    \r\n    c0 = query(0)\r\n    cx = query(100)\r\n    cy = query(200)\r\n    cxy = query(300)\r\n    \r\n    calc = (cx + cy - c0) % (2**40)\r\n    print(\"Is additive affine?\", calc == cxy)\r\n    print(\"cxy:\", cxy)\r\n    print(\"calc:\", calc)\r\n    s.close()\r\nrun()\r\nEOF\r\npython3 test_add.py\r\n"]
