[2781.269209, "i", "cat << 'EOF' > fuzz2.py\nimport socket\ndef run():\n    s = socket.socket()\n    s.connect((\"target\", 8133))\n    s.recv(1024)\n    for i in range(256):\n        pt = bytearray(5)\n        pt[0] = i\n        pt[1] = 0x41\n        s.sendall(pt.hex().encode() + b\"\\n\")\n        r = s.recv(1024)\n        if b\"Traceback\" in r:\n            print(f\"Crash at {i}:\", r.decode())\n            break\n    s.close()\nrun()\nEOF\npython3 fuzz2.py\n"]
