[1547.098579, "i", "cat << 'EOF' > test_speed.py\nimport socket, time\ns = socket.socket()\ns.connect((\"target\", 8133))\ns.recv(1024)\n\nblocks = 10000\npt = b\"00\" * 5 * blocks\nt0 = time.time()\ns.sendall(pt + b\"\\n\")\n\nresp = bytearray()\ntarget = blocks * 10\nwhile len(resp) < target:\n    chunk = s.recv(65536)\n    if not chunk: break\n    resp.extend(chunk)\nt1 = time.time()\nprint(f\"{blocks} blocks in {t1-t0:.3f} sec, ({blocks/(t1-t0):.0f} blk/s)\")\nEOF\npython3 test_speed.py\n"]
