[1757.430392, "i", "cat << 'EOF' > test_degree.py\nimport socket, random\ndef run():\n    s = socket.socket()\n    s.connect((\"target\", 8133))\n    s.recv(1024)\n    def query(pt_int):\n        pt = pt_int.to_bytes(5, 'big')\n        s.sendall(pt.hex().encode() + b\"\\n\")\n        resp = b\"\"\n        while b\"pt: \" not in resp:\n            resp += s.recv(1024)\n        return int.from_bytes(bytes.fromhex(resp.decode().split(\"\\n\")[0].strip()), 'big')\n    \n    a = 0x1\n    b = 0x2\n    print(\"Testing 2nd order XOR diff:\")\n    for _ in range(5):\n        x = random.randint(0, 0xFFFFFF)\n        v = query(x) ^ query(x^a) ^ query(x^b) ^ query(x^a^b)\n        print(f\"x={x:<8} diff2={hex(v)}\")\n        \n    print(\"\\nTesting 2nd order ADD diff:\")\n    M = 2**40\n    for _ in range(5):\n        x = random.randint(0, 0xFFFFFF)\n        # C(x+a+b) - C(x+a) - C(x+b) + C(x)\n        v = (query(x+a+b) - query(x+a) - query(x+b) + query(x)) % M\n        print(f\"x={x:<8} diff2_add={hex(v)}\")\n    s.close()\nrun()\nEOF\npython3 test_degree.py\n"]
[1757.430587, "o", "cat << 'EOF' > test_degree.py\r\n\u001b[?2004l\r\u001b[?2004h> "]
