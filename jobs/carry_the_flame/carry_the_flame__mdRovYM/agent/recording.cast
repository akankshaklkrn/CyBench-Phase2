[368.947898, "i", "cat << 'EOF' > test_diff.py\nimport socket\ndef get_diff():\n    s = socket.socket()\n    s.connect((\"target\", 8133))\n    s.recv(1024)\n    \n    # query 0\n    s.sendall(b\"00\"*5 + b\"\\n\")\n    resp = b\"\"\n    while b\"pt: \" not in resp:\n        resp += s.recv(1024)\n    c0 = bytes.fromhex(resp.decode().split(\"\\n\")[0].strip())\n    \n    # query 1\n    s.sendall(b\"80\" + b\"00\"*4 + b\"\\n\")\n    resp = b\"\"\n    while b\"pt: \" not in resp:\n        resp += s.recv(1024)\n    c1 = bytes.fromhex(resp.decode().split(\"\\n\")[0].strip())\n    s.close()\n    \n    return bytes(a ^ b for a,b in zip(c0, c1))\n\nprint(\"Diff 1:\", get_diff().hex())\nprint(\"Diff 2:\", get_diff().hex())\nEOF\npython3 test_diff.py\n"]
