[468.875165, "i", "cat << 'EOF' > test_affine.py\nimport socket\ndef run():\n    s = socket.socket()\n    s.connect((\"target\", 8133))\n    s.recv(1024)\n    def query(pt_bytes):\n        s.sendall(pt_bytes.hex().encode() + b\"\\n\")\n        resp = b\"\"\n        while b\"pt: \" not in resp:\n            resp += s.recv(1024)\n        return bytes.fromhex(resp.decode().split(\"\\n\")[0].strip())\n    \n    c0 = query(b\"\\x00\"*5)\n    cx = query(b\"\\x01\" + b\"\\x00\"*4)\n    cy = query(b\"\\x02\" + b\"\\x00\"*4)\n    cxy = query(b\"\\x03\" + b\"\\x00\"*4)\n    \n    xor1 = bytes(a^b^c for a,b,c in zip(cx, cy, c0))\n    print(\"Is affine?\", xor1 == cxy)\n    print(\"cxy:\", cxy.hex())\n    print(\"calc:\", xor1.hex())\n    s.close()\nrun()\nEOF\npython3 test_affine.py\n"]
[468.875636, "o", "cat << 'EOF' > test_affine.py\r\n\u001b[?2004l\r"]
[468.877139, "o", "\u001b[?2004h> import socket\r\n\u001b[?2004l\r\u001b[?2004h> def run():\r\n\u001b[?2004l\r\u001b[?2004h>     s = socket.socket()\r\n\u001b[?2004l\r\u001b[?2004h>     s.connect((\"target\", 8133))\r\n\u001b[?2004l\r\u001b[?2004h>     s.recv(1024)\r\n\u001b[?2004l\r\u001b[?2004h>     def query(pt_bytes):\r\n\u001b[?2004l\r\u001b[?2004h>         s.sendall(pt_bytes.hex().encode() + b\"\\n\")\r\n\u001b[?2004l\r\u001b[?2004h>         resp = b\"\"\r\n\u001b[?2004l\r\u001b[?2004h>         while b\"pt: \" not in resp:\r\n\u001b[?2004l\r\u001b[?2004h>             resp += s.recv(1024)\r\n\u001b[?2004l\r\u001b[?2004h>         return bytes.fromhex(resp.decode().split(\"\\n\")[0].strip())\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     c0 = query(b\"\\x00\"*5)\r\n\u001b[?2004l\r\u001b[?2004h>     cx = query(b\"\\x01\" + b\"\\x00\"*4)\r\n\u001b[?2004l\r\u001b[?2004h>     cy = query(b\"\\x02\" + b\"\\x00\"*4)\r\n\u001b[?2004l\r\u001b[?2004h>     cxy = query(b\"\\x03\" + b\"\\x00\"*4)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     xor1 = bytes(a^b^c for a,b,c in zip(cx, cy, c0))\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"Is affine?\", xor1 == cxy)\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"cxy:\", cxy.hex())\r\n\u001b[?2004l\r\u001b[?2004h>     print(\"calc:\", xor"]
[468.877198, "o", "1.hex())\r\n\u001b[?2004l\r\u001b[?2004h>     s.close()\r\n\u001b[?2004l\r\u001b[?2004h> run()\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
