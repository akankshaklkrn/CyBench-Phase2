[91.832001, "i", "cat << 'EOF' > check_cipher.py\nimport socket\ndef enc(pt: bytes) -> bytes:\n    s = socket.socket()\n    s.connect((\"target\", 8133))\n    # read until prompt\n    resp = b\"\"\n    while b\"pt: \" not in resp:\n        resp += s.recv(1024)\n    \n    s.sendall(pt.hex().encode() + b\"\\n\")\n    resp = b\"\"\n    while b\"\\n\" not in resp:\n        resp += s.recv(1024)\n    s.close()\n    return resp.strip()\n\nprint(\"Zero block 1:\", enc(b\"\\x00\"*5).decode())\nprint(\"Zero block 2:\", enc(b\"\\x00\"*5).decode())\nprint(\"Double zero block:\", enc(b\"\\x00\"*10).decode())\nEOF\npython3 check_cipher.py\n"]
