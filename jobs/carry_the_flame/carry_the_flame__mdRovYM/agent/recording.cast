[339.761379, "i", "cat << 'EOF' > check_key.py\nimport socket\ndef get_enc(pt):\n    s = socket.socket()\n    s.connect((\"target\", 8133))\n    s.recv(1024)\n    s.sendall(pt + b\"\\n\")\n    resp = b\"\"\n    while b\"\\n\" not in resp:\n        resp += s.recv(1024)\n    s.close()\n    return resp.strip().decode()\n\nprint(\"Conn 1:\", get_enc(b\"00\"*5))\nprint(\"Conn 2:\", get_enc(b\"00\"*5))\nEOF\npython3 check_key.py\n"]
