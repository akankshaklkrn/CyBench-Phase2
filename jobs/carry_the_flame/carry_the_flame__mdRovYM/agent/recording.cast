[1053.53788, "i", "cat << 'EOF' > pool.py\nimport socket\ndef get_enc():\n    s = socket.socket()\n    s.connect((\"target\", 8133))\n    s.recv(1024)\n    s.sendall(b\"00\"*10 + b\"\\n\")\n    r = b\"\"\n    while b\"pt: \" not in r:\n        r += s.recv(1024)\n    s.close()\n    return r.split(b\"\\n\")[0].decode().strip()\n\nres = []\nfor _ in range(50):\n    res.append(get_enc())\nprint(\"Unique C(0) keys over 50 conns:\", len(set(res)))\nEOF\npython3 pool.py\n"]
[1053.538121, "o", "cat << 'EOF' > pool.py\r\n\u001b[?2004l\r"]
