[160.478269, "i", "cat << 'EOF' > target.c\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdint.h>\n#include <stdatomic.h>\n#include <pthread.h>\n#include <stdbool.h>\n#include <unistd.h>\n\n#define NUM_THREADS 16\n#define TOTAL_OBJECTS 300000\n#define HP_SLOTS_PER_THREAD 2\n#define RETIRE_THRESHOLD 100\n#define MAX_RETIRED (RETIRE_THRESHOLD + 100)\n\ntypedef struct {\n    _Atomic(void*) hazard_pointers[NUM_THREADS][HP_SLOTS_PER_THREAD];\n} hp_engine_t;\n\nhp_engine_t engine;\n\n__thread struct {\n    void* ptrs[MAX_RETIRED];\n    int count;\n} retired_list;\n\nvoid hp_acquire(int thread_id, int slot, void *ptr) {\n    atomic_store_explicit(&engine.hazard_pointers[thread_id][slot], ptr, memory_order_seq_cst);\n}\n\nvoid hp_release(int thread_id, int slot) {\n    atomic_store_explicit(&engine.hazard_pointers[thread_id][slot], NULL, memory_order_seq_cst);\n}\n\nvoid hp_scan(int thread_id) {\n    void* active_hps[NUM_THREADS * HP_SLOTS_PER_THREAD];\n    int num_active = 0;\n    for (int t = 0; t < NUM_THREADS; t++) {\n        for (int s = 0; s < HP_SLOTS_PER_THR"]
[160.478453, "i", "EAD; s++) {\n            void* hp = atomic_load_explicit(&engine.hazard_pointers[t][s], memory_order_seq_cst);\n            if (hp) active_hps[num_active++] = hp;\n        }\n    }\n    int new_count = 0;\n    for (int i = 0; i < retired_list.count; i++) {\n        void* rptr = retired_list.ptrs[i];\n        bool hazardous = false;\n        for (int j = 0; j < num_active; j++) {\n            if (active_hps[j] == rptr) {\n                hazardous = true;\n                break;\n            }\n        }\n        if (!hazardous) {\n            free(rptr);\n        } else {\n            if (new_count < MAX_RETIRED) retired_list.ptrs[new_count++] = rptr;\n        }\n    }\n    retired_list.count = new_count;\n}\n\nvoid hp_retire(int thread_id, void *ptr) {\n    if (!ptr) return;\n    if (retired_list.count >= MAX_RETIRED) hp_scan(thread_id);\n    while (retired_list.count >= MAX_RETIRED) {\n        usleep(10);\n        hp_scan(thread_id);\n    }\n    retired_list.ptrs[retired_list.count++] = ptr;\n    if (retired_list.count >= RETIRE_THRESHOLD"]
[160.478578, "o", "cat << 'EOF' > target.c\r\n\u001b[?2004l\r"]
[160.47861, "i", ") hp_scan(thread_id);\n}\n\nvoid hp_reclaim_all(int thread_id) {\n    while (retired_list.count > 0) {\n        hp_scan(thread_id);\n        if (retired_list.count > 0) usleep(100);\n    }\n}\n\n_Atomic(void*) shared_obj;\n\nvoid* thread_func(void* arg) {\n    int thread_id = (int)(intptr_t)arg;\n    int objects_per_thread = TOTAL_OBJECTS / NUM_THREADS;\n    for (int i = 0; i < objects_per_thread; i++) {\n        int* new_obj = malloc(sizeof(int));\n        if (!new_obj) continue;\n        *new_obj = thread_id;\n        void* old_obj = atomic_exchange_explicit(&shared_obj, new_obj, memory_order_seq_cst);\n        void* read_obj;\n        do {\n            read_obj = atomic_load_explicit(&shared_obj, memory_order_seq_cst);\n            if (!read_obj) break;\n            hp_acquire(thread_id, 0, read_obj);\n            if (atomic_load_explicit(&shared_obj, memory_order_seq_cst) != read_obj) {\n                hp_release(thread_id, 0);\n                continue;\n            }\n            break;\n        } while (1);\n        if (read_obj) {"]
[160.478618, "o", "\u001b[?2004h> #include <stdio.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdlib.h>\r\n\u001b[?2004l\r"]
[160.478724, "i", "\n            volatile int val = *(int*)read_obj;\n            (void)val;\n        }\n        hp_release(thread_id, 0);\n        if (old_obj != NULL) hp_retire(thread_id, old_obj);\n    }\n    hp_reclaim_all(thread_id);\n    return NULL;\n}\n\nint main() {\n    for (int t = 0; t < NUM_THREADS; t++) {\n        for (int s = 0; s < HP_SLOTS_PER_THREAD; s++) {\n            atomic_init(&engine.hazard_pointers[t][s], NULL);\n        }\n    }\n    atomic_init(&shared_obj, NULL);\n    pthread_t threads[NUM_THREADS];\n    for (int t = 0; t < NUM_THREADS; t++) {\n        pthread_create(&threads[t], NULL, thread_func, (void*)(intptr_t)t);\n    }\n    for (int t = 0; t < NUM_THREADS; t++) {\n        pthread_join(threads[t], NULL);\n    }\n    void *last = atomic_load_explicit(&shared_obj, memory_order_seq_cst);\n    if (last) free(last);\n    printf(\"FLAG: Hazard Engine ASAN Success!\\n\");\n    return 0;\n}\nEOF\n"]
