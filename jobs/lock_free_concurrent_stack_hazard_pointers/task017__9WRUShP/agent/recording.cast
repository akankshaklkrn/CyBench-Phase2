[284.261879, "o", "        new_node->next = old_head;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.262026, "o", "    } while (!atomic_compare_exchange_weak_explicit(&s->head, &old_head, new_node,\r\n\u001b[?2004l\r"]
[284.262063, "o", "\u001b[?2004h> "]
[284.262188, "o", "        memory_order_release, memory_order_relaxed));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.262219, "o", "}\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.262351, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.262399, "o", "bool pop(stack_t *s, int *value, int thread_id) {\r\n\u001b[?2004l\r"]
[284.262407, "o", "\u001b[?2004h> "]
[284.26247, "o", "    node_t *old_head;\r\n\u001b[?2004l\r"]
[284.262545, "o", "\u001b[?2004h> "]
[284.262661, "o", "    while (true) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.262856, "o", "        old_head = atomic_load_explicit(&s->head, memory_order_seq_cst);\r\n\u001b[?2004l\r\u001b[?2004h>         if (old_head == NULL) {\r\n\u001b[?2004l\r\u001b[?2004h>             return false;"]
[284.262944, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.263103, "o", ">         atomic_store_explicit(&hazard_pointers[thread_id], old_head, memory_order_seq_cst);\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.263176, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[284.263199, "o", "> "]
[284.263357, "o", "        if (atomic_load_explicit(&s->head, memory_order_seq_cst) != old_head) {\r\n\u001b[?2004l\r"]
[284.263432, "o", "\u001b[?2004h>             continue;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.263477, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.263558, "o", "        node_t *next_node = old_head->next;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.263666, "o", "        if (atomic_compare_exchange_weak_explicit(&s->head, &old_head, next_node,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.263808, "o", "            memory_order_release, memory_order_relaxed)) {\r\n\u001b[?2004l\r\u001b[?2004h>             break;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[284.263837, "o", "\u001b[?2004h> "]
[284.263924, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.264011, "o", "    *value = old_head->value;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.264177, "o", "    atomic_store_explicit(&hazard_pointers[thread_id], NULL, memory_order_seq_cst);\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.264262, "o", "    retire_node(old_head);\r\n\u001b[?2004l\r\u001b[?2004h>     return true;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.264345, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> stack_t global_stack;\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.264373, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[284.264462, "o", "> void* thread_func(void* arg) {"]
[284.264484, "o", "\r\n\u001b[?2004l\r"]
[284.264566, "o", "\u001b[?2004h> "]
[284.264627, "o", "    int thread_id = (int)(long)arg;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.264667, "o", "    for (int i = 0; i < ITEMS_PER_THREAD; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.264782, "o", "        push(&global_stack, i);\r\n\u001b[?2004l\r\u001b[?2004h>         int val;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.264928, "o", "        while (!pop(&global_stack, &val, thread_id));\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return NULL;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[284.26499, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.265052, "o", "int main() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.265088, "o", "    atomic_init(&global_stack.head, NULL);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.265261, "o", "    for(int i = 0; i < NUM_THREADS; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>         atomic_init(&hazard_pointers[i], NULL);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[284.265358, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     pthread_t threads[NUM_THREADS];\r\n\u001b[?2004l\r"]
[284.265458, "o", "\u001b[?2004h> "]
[284.26565, "o", "    for (long i = 0; i < NUM_THREADS; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>         pthread_create(&threads[i], NULL, thread_func, (void*)i);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[284.265829, "o", "\u001b[?2004h>     for (int i = 0; i < NUM_THREADS; i++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[284.266042, "o", ">         pthread_join(threads[i], NULL);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.266057, "o", "    printf(\"FLAG: Hazard Stack Success!\\n\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[284.266109, "o", "    return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r"]
[284.266213, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
