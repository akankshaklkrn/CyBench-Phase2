[284.257622, "i", "cat << 'EOF' > generate.py\nimport os\n\ncode = r\"\"\"\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdatomic.h>\n#include <pthread.h>\n#include <stdbool.h>\n\n#define NUM_THREADS 16\n#define ITEMS_PER_THREAD 200000\n\ntypedef struct node {\n    int value;\n    struct node *next;\n} node_t;\n\ntypedef struct stack {\n    _Atomic(node_t*) head;\n} stack_t;\n\n_Atomic(node_t*) hazard_pointers[NUM_THREADS];\n\n_Thread_local node_t* retired_list[NUM_THREADS * 2];\n_Thread_local int retired_count = 0;\n\nvoid retire_node(node_t *node) {\n    retired_list[retired_count++] = node;\n    if (retired_count == NUM_THREADS * 2) {\n        node_t* hp[NUM_THREADS];\n        for (int i = 0; i < NUM_THREADS; i++) {\n            hp[i] = atomic_load_explicit(&hazard_pointers[i], memory_order_acquire);\n        }\n        \n        int new_count = 0;\n        for (int i = 0; i < retired_count; i++) {\n            node_t *r = retired_list[i];\n            bool guarded = false;\n            for (int j = 0; j < NUM_THREADS; j++) {\n                if (hp[j] == r) {"]
[284.257696, "i", "\n                    guarded = true;\n                    break;\n                }\n            }\n            if (guarded) {\n                retired_list[new_count++] = r;\n            } else {\n                free(r);\n            }\n        }\n        retired_count = new_count;\n    }\n}\n\nvoid push(stack_t *s, int value) {\n    node_t *new_node = malloc(sizeof(node_t));\n    new_node->value = value;\n    node_t *old_head = atomic_load_explicit(&s->head, memory_order_relaxed);\n    do {\n        new_node->next = old_head;\n    } while (!atomic_compare_exchange_weak_explicit(&s->head, &old_head, new_node,\n        memory_order_release, memory_order_relaxed));\n}\n\nbool pop(stack_t *s, int *value, int thread_id) {\n    node_t *old_head;\n    while (true) {\n        old_head = atomic_load_explicit(&s->head, memory_order_seq_cst);\n        if (old_head == NULL) {\n            return false;\n        }\n        atomic_store_explicit(&hazard_pointers[thread_id], old_head, memory_order_seq_cst);\n\n        if (atomic_load_explicit(&s->head, "]
[284.257713, "i", "memory_order_seq_cst) != old_head) {\n            continue;\n        }\n\n        node_t *next_node = old_head->next;\n        if (atomic_compare_exchange_weak_explicit(&s->head, &old_head, next_node,\n            memory_order_release, memory_order_relaxed)) {\n            break;\n        }\n    }\n\n    *value = old_head->value;\n    atomic_store_explicit(&hazard_pointers[thread_id], NULL, memory_order_seq_cst);\n    \n    retire_node(old_head);\n    return true;\n}\n\nstack_t global_stack;\n\nvoid* thread_func(void* arg) {\n    int thread_id = (int)(long)arg;\n    for (int i = 0; i < ITEMS_PER_THREAD; i++) {\n        push(&global_stack, i);\n        int val;\n        while (!pop(&global_stack, &val, thread_id));\n    }\n    return NULL;\n}\n\nint main() {\n    atomic_init(&global_stack.head, NULL);\n    for(int i = 0; i < NUM_THREADS; i++) {\n        atomic_init(&hazard_pointers[i], NULL);\n    }\n    \n    pthread_t threads[NUM_THREADS];\n    for (long i = 0; i < NUM_THREADS; i++) {\n        pthread_create(&threads[i], NULL, thread_func, (void"]
[284.257719, "i", "*)i);\n    }\n    \n    for (int i = 0; i < NUM_THREADS; i++) {\n        pthread_join(threads[i], NULL);\n    }\n    \n    printf(\"FLAG: Hazard Stack Success!\\n\");\n    return 0;\n}\n\"\"\"\n\nwith open(\"target.c\", \"w\") as f:\n    f.write(code.lstrip())\nEOF\n"]
