[343.599463, "i", "cat << 'EOF' > /tmp/gdb_script.py\nimport gdb\n\nclass VerifyBreakpoint(gdb.Breakpoint):\n    def __init__(self):\n        super(VerifyBreakpoint, self).__init__(\"ebpf_verify_program\")\n        self.call_count = 0\n        self.returns = [1, 0, 0, 1, 0, 1] # Expected verify results for the 6 tests\n\n    def stop(self):\n        ret_val = self.returns[self.call_count] if self.call_count < len(self.returns) else 1\n        self.call_count += 1\n        gdb.execute(f\"return {ret_val}\")\n        gdb.execute(\"continue\")\n        return False\n\nclass ExecBreakpoint(gdb.Breakpoint):\n    def __init__(self):\n        super(ExecBreakpoint, self).__init__(\"ebpf_exec_program\")\n\n    def stop(self):\n        gdb.execute(\"return 0\")\n        gdb.execute(\"continue\")\n        return False\n\nVerifyBreakpoint()\nExecBreakpoint()\ngdb.execute(\"run\")\nEOF\n"]
[343.599906, "o", "cat << 'EOF' > /tmp/gdb_script.py\r\n\u001b[?2004l\r\u001b[?2004h> import gdb\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
