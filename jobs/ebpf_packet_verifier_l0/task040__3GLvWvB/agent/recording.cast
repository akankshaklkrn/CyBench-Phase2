[343.600612, "o", "        ret_val = self.returns[self.call_count] if self.call_count < len(self.returns) else 1\r\n\u001b[?2004l\r\u001b[?2004h>         self.call_count += 1\r\n\u001b[?2004l\r\u001b[?2004h>         gdb.execute(f\"return {ret_val}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
