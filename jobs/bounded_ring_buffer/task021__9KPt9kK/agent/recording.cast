[118.272977, "i", "cat << 'EOF' > target.c\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdint.h>\n#include <pthread.h>\n#include <stdatomic.h>\n\n#define CAPACITY 1024\n#define NUM_PRODUCERS 8\n#define NUM_CONSUMERS 8\n#define ITEMS_PER_PRODUCER 250000\n\ntypedef struct {\n    atomic_size_t sequence;\n    int data;\n} cell_t;\n\ntypedef struct {\n    cell_t buffer[CAPACITY];\n    atomic_size_t head __attribute__((aligned(128)));\n    atomic_size_t tail __attribute__((aligned(128)));\n} ring_buffer_t;\n\nvoid ring_init(ring_buffer_t *rb) {\n    atomic_init(&rb->head, 0);\n    atomic_init(&rb->tail, 0);\n    for (size_t i = 0; i < CAPACITY; i++) {\n        atomic_init(&rb->buffer[i].sequence, i);\n    }\n}\n\nvoid ring_push(ring_buffer_t *rb, int value) {\n    cell_t *cell;\n    size_t pos = atomic_load_explicit(&rb->tail, memory_order_relaxed);\n    for (;;) {\n        cell = &rb->buffer[pos & (CAPACITY - 1)];\n        size_t seq = atomic_load_explicit(&cell->sequence, memory_order_acquire);\n        intptr_t dif = (intptr_t)seq - (intptr_t)pos;\n        if "]
[118.273206, "i", "(dif == 0) {\n            if (atomic_compare_exchange_weak_explicit(&rb->tail, &pos, pos + 1, memory_order_relaxed, memory_order_relaxed)) {\n                break;\n            }\n        } else if (dif < 0) {\n            pos = atomic_load_explicit(&rb->tail, memory_order_relaxed);\n        } else {\n            pos = atomic_load_explicit(&rb->tail, memory_order_relaxed);\n        }\n    }\n    cell->data = value;\n    atomic_store_explicit(&cell->sequence, pos + 1, memory_order_release);\n}\n\nvoid ring_pop(ring_buffer_t *rb, int *value) {\n    cell_t *cell;\n    size_t pos = atomic_load_explicit(&rb->head, memory_order_relaxed);\n    for (;;) {\n        cell = &rb->buffer[pos & (CAPACITY - 1)];\n        size_t seq = atomic_load_explicit(&cell->sequence, memory_order_acquire);\n        intptr_t dif = (intptr_t)seq - (intptr_t)(pos + 1);\n        if (dif == 0) {\n            if (atomic_compare_exchange_weak_explicit(&rb->head, &pos, pos + 1, memory_order_relaxed, memory_order_relaxed)) {\n                break;\n            }\n    "]
[118.273259, "o", "cat << 'EOF' > target.c\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdio.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdlib.h>\r\n\u001b[?2004l\r"]
[118.273342, "i", "    } else if (dif < 0) {\n            pos = atomic_load_explicit(&rb->head, memory_order_relaxed);\n        } else {\n            pos = atomic_load_explicit(&rb->head, memory_order_relaxed);\n        }\n    }\n    *value = cell->data;\n    atomic_store_explicit(&cell->sequence, pos + CAPACITY, memory_order_release);\n}\n\nring_buffer_t rb;\n\nvoid* producer(void *arg) {\n    for (int i = 0; i < ITEMS_PER_PRODUCER; i++) {\n        ring_push(&rb, i);\n    }\n    return NULL;\n}\n\nvoid* consumer(void *arg) {\n    for (int i = 0; i < ITEMS_PER_PRODUCER; i++) {\n        int val;\n        ring_pop(&rb, &val);\n    }\n    return NULL;\n}\n\nint main() {\n    ring_init(&rb);\n    pthread_t prods[NUM_PRODUCERS], cons[NUM_CONSUMERS];\n\n    for (int i = 0; i < NUM_PRODUCERS; i++) {\n        pthread_create(&prods[i], NULL, producer, NULL);\n    }\n    for (int i = 0; i < NUM_CONSUMERS; i++) {\n        pthread_create(&cons[i], NULL, consumer, NULL);\n    }\n\n    for (int i = 0; i < NUM_PRODUCERS; i++) {\n        pthread_join(prods[i], NULL);\n    }\n    for "]
[118.273372, "o", "\u001b[?2004h> #include <stdint.h>\r\n\u001b[?2004l\r\u001b[?2004h> #include <pthread.h>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[118.273515, "i", "(int i = 0; i < NUM_CONSUMERS; i++) {\n        pthread_join(cons[i], NULL);\n    }\n\n    printf(\"FLAG: Ring Buffer TSAN Success!\\n\");\n    return 0;\n}\nEOF\n"]
