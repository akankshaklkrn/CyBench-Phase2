[456.483679, "i", "cat << 'EOF' > target.c\n#include <stdio.h>\n#include <stdlib.h>\n#include <assert.h>\n\ntypedef enum { RED, BLACK } color_t;\n\nstruct rb_node {\n    int data;\n    color_t color;\n    struct rb_node *left, *right, *parent;\n};\n\nstruct rb_node *root = NULL;\n\ncolor_t node_color(struct rb_node *n) {\n    return n == NULL ? BLACK : n->color;\n}\nstruct rb_node* get_left(struct rb_node *n) { return n ? n->left : NULL; }\nstruct rb_node* get_right(struct rb_node *n) { return n ? n->right : NULL; }\n\nvoid left_rotate(struct rb_node *x) {\n    struct rb_node *y = x->right;\n    x->right = y->left;\n    if (y->left != NULL) y->left->parent = x;\n    y->parent = x->parent;\n    if (x->parent == NULL) root = y;\n    else if (x == x->parent->left) x->parent->left = y;\n    else x->parent->right = y;\n    y->left = x;\n    x->parent = y;\n}\n\nvoid right_rotate(struct rb_node *x) {\n    struct rb_node *y = x->left;\n    x->left = y->right;\n    if (y->right != NULL) y->right->parent = x;\n    y->parent = x->parent;\n    if (x->parent == NULL) root = y;"]
[456.48374, "i", "\n    else if (x == x->parent->right) x->parent->right = y;\n    else x->parent->left = y;\n    y->right = x;\n    x->parent = y;\n}\n\nvoid rb_insert(int data) {\n    struct rb_node *z = (struct rb_node*)malloc(sizeof(struct rb_node));\n    z->data = data;\n    z->color = RED;\n    z->left = z->right = z->parent = NULL;\n\n    struct rb_node *y = NULL;\n    struct rb_node *x = root;\n    while (x != NULL) {\n        y = x;\n        if (z->data < x->data) x = x->left;\n        else if (z->data > x->data) x = x->right;\n        else {\n            free(z);\n            return;\n        }\n    }\n    z->parent = y;\n    if (y == NULL) root = z;\n    else if (z->data < y->data) y->left = z;\n    else y->right = z;\n\n    while (z->parent != NULL && z->parent->color == RED) {\n        if (z->parent == z->parent->parent->left) {\n            struct rb_node *uncle = z->parent->parent->right;\n            if (node_color(uncle) == RED) {\n                z->parent->color = BLACK;\n                uncle->color = BLACK;\n                z->parent->paren"]
