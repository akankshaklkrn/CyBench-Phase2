[101.656759, "o", "int oidc_verify_jwt(const oidc_engine_t *engine, const jwt_token_t *token, const char *expected_nonce) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.656858, "o", "    if (!engine || !engine->is_initialized || !token) return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h"]
[101.656957, "o", ">     if (token->alg == JWT_ALG_NONE) {\r\n\u001b[?2004l\r\u001b[?2004h>         return -4;\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.656973, "o", ">     }\r\n\u001b[?2004l\r"]
[101.657047, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.657323, "o", "    if (token->alg != JWT_ALG_HS256 && token->alg != JWT_ALG_RS256) {\r\n\u001b[?2004l\r\u001b[?2004h>         return -5;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n"]
