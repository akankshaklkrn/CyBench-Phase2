[216.007767, "o", "\u001b[?2004h>     engine->epc[slot].tcs_state = TCS_STATE_ENTERED;\r\n\u001b[?2004l\r\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r\u001b[?2004h"]
