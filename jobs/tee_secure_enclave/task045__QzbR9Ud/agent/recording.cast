[216.006542, "o", "int tee_enter_enclave(tee_engine_t *engine, uint32_t enclave_id, uint64_t tcs_vaddr) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.006679, "o", "    if (!engine) return -1;\r\n\u001b[?2004l\r"]
[216.006726, "o", "\u001b[?2004h> "]
[216.006808, "o", "    if (enclave_id < 1 || enclave_id > TEE_MAX_ENCLAVES) return -1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.006926, "o", "    if (!engine->enclaves[enclave_id - 1].is_initialized) return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[216.007006, "o", "\u001b[?2004h>     int slot = -1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.007065, "o", "    for (int i = 0; i < TEE_MAX_EPC_PAGES; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.007203, "o", "        if (engine->epc[i].is_valid && engine->epc[i].enclave_id == enclave_id && engine->epc[i].virtual_addr == tcs_vaddr) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.007299, "o", "            slot = i;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.007332, "o", "            break;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.007373, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.00744, "o", "    if (slot == -1) return -6;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.007545, "o", "    if (engine->epc[slot].type != EPC_PAGE_TCS) return -7;\r\n\u001b[?2004l\r\u001b[?2004h>     if (engine->epc[slot].is_blocked) return -8;\r\n\u001b[?2004l\r"]
[216.007562, "o", "\u001b[?2004h> "]
