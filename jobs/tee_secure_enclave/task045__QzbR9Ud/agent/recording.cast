[216.006057, "o", "    hash = (hash ^ (uint8_t)type) * 0x00000100000001B3ULL;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.006145, "o", "    for (int i = 0; i < TEE_PAGE_SIZE; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.006159, "o", "        hash = (hash ^ engine->epc[slot].data[i]) * 0x00000100000001B3ULL;\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.006165, "o", ">     }\r\n\u001b[?2004l\r"]
[216.006203, "o", "\u001b[?2004h> "]
[216.00631, "o", "    engine->enclaves[enclave_id - 1].mr_enclave = hash;\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     return slot;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[216.006337, "o", "\u001b[?2004h"]
