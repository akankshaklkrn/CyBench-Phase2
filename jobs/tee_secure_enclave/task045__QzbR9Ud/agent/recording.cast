[216.008822, "o", "    } else {\r\n\u001b[?2004l\r"]
[216.008923, "o", "\u001b[?2004h"]
[216.008942, "o", "> "]
[216.009076, "o", "        memset(out_quote->report_data, 0, 64);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.009149, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.009271, "o", "    uint64_t mac = engine->enclaves[enclave_id - 1].owner_key ^ out_quote->mr_enclave;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.00929, "o", "    for (int i = 0; i < 64; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.009494, "o", "        mac = (mac ^ out_quote->report_data[i]) * 0x00000100000001B3ULL;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     out_quote->mac_tag = mac;\r\n\u001b[?2004l\r\u001b[?2004h> "]
