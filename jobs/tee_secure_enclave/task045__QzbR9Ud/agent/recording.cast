[216.008052, "o", "int tee_generate_quote(tee_engine_t *engine, uint32_t enclave_id, const uint8_t *report_data, tee_quote_t *out_quote) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.008072, "o", "> "]
[216.008157, "o", "    if (!engine || !out_quote) return -1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.008299, "o", "    if (enclave_id < 1 || enclave_id > TEE_MAX_ENCLAVES) return -1;\r\n\u001b[?2004l\r\u001b[?2004h>     if (!engine->enclaves[enclave_id - 1].is_initialized) return -1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.008465, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.008574, "o", "    out_quote->enclave_id = enclave_id;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.008667, "o", "    out_quote->mr_enclave = engine->enclaves[enclave_id - 1].mr_enclave;\r\n\u001b[?2004l\r\u001b[?2004h>     if (report_data) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
