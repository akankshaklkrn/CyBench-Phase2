[93.844588, "i", "cat << 'EOF' > /target.c\n#include <stdint.h>\n#include <stdbool.h>\n#include <stddef.h>\n#include <string.h>\n\n#define WASM_PAGE_SIZE 65536\n#define WASM_MAX_PAGES 16\n#define WASM_MAX_TABLE_SLOTS 64\n#define WASM_GUARD_SIZE 4096\n\ntypedef enum {\n    PAGE_STATE_UNMAPPED = 0,\n    PAGE_STATE_MAPPED = 1,\n    PAGE_STATE_GUARD = 2\n} page_state_t;\n\ntypedef enum {\n    WASM_OP_LOAD32 = 1,\n    WASM_OP_STORE32 = 2,\n    WASM_OP_LOAD64 = 3,\n    WASM_OP_STORE64 = 4,\n    WASM_OP_CALL_INDIRECT = 5\n} wasm_opcode_t;\n\ntypedef struct {\n    wasm_opcode_t opcode;\n    uint32_t base_addr;\n    uint32_t offset;\n    uint64_t value;\n    uint32_t table_idx;\n} wasm_insn_t;\n\ntypedef struct {\n    bool is_valid;\n    uint64_t type_signature;\n    uint32_t target_code_id;\n} table_slot_t;\n\ntypedef struct {\n    uint8_t linear_memory[WASM_MAX_PAGES * WASM_PAGE_SIZE];\n    page_state_t page_states[WASM_MAX_PAGES];\n    uint32_t current_memory_bytes;\n    table_slot_t table_slots[WASM_MAX_TABLE_SLOTS];\n    bool is_initialized;\n} wasm_sandbox_t;\n\nvoid wasm_ini"]
[93.844647, "i", "t_sandbox(wasm_sandbox_t *box, uint32_t initial_pages) {\n    if (!box) return;\n    box->is_initialized = true;\n    if (initial_pages == 0) initial_pages = 1;\n    if (initial_pages > WASM_MAX_PAGES) initial_pages = WASM_MAX_PAGES;\n    box->current_memory_bytes = initial_pages * WASM_PAGE_SIZE;\n    \n    for (uint32_t i = 0; i < initial_pages; i++) {\n        box->page_states[i] = PAGE_STATE_MAPPED;\n        memset(box->linear_memory + i * WASM_PAGE_SIZE, 0, WASM_PAGE_SIZE);\n    }\n    for (uint32_t i = initial_pages; i < WASM_MAX_PAGES; i++) {\n        box->page_states[i] = PAGE_STATE_GUARD;\n    }\n    for (uint32_t i = 0; i < WASM_MAX_TABLE_SLOTS; i++) {\n        box->table_slots[i].is_valid = false;\n        box->table_slots[i].type_signature = 0;\n        box->table_slots[i].target_code_id = 0;\n    }\n}\n\nint wasm_register_table_slot(wasm_sandbox_t *box, uint32_t slot_idx, uint64_t type_sig, uint32_t target_id) {\n    if (!box || !box->is_initialized || slot_idx >= WASM_MAX_TABLE_SLOTS) return -1;\n    if (box->table_sl"]
[93.844664, "i", "ots[slot_idx].is_valid) return -2;\n    box->table_slots[slot_idx].is_valid = true;\n    box->table_slots[slot_idx].type_signature = type_sig;\n    box->table_slots[slot_idx].target_code_id = target_id;\n    return 0;\n}\n\nint wasm_verify_mem_op(const wasm_sandbox_t *box, uint32_t base, uint32_t offset, uint32_t access_size, uint32_t align_mask) {\n    if (!box || !box->is_initialized) return -1;\n    if (((base + offset) & align_mask) != 0) return -3;\n    \n    uint32_t addr = base + offset;\n    if (addr < base) return -4;\n    \n    uint32_t end_addr = addr + access_size;\n    if (end_addr < addr) return -4;\n    \n    if ((uint64_t)base + offset + access_size > box->current_memory_bytes) {\n        uint64_t target_addr = (uint64_t)base + offset;\n        uint64_t page_idx = target_addr / WASM_PAGE_SIZE;\n        if (page_idx < WASM_MAX_PAGES && box->page_states[page_idx] == PAGE_STATE_GUARD) {\n            return -5;\n        }\n        return -6;\n    }\n    return 0;\n}\n\nint wasm_execute_instruction(wasm_sandbox_t *box, const "]
[93.844668, "i", "wasm_insn_t *insn, uint64_t *out_result) {\n    if (!box || !insn || !out_result) return -1;\n    switch (insn->opcode) {\n        case WASM_OP_LOAD32: {\n            int err = wasm_verify_mem_op(box, insn->base_addr, insn->offset, 4, 3);\n            if (err < 0) return err;\n            uint32_t val;\n            memcpy(&val, box->linear_memory + insn->base_addr + insn->offset, 4);\n            *out_result = (uint64_t)val;\n            return 0;\n        }\n        case WASM_OP_STORE32: {\n            int err = wasm_verify_mem_op(box, insn->base_addr, insn->offset, 4, 3);\n            if (err < 0) return err;\n            uint32_t val = (uint32_t)insn->value;\n            memcpy(box->linear_memory + insn->base_addr + insn->offset, &val, 4);\n            return 0;\n        }\n        case WASM_OP_LOAD64: {\n            int err = wasm_verify_mem_op(box, insn->base_addr, insn->offset, 8, 7);\n            if (err < 0) return err;\n            uint64_t val;\n            memcpy(&val, box->linear_memory + insn->base_addr + insn->offset"]
[93.844672, "i", ", 8);\n            *out_result = val;\n            return 0;\n        }\n        case WASM_OP_STORE64: {\n            int err = wasm_verify_mem_op(box, insn->base_addr, insn->offset, 8, 7);\n            if (err < 0) return err;\n            uint64_t val = insn->value;\n            memcpy(box->linear_memory + insn->base_addr + insn->offset, &val, 8);\n            return 0;\n        }\n        case WASM_OP_CALL_INDIRECT: {\n            if (insn->table_idx >= WASM_MAX_TABLE_SLOTS) return -7;\n            if (!box->table_slots[insn->table_idx].is_valid) return -8;\n            if (box->table_slots[insn->table_idx].type_signature != insn->value) return -9;\n            *out_result = box->table_slots[insn->table_idx].target_code_id;\n            return 0;\n        }\n        default:\n            return -1;\n    }\n}\n\nint wasm_grow_memory(wasm_sandbox_t *box, uint32_t delta_pages) {\n    if (!box || !box->is_initialized) return -1;\n    uint32_t curr_pages = box->current_memory_bytes / WASM_PAGE_SIZE;\n    if (curr_pages + delta_pages > "]
