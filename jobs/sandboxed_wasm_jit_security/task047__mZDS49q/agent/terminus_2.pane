[?2004lt_sandbox(wasm_sandbox_t *box, uint32_t initial_pages) {
    if (!box) return;
    box->is_initialized = true;
    if (initial_pages == 0) initial_pages = 1;
    if (initial_pages > WASM_MAX_PAGES) initial_pages = WASM_MAX_PAGES;
    box->current_memory_bytes = initial_pages * WASM_PAGE_SIZE;
    
    for (uint32_t i = 0; i < initial_pages; i++) {
        box->page_states[i] = PAGE_STATE_MAPPED;
        memset(box->linear_memory + i * WASM_PAGE_SIZE, 0, WASM_PAGE_SIZE);
    }
    for (uint32_t i = initial_pages; i < WASM_MAX_PAGES; i++) {
        box->page_states[i] = PAGE_STATE_GUARD;
    }
    for (uint32_t i = 0; i < WASM_MAX_TABLE_SLOTS; i++) {
        box->table_slots[i].is_valid = false;
        box->table_slots[i].type_signature = 0;
        box->table_slots[i].target_code_id = 0;
    }
}

int wasm_register_table_slot(wasm_sandbox_t *box, uint32_t slot_idx, uint64_t type_sig, uint32_t target_id) {
    if (!box || !box->is_initialized || slot_idx >= WASM_MAX_TABLE_SLOTS) return -1;
    if (box->table_slots[slot_idx].is_valid) return -2;
    box->table_slots[slot_idx].is_valid = true;
    box->table_slots[slot_idx].type_signature = type_sig;
    box->table_slots[slot_idx].target_code_id = target_id;
    return 0;
}

int wasm_verify_mem_op(const wasm_sandbox_t *box, uint32_t base, uint32_t offset, uint32_t access_size, uint32_t align_mask) {
    if (!box || !box->is_initialized) return -1;
    if (((base + offset) & align_mask) != 0) return -3;
    
    uint32_t addr = base + offset;
    if (addr < base) return -4;
    
    uint32_t end_addr = addr + access_size;
    if (end_addr < addr) return -4;
    
    if ((uint64_t)base + offset + access_size > box->current_memory_bytes) {
        uint64_t target_addr = (uint64_t)base + offset;
        uint64_t page_idx = target_addr / WASM_PAGE_SIZE;
        if (page_idx < WASM_MAX_PAGES && box->page_states[page_idx] == PAGE_STATE_GUARD) {
            return -5;
        }
        return -6;
    }
    return 0;
}

int wasm_execute_instruction(wasm_sandbox_t *box, const wasm_insn_t *insn, uint64_t *out_result) {
    if (!box || !insn || !out_result) return -1;
