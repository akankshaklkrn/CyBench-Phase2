[244.223567, "o", "        curr->prev->size += sizeof(chunk_t) + curr->size;\r\n\u001b[?2004l\r\u001b[?2004h>         curr->prev->next = curr->next;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.223587, "o", "        if (curr->next) {\r\n\u001b[?2004l\r"]
[244.223655, "o", "\u001b[?2004h> "]
