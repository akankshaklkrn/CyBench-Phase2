[244.224844, "o", "    for (int i = 1; i < 100; i += 2) {\r\n\u001b[?2004l\r\u001b[?2004h>         custom_free(ptrs[i]);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
