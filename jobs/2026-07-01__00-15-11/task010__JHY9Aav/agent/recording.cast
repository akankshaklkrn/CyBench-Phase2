[244.222789, "o", "    chunk_t* curr = (chunk_t*)((unsigned char*)ptr - sizeof(chunk_t));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.222819, "o", "    curr->is_free = true;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[244.222874, "o", "    \r\n\u001b[?2004l\r"]
