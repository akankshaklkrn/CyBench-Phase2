[148.890728, "i", "cat << 'EOF' > /target.c\n#include <stddef.h>\n#include <stdio.h>\n#include <stdint.h>\n#include <stdbool.h>\n\nunsigned char custom_heap[65536];\n\ntypedef struct chunk_t {\n    size_t size;\n    bool is_free;\n    struct chunk_t* next;\n    struct chunk_t* prev;\n} chunk_t;\n\nstatic chunk_t* head = NULL;\n\nvoid init_heap() {\n    if (head == NULL) {\n        head = (chunk_t*)custom_heap;\n        head->size = 65536 - sizeof(chunk_t);\n        head->is_free = true;\n        head->next = NULL;\n        head->prev = NULL;\n    }\n}\n\nvoid* custom_malloc(size_t size) {\n    if (size == 0) return NULL;\n    init_heap();\n    \n    // align size to 8 bytes\n    size = (size + 7) & ~7;\n    \n    chunk_t* curr = head;\n    while (curr != NULL) {\n        if (curr->is_free && curr->size >= size) {\n            // Split if large enough\n            if (curr->size >= size + sizeof(chunk_t) + 8) {\n                chunk_t* new_chunk = (chunk_t*)((unsigned char*)curr + sizeof(chunk_t) + size);\n                new_chunk->size = curr->size - size - sizeof("]
[148.890792, "i", "chunk_t);\n                new_chunk->is_free = true;\n                new_chunk->next = curr->next;\n                new_chunk->prev = curr;\n                \n                if (new_chunk->next) {\n                    new_chunk->next->prev = new_chunk;\n                }\n                \n                curr->next = new_chunk;\n                curr->size = size;\n            }\n            curr->is_free = false;\n            return (void*)((unsigned char*)curr + sizeof(chunk_t));\n        }\n        curr = curr->next;\n    }\n    return NULL;\n}\n\nvoid custom_free(void* ptr) {\n    if (!ptr) return;\n    chunk_t* curr = (chunk_t*)((unsigned char*)ptr - sizeof(chunk_t));\n    curr->is_free = true;\n    \n    // Coalesce with next\n    if (curr->next && curr->next->is_free) {\n        curr->size += sizeof(chunk_t) + curr->next->size;\n        curr->next = curr->next->next;\n        if (curr->next) {\n            curr->next->prev = curr;\n        }\n    }\n    \n    // Coalesce with prev\n    if (curr->prev && curr->prev->is_free) {\n       "]
[148.890801, "i", " curr->prev->size += sizeof(chunk_t) + curr->size;\n        curr->prev->next = curr->next;\n        if (curr->next) {\n            curr->next->prev = curr->prev;\n        }\n    }\n}\n\n// We provide a main function just to compile and test.\n#ifndef NO_MAIN\nint main() {\n    printf(\"FLAG: Custom Allocator Success!\\n\");\n    return 0;\n}\n#endif\nEOF\n"]
