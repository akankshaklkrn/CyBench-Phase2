void splay_insert(int key) {
    if (!root) {
        splay_node* n = (splay_node*)malloc(sizeof(splay_node));
        n->key = key;
        n->left = n->right = n->parent = NULL;
        root = n;
        return;
    }
    splay(key);
    if (root->key == key) return;
    splay_node* n = (splay_node*)malloc(sizeof(splay_node));
    n->key = key;
    n->parent = NULL;
    if (key < root->key) {
        n->right = root;
        n->left = root->left;
        if (n->left) n->left->parent = n;
        root->left = NULL;
        root->parent = n;
    } else {
        n->left = root;
        n->right = root->right;
        if (n->right) n->right->parent = n;
        root->right = NULL;
        root->parent = n;
    }
    root = n;
}

void splay_delete(int key) {
    if (!root) return;
    splay(key);
    if (root->key != key) return;
    splay_node *del = root;
    if (!root->left) {
        root = root->right;
        if (root) root->parent = NULL;
    } else {
        splay_node *left_tree = root->left;
        splay_node *right_tree = root->right;
        left_tree->parent = NULL;
        root = left_tree;
        splay_node *m = left_tree;
        while (m->right) m = m->right;
        splay_node_ptr(m);
        root->right = right_tree;
        if (right_tree) right_tree->parent = root;
    }
    free(del);
}

bool is_bst(splay_node* n, splay_node** prev) {
    if (!n) return true;
    if (!is_bst(n->left, prev)) return false;
    if (*prev && (*prev)->key >= n->key) return false;
    *prev = n;
    return is_bst(n->right, prev);
}

void check_invariants() {
    splay_node *prev = NULL;
    assert(is_bst(root, &prev));
}

