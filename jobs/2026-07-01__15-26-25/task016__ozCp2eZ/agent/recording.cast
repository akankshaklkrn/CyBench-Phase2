[138.784062, "o", "    if (root->key == key) return;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.784141, "o", "    splay_node* n = (splay_node*)malloc(sizeof(splay_node));\r\n\u001b[?2004l\r\u001b[?2004h>     n->key = key;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.784246, "o", "    n->parent = NULL;\r\n\u001b[?2004l\r\u001b[?2004h>     if (key < root->key) {\r\n\u001b[?2004l\r"]
[138.7843, "o", "\u001b[?2004h>         n->right = root;\r\n\u001b[?2004l\r\u001b[?2004h"]
[138.784311, "o", "> "]
[138.784405, "o", "        n->left = root->left;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.784426, "o", "        if (n->left) n->left->parent = n;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.784633, "o", "        root->left = NULL;\r\n\u001b[?2004l\r\u001b[?2004h>         root->parent = n;\r\n\u001b[?2004l\r\u001b[?2004h>     } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.784733, "o", "        n->left = root;\r\n\u001b[?2004l\r\u001b[?2004h>         n->right = root->right;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.784894, "o", "        if (n->right) n->right->parent = n;\r\n\u001b[?2004l\r\u001b[?2004h>         root->right = NULL;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.785058, "o", "        root->parent = n;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[138.785084, "o", "> "]
[138.785172, "o", "    root = n;\r\n\u001b[?2004l\r"]
[138.785234, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[138.785255, "o", "\u001b[?2004h> void splay_delete(int key) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.785341, "o", "    if (!root) return;\r\n\u001b[?2004l\r\u001b[?2004h>     splay(key);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.78557, "o", "    if (root->key != key) return;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.785635, "o", "    splay_node *del = root;\r\n\u001b[?2004l\r\u001b[?2004h>     if (!root->left) {\r\n"]
[138.785737, "o", "\u001b[?2004l\r\u001b[?2004h>         root = root->right;"]
[138.785742, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[138.786196, "o", ">         if (root) root->parent = NULL;\r\n\u001b[?2004l\r\u001b[?2004h>     } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.786303, "o", "        splay_node *left_tree = root->left;\r\n\u001b[?2004l\r\u001b[?2004h>         splay_node *right_tree = root->right;\r\n\u001b[?2004l\r"]
[138.786374, "o", "\u001b[?2004h>         left_tree->parent = NULL;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.786466, "o", "        root = left_tree;\r\n\u001b[?2004l\r\u001b[?2004h>         splay_node *m = left_tree;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.786587, "o", "        while (m->right) m = m->right;\r\n\u001b[?2004l\r\u001b[?2004h>         splay_node_ptr(m);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.786648, "o", "        root->right = right_tree;\r\n\u001b[?2004l\r"]
[138.786709, "o", "\u001b[?2004h> "]
[138.78679, "o", "        if (right_tree) right_tree->parent = root;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.786863, "o", "    free(del);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[138.786886, "o", "> "]
[138.786965, "o", "bool is_bst(splay_node* n, splay_node** prev) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.787011, "o", "    if (!n) return true;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.787083, "o", "    if (!is_bst(n->left, prev)) return false;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.787102, "o", "    if (*prev && (*prev)->key >= n->key) return false;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.787169, "o", "    *prev = n;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.787254, "o", "    return is_bst(n->right, prev);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.787272, "o", "void check_invariants() {\r\n\u001b[?2004l\r\u001b[?2004h"]
[138.787324, "o", ">     splay_node *prev = NULL;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.787401, "o", "    assert(is_bst(root, &prev));\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[138.787422, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> int main() {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.787525, "o", "    for (int i = 0; i < 10000; i++) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.787658, "o", "        int op = rand() % 3;\r\n\u001b[?2004l\r\u001b[?2004h>         int k = rand() % 1000;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.787735, "o", "        if (op == 0) {\r\n\u001b[?2004l\r\u001b[?2004h>             splay_insert(k);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.787841, "o", "            assert(root->key == k);\r\n\u001b[?2004l\r\u001b[?2004h>         } else if (op == 1) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.787898, "o", "            splay(k);\r\n\u001b[?2004l\r\u001b[?2004h>         } else {\r\n\u001b[?2004l\r"]
[138.788017, "o", "\u001b[?2004h>             splay_delete(k);\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.788087, "o", "        check_invariants();\r\n\u001b[?2004l\r\u001b[?2004h"]
[138.788171, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[138.788318, "o", "    printf(\"FLAG: Splay Tree Success!\\n\");\r\n\u001b[?2004l\r\u001b[?2004h>     return 0;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
