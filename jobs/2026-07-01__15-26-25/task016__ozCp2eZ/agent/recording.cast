[138.777289, "i", "cat << 'EOF' > target.c\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <assert.h>\n\ntypedef struct splay_node {\n    int key;\n    struct splay_node *left;\n    struct splay_node *right;\n    struct splay_node *parent;\n} splay_node;\n\nsplay_node *root = NULL;\n\nvoid left_rotate(splay_node *x) {\n    splay_node *y = x->right;\n    if (y) {\n        x->right = y->left;\n        if (y->left) y->left->parent = x;\n        y->parent = x->parent;\n    }\n    if (!x->parent) root = y;\n    else if (x == x->parent->left) x->parent->left = y;\n    else x->parent->right = y;\n    if (y) y->left = x;\n    x->parent = y;\n}\n\nvoid right_rotate(splay_node *x) {\n    splay_node *y = x->left;\n    if (y) {\n        x->left = y->right;\n        if (y->right) y->right->parent = x;\n        y->parent = x->parent;\n    }\n    if (!x->parent) root = y;\n    else if (x == x->parent->left) x->parent->left = y;\n    else x->parent->right = y;\n    if (y) y->right = x;\n    x->parent = y;\n}\n\nvoid splay_node_ptr(splay_node *n) {\n    while (n-"]
[138.777362, "i", ">parent) {\n        if (!n->parent->parent) {\n            if (n->parent->left == n) right_rotate(n->parent);\n            else left_rotate(n->parent);\n        } else if (n->parent->left == n && n->parent->parent->left == n->parent) {\n            right_rotate(n->parent->parent);\n            right_rotate(n->parent);\n        } else if (n->parent->right == n && n->parent->parent->right == n->parent) {\n            left_rotate(n->parent->parent);\n            left_rotate(n->parent);\n        } else if (n->parent->left == n && n->parent->parent->right == n->parent) {\n            right_rotate(n->parent);\n            left_rotate(n->parent);\n        } else {\n            left_rotate(n->parent);\n            right_rotate(n->parent);\n        }\n    }\n}\n\nvoid splay(int key) {\n    if (!root) return;\n    splay_node *curr = root;\n    splay_node *last = NULL;\n    while (curr) {\n        last = curr;\n        if (curr->key == key) {\n            splay_node_ptr(curr);\n            return;\n        } else if (key < curr->key) {\n            "]
[138.777371, "i", "curr = curr->left;\n        } else {\n            curr = curr->right;\n        }\n    }\n    if (last) {\n        splay_node_ptr(last);\n    }\n}\n\nvoid splay_insert(int key) {\n    if (!root) {\n        splay_node* n = (splay_node*)malloc(sizeof(splay_node));\n        n->key = key;\n        n->left = n->right = n->parent = NULL;\n        root = n;\n        return;\n    }\n    splay(key);\n    if (root->key == key) return;\n    splay_node* n = (splay_node*)malloc(sizeof(splay_node));\n    n->key = key;\n    n->parent = NULL;\n    if (key < root->key) {\n        n->right = root;\n        n->left = root->left;\n        if (n->left) n->left->parent = n;\n        root->left = NULL;\n        root->parent = n;\n    } else {\n        n->left = root;\n        n->right = root->right;\n        if (n->right) n->right->parent = n;\n        root->right = NULL;\n        root->parent = n;\n    }\n    root = n;\n}\n\nvoid splay_delete(int key) {\n    if (!root) return;\n    splay(key);\n    if (root->key != key) return;\n    splay_node *del = root;\n    if (!root->le"]
[138.777375, "i", "ft) {\n        root = root->right;\n        if (root) root->parent = NULL;\n    } else {\n        splay_node *left_tree = root->left;\n        splay_node *right_tree = root->right;\n        left_tree->parent = NULL;\n        root = left_tree;\n        splay_node *m = left_tree;\n        while (m->right) m = m->right;\n        splay_node_ptr(m);\n        root->right = right_tree;\n        if (right_tree) right_tree->parent = root;\n    }\n    free(del);\n}\n\nbool is_bst(splay_node* n, splay_node** prev) {\n    if (!n) return true;\n    if (!is_bst(n->left, prev)) return false;\n    if (*prev && (*prev)->key >= n->key) return false;\n    *prev = n;\n    return is_bst(n->right, prev);\n}\n\nvoid check_invariants() {\n    splay_node *prev = NULL;\n    assert(is_bst(root, &prev));\n}\n\nint main() {\n    for (int i = 0; i < 10000; i++) {\n        int op = rand() % 3;\n        int k = rand() % 1000;\n        if (op == 0) {\n            splay_insert(k);\n            assert(root->key == k);\n        } else if (op == 1) {\n            splay(k);\n        }"]
[138.777381, "i", " else {\n            splay_delete(k);\n        }\n        check_invariants();\n    }\n    printf(\"FLAG: Splay Tree Success!\\n\");\n    return 0;\n}\nEOF\n"]
