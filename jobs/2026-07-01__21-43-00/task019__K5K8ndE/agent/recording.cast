[166.681718, "o", "            expected = c;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.681828, "o", "    return true;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.681905, "o", "bool skiplist_search(skiplist_t *sl, int key) {"]
[166.682031, "o", "\r\n\u001b[?2004l\r"]
[166.682109, "o", "\u001b[?2004h>     skiplist_node *pred = sl->head;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.68219, "o", "    for (int level = MAX_LEVEL - 1; level >= 0; level--) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.682309, "o", "        skiplist_node *curr = atomic_load(&pred->next[level]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.682414, "o", "        while (curr != NULL && curr->key < key) {\r\n\u001b[?2004l\r\u001b[?2004h>             pred = curr;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.682454, "o", "            curr = atomic_load(&pred->next[level]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.682647, "o", "        }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.682671, "o", "        if (curr != NULL && curr->key == key) {\r\n\u001b[?2004l\r\u001b[?2004h>             return true;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.682735, "o", "    return false;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.682749, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.682876, "o", "int random_level(void) {\r\n\u001b[?2004l\r\u001b[?2004h>     int level = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.682969, "o", "    while (rand() % 2 == 0 && level < MAX_LEVEL - 1) {\r\n\u001b[?2004l\r\u001b[?2004h>         level++;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.683017, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.683115, "o", "    return level;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> skiplist_t *sl;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[166.683137, "o", "> "]
