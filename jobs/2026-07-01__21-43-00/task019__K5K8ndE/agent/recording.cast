[166.67585, "i", "cat << 'EOF' > target.c\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <stdatomic.h>\n#include <pthread.h>\n\n#define MAX_LEVEL 8\n#define NUM_ITEMS 100000\n#define NUM_THREADS 16\n\ntypedef struct skiplist_node {\n    int key;\n    int top_level;\n    _Atomic(struct skiplist_node *) next[MAX_LEVEL];\n} skiplist_node;\n\ntypedef struct {\n    skiplist_node *head;\n} skiplist_t;\n\nbool skiplist_insert(skiplist_t *sl, int key, int top_level) {\n    skiplist_node *new_node = malloc(sizeof(skiplist_node));\n    if (!new_node) return false;\n    new_node->key = key;\n    new_node->top_level = top_level;\n    for(int i = 0; i <= top_level; i++) {\n        atomic_init(&new_node->next[i], NULL);\n    }\n    \n    skiplist_node *preds[MAX_LEVEL];\n    skiplist_node *succs[MAX_LEVEL];\n\nretry:\n    ;\n    skiplist_node *pred = sl->head;\n    for (int level = MAX_LEVEL - 1; level >= 0; level--) {\n        skiplist_node *curr = atomic_load(&pred->next[level]);\n        while (curr != NULL && curr->key < key) {\n            pred = c"]
[166.675942, "i", "urr;\n            curr = atomic_load(&pred->next[level]);\n        }\n        if (curr != NULL && curr->key == key) {\n            free(new_node);\n            return false;\n        }\n        preds[level] = pred;\n        succs[level] = curr;\n    }\n    \n    skiplist_node *expected = succs[0];\n    while (true) {\n        atomic_store(&new_node->next[0], expected);\n        if (atomic_compare_exchange_weak(&preds[0]->next[0], &expected, new_node)) {\n            break;\n        }\n        if (expected == succs[0]) {\n            continue;\n        }\n        goto retry;\n    }\n    \n    for (int level = 1; level <= top_level; level++) {\n        expected = succs[level];\n        while (true) {\n            atomic_store(&new_node->next[level], expected);\n            if (atomic_compare_exchange_weak(&preds[level]->next[level], &expected, new_node)) {\n                break;\n            }\n            if (expected == succs[level]) {\n                continue;\n            }\n            skiplist_node *p = sl->head;\n            skiplist_n"]
[166.67616, "i", "ode *c;\n            for (int l = MAX_LEVEL - 1; l >= level; l--) {\n                c = atomic_load(&p->next[l]);\n                while (c != NULL && c->key < key) {\n                    p = c;\n                    c = atomic_load(&p->next[l]);\n                }\n            }\n            preds[level] = p;\n            succs[level] = c;\n            expected = c;\n        }\n    }\n    return true;\n}\n\nbool skiplist_search(skiplist_t *sl, int key) {\n    skiplist_node *pred = sl->head;\n    for (int level = MAX_LEVEL - 1; level >= 0; level--) {\n        skiplist_node *curr = atomic_load(&pred->next[level]);\n        while (curr != NULL && curr->key < key) {\n            pred = curr;\n            curr = atomic_load(&pred->next[level]);\n        }\n        if (curr != NULL && curr->key == key) {\n            return true;\n        }\n    }\n    return false;\n}\n\nint random_level(void) {\n    int level = 0;\n    while (rand() % 2 == 0 && level < MAX_LEVEL - 1) {\n        level++;\n    }\n    return level;\n}\n\nskiplist_t *sl;\n\nvoid* thread_fu"]
