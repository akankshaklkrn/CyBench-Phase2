[166.676297, "i", "nc(void* arg) {\n    int id = *(int*)arg;\n    int items = NUM_ITEMS / NUM_THREADS;\n    int start = id * items;\n    for (int i = start; i < start + items; i++) {\n        skiplist_insert(sl, i, random_level());\n    }\n    for (int i = start; i < start + items; i++) {\n        if (!skiplist_search(sl, i)) {\n            printf(\"Error: Key %d not found!\\n\", i);\n            exit(1);\n        }\n    }\n    return NULL;\n}\n\nint main(void) {\n    sl = malloc(sizeof(skiplist_t));\n    sl->head = malloc(sizeof(skiplist_node));\n    sl->head->key = -1;\n    sl->head->top_level = MAX_LEVEL - 1;\n    for(int i=0; i<MAX_LEVEL; i++) {\n        atomic_init(&sl->head->next[i], NULL);\n    }\n\n    pthread_t threads[NUM_THREADS];\n    int thread_ids[NUM_THREADS];\n    \n    for (int i = 0; i < NUM_THREADS; i++) {\n        thread_ids[i] = i;\n        pthread_create(&threads[i], NULL, thread_func, &thread_ids[i]);\n    }\n    for (int i = 0; i < NUM_THREADS; i++) {\n        pthread_join(threads[i], NULL);\n    }\n    \n    int count = 0;\n    skiplist_node "]
