[166.683214, "o", "    int id = *(int*)arg;\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.683304, "o", ">     int items = NUM_ITEMS / NUM_THREADS;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.683395, "o", "    int start = id * items;\r\n\u001b[?2004l\r\u001b[?2004h>     for (int i = start; i < start + items; i++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
