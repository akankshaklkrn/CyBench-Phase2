[166.684632, "o", "    sl->head->top_level = MAX_LEVEL - 1;\r\n\u001b[?2004l\r\u001b[?2004h>     for(int i=0; i<MAX_LEVEL; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>         atomic_init(&sl->head->next[i], NULL);\r\n\u001b[?2004l\r\u001b[?2004h> "]
