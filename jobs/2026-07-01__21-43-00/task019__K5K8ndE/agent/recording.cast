[166.683864, "o", "        if (!skiplist_search(sl, i)) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.683995, "o", "            printf(\"Error: Key %d not found!\\n\", i);\r\n\u001b[?2004l\r\u001b[?2004h>             exit(1);\r\n\u001b[?2004l\r\u001b[?2004h"]
[166.68406, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[166.684126, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     return NULL;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[166.684152, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
