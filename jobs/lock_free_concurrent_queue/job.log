Sending keys: ['cat << \'EOF\' > target.c\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdatomic.h>\n#include <pthread.h>\n\ntypedef struct Node {\n    int value;\n    _Atomic(struct Node*) next;\n} Node;\n\ntypedef struct Queue {\n    _Atomic(Node*) head;\n    _Atomic(Node*) tail;\n} Queue;\n\nQueue q;\n\nvoid init_queue(Queue* queue) {\n    Node* dummy = malloc(sizeof(Node));\n    dummy->value = 0;\n    atomic_init(&dummy->next, NULL);\n    atomic_init(&queue->head, dummy);\n    atomic_init(&queue->tail, dummy);\n}\n\nvoid enqueue(Queue* queue, int value) {\n    Node* node = malloc(sizeof(Node));\n    if (!node) exit(1);\n    node->value = value;\n    atomic_init(&node->next, NULL);\n    while (1) {\n        Node* tail = atomic_load(&queue->tail);\n        Node* next = atomic_load(&tail->next);\n        if (tail == atomic_load(&queue->tail)) {\n            if (next == NULL) {\n                if (atomic_compare_exchange_weak(&tail->next, &next, node)) {\n                    atomic_compare_exchange_weak(&queue->tail, &tail, node);\n                    break;\n                }\n            } else {\n                atomic_compare_exchange_weak(&queue->tail, &tail, next);\n            }\n        }\n    }\n}\n\nint dequeue(Queue* queue, int* value) {\n    while (1) {\n        Node* head = atomic_load(&queue->head);\n        Node* tail = atomic_load(&queue->tail);\n        Node* next = atomic_load(&head->next);\n        if (head == atomic_load(&queue->head)) {\n            if (head == tail) {\n                if (next == NULL) {\n                    return 0; /* Empty */\n                }\n                atomic_compare_exchange_weak(&queue->tail, &tail, next);\n            } else {\n                if (next == NULL) continue;\n                *value = next->value;\n                if (atomic_compare_exchange_weak(&queue->head, &head, next)) {\n                    break;\n                }\n            }\n        }\n    }\n    return 1;\n}\n\nvoid* worker(void* arg) {\n    (void)arg;\n    for (int i = 0; i < 10000; i++) {\n        enqueue(&q, i);\n    }\n    int val;\n    for (int i = 0; i < 10000; i++) {\n        while (!dequeue(&q, &val)) {}\n    }\n    return NULL;\n}\n\nint main(void) {\n    init_queue(&q);\n    pthread_t threads[16];\n    for (int i = 0; i < 16; i++) {\n        if (pthread_create(&threads[i], NULL, worker, NULL) != 0) {\n            perror("Failed to create thread");\n            exit(1);\n        }\n    }\n    for (int i = 0; i < 16; i++) {\n        pthread_join(threads[i], NULL);\n    }\n    \n    printf("FLAG: Queue Success!\\n");\n    return 0;\n}\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
