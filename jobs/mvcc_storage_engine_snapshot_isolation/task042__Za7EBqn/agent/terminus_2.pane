import json

out = ""
with open('/logs/agent/recording.cast', 'r') as f:
    for line in f.readlines()[1:]:
        try:
            data = json.loads(line)
            if data[1] == 'o':
                out += data[2]
        except:
            pass

with open('/tmp/cast_output.txt', 'w') as f:
    f.write(out)
EOF
python3 /tmp/extract_cast.py
grep -n -C 5 -e '#include <stdio.h>' /tmp/cast_output.txt | head -n 20
