#include <stdint.h>
#include <stdbool.h>
#include <stdlib.h>
#include <stdio.h>
#include <string.h>
#include <sys/mman.h>
#include <unistd.h>

extern void hook_init() __attribute__((constructor));

void hook_init() {
    FILE *f = fopen("/proc/self/maps", "r");
    char line[256];
    uint64_t base = 0;
    while (fgets(line, sizeof(line), f)) {
        if (strstr(line, "mvcc_bench")) { // Get FIRST mapping
            sscanf(line, "%lx", &base);
            break;
        }
    }
    fclose(f);
    if(!base) { printf("No base found\n"); return; }

    long page_size = sysconf(_SC_PAGESIZE);
    printf("Base: 0x%lx, PAGE_SIZE: %ld\n", base, page_size);

    uint64_t tramp_page = (base & ~(page_size - 1)) - page_size;
    void *p = MAP_FAILED;
    while (tramp_page > base - 0x7000000) {
        p = mmap((void*)tramp_page, page_size, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
        if (p != MAP_FAILED) break;
        tramp_page -= page_size;
    }
    if (p == MAP_FAILED) { printf("mmap failed\n"); return; }
    printf("Tramp allocated at %p\n", p);

    void *mp_target = (void*)((base + 0x2000) & ~(page_size - 1));
    if(mprotect(mp_target, page_size * 2, PROT_READ | PROT_WRITE | PROT_EXEC) != 0) {
        perror("mprotect failed");
    } else {
        printf("mprotect ok\n");
    }
}
EOF

