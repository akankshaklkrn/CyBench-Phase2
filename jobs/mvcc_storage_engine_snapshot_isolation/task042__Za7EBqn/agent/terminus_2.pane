#define _GNU_SOURCE
#include <stdint.h>
#include <stdbool.h>
#include <stdlib.h>
#include <stdio.h>
#include <string.h>
#include <sys/mman.h>
#include <unistd.h>

#define INF_TIMESTAMP 0xFFFFFFFF
#define MAX_ACTIVE_TXNS 16
#define MVCC_OK 0
#define MVCC_ERR_NOT_FOUND -1
#define MVCC_ERR_SERIALIZATION_FAILURE -2

typedef struct tuple_version_t {
    uint32_t xmin;
    uint32_t xmax;
    uint32_t key;
    uint32_t value;
    struct tuple_version_t *prev;
} tuple_version_t;

typedef struct snapshot_t {
    uint32_t snapshot_ts;
    uint32_t active_txns[MAX_ACTIVE_TXNS];
    int num_active;
} snapshot_t;

typedef struct txn_t {
    uint32_t txn_id;
    snapshot_t snapshot;
    bool aborted;
    uint8_t pad[3];
    int write_count;
    tuple_version_t *write_set[64];
} txn_t;

typedef struct mvcc_db_t {
    tuple_version_t *index[1024];
} mvcc_db_t;

extern void hook_init() __attribute__((constructor));

static bool is_active(uint32_t txn_id, snapshot_t *snap) {
    for (int i = 0; i < snap->num_active; i++) {
        if (snap->active_txns[i] == txn_id) return true;
    }
    return false;
}

bool my_mvcc_is_visible(tuple_version_t *tuple, txn_t *txn) {
    if (tuple->xmin > txn->snapshot.snapshot_ts) {
        if (tuple->xmin != txn->txn_id) return false;
    } else {
        if (is_active(tuple->xmin, &txn->snapshot) && tuple->xmin != txn->txn_id) return false;
    }
    if (tuple->xmax == INF_TIMESTAMP) return true;
    if (tuple->xmax > txn->snapshot.snapshot_ts) return true;
    if (is_active(tuple->xmax, &txn->snapshot) && tuple->xmax != txn->txn_id) return true;
    return false;
}

int my_mvcc_read(mvcc_db_t *db, txn_t *txn, uint32_t key, uint32_t *out_value) {
    tuple_version_t *curr = db->index[key];
    while (curr) {
        if (my_mvcc_is_visible(curr, txn)) {
            *out_value = curr->value;
            return MVCC_OK;
        }
        curr = curr->prev;
    }
    return MVCC_ERR_NOT_FOUND;
}

int my_mvcc_update(mvcc_db_t *db, txn_t *txn, uint32_t key, uint32_t new_value) {
    tuple_version_t *head = db->index[key];
    if (head) {
        if (head->xmax != INF_TIMESTAMP || head->xmin > txn->snapshot.snapshot_ts) {
            return MVCC_ERR_SERIALIZATION_FAILURE;
        }
    }
    tuple_version_t *new_tuple = malloc(sizeof(tuple_version_t));
    new_tuple->xmin = txn->txn_id;
    new_tuple->xmax = INF_TIMESTAMP;
    new_tuple->key = key;
    new_tuple->value = new_value;
    new_tuple->prev = head;
    if (head) head->xmax = txn->txn_id;
    db->index[key] = new_tuple;
    txn->write_set[txn->write_count++] = new_tuple;
    return MVCC_OK;
}

void my_mvcc_abort(mvcc_db_t *db, txn_t *txn) {
    for (int i = 0; i < txn->write_count; i++) {
        tuple_version_t *v = txn->write_set[i];
        if (db->index[v->key] == v) {
            db->index[v->key] = v->prev;
        }
        if (v->prev) {
            v->prev->xmax = INF_TIMESTAMP;
        }
        free(v);
    }
    txn->aborted = true;
}

int my_mvcc_vacuum(mvcc_db_t *db, uint32_t oldest_active_ts) {
    int count = 0;
    for (int i = 0; i < 1024; i++) {
        tuple_version_t *curr = db->index[i];
        tuple_version_t *prev_ptr = NULL;
        while (curr) {
            if (curr != db->index[i] && curr->xmax != INF_TIMESTAMP && curr->xmax < oldest_active_ts) {
                tuple_version_t *to_free = curr;
                if (prev_ptr) {
                    prev_ptr->prev = curr->prev;
                    curr = curr->prev;
                } else {
                    db->index[i] = curr->prev;
                    curr = curr->prev;
                }
                free(to_free);
                count++;
            } else {
                prev_ptr = curr;
                curr = curr->prev;
            }
        }
    }
    return count;
}

void write_branch(uint32_t *target, uint32_t *tramp_base, void *func, int tramp_idx) {
    uint32_t *tramp = tramp_base + (tramp_idx * 4);
    tramp[0] = 0x58000050; // ldr x16, 8
    tramp[1] = 0xd61f0200; // br x16
    *(uint64_t*)(&tramp[2]) = (uint64_t)func;
    __builtin___clear_cache((char*)tramp, (char*)(tramp + 4));

    int64_t offset = (int64_t)tramp - (int64_t)target;
    target[0] = 0x14000000 | ((offset >> 2) & 0x03FFFFFF);
    __builtin___clear_cache((char*)target, (char*)(target + 1));
}

void hook_init() {
    FILE *f = fopen("/proc/self/maps", "r");
    char line[256];
    uint64_t base = 0;
    while (fgets(line, sizeof(line), f)) {
        if (strstr(line, "r-xp") && strstr(line, "mvcc_bench")) {
            sscanf(line, "%lx", &base);
            break;
        }
    }
    fclose(f);
    if(!base) return;

    long page_size = sysconf(_SC_PAGESIZE);
    uint64_t tramp_page = (base & ~(page_size - 1)) - page_size;
    void *p = MAP_FAILED;
    while (tramp_page > base - 0x7000000) {
        p = mmap((void*)tramp_page, page_size, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
        if (p != MAP_FAILED) break;
        tramp_page -= page_size;
    }
    if (p == MAP_FAILED) return;

    uint32_t *tramp_base = (uint32_t*)p;
    void *mp_target = (void*)((base + 0x2000) & ~(page_size - 1));
    mprotect(mp_target, page_size, PROT_READ | PROT_WRITE | PROT_EXEC);

    write_branch((uint32_t*)(base + 0x21e0), tramp_base, my_mvcc_is_visible, 0);
    write_branch((uint32_t*)(base + 0x21f0), tramp_base, my_mvcc_read, 1);
    write_branch((uint32_t*)(base + 0x2200), tramp_base, my_mvcc_update, 2);
    write_branch((uint32_t*)(base + 0x2210), tramp_base, my_mvcc_abort, 3);
    write_branch((uint32_t*)(base + 0x2214), tramp_base, my_mvcc_vacuum, 4);
    printf("Hooks successfully installed.\n");
}
