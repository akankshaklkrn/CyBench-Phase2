#define _GNU_SOURCE
#include <stdint.h>
#include <stdio.h>
#include <string.h>
#include <sys/mman.h>
#include <unistd.h>

extern void hook_init() __attribute__((constructor));

int my_mvcc_update(void *db, void *txn, uint32_t key, uint32_t new_value) {
    printf("MVCC_UPDATE CALLED k=%u v=%u\n", key, new_value);
    return -2;
}

void write_branch(uint32_t *target, uint32_t *tramp_base, void *func, int tramp_idx) {
    uint32_t *tramp = tramp_base + (tramp_idx * 4);
    tramp[0] = 0x58000050; // ldr x16, 8
    tramp[1] = 0xd61f0200; // br x16
    *(uint64_t*)(&tramp[2]) = (uint64_t)func;
    __builtin___clear_cache((char*)tramp, (char*)(tramp + 4));

    int64_t offset = (int64_t)tramp - (int64_t)target;
    printf("Target %p before: 0x%08x\n", target, target[0]);
    target[0] = 0x14000000 | ((offset >> 2) & 0x03FFFFFF);
    __builtin___clear_cache((char*)target, (char*)(target + 1));
    printf("Target %p after:  0x%08x\n", target, target[0]);
}

void hook_init() {
    FILE *f = fopen("/proc/self/maps", "r");
    char line[256];
    uint64_t base = 0;
    while (fgets(line, sizeof(line), f)) {
        if (strstr(line, "r-xp") && strstr(line, "mvcc_bench")) {
            sscanf(line, "%lx", &base);
            break;
        }
    }
    fclose(f);
    if(!base) return;

    long page_size = sysconf(_SC_PAGESIZE);
    uint64_t tramp_page = (base & ~(page_size - 1)) - page_size;
    void *p = MAP_FAILED;
    while (tramp_page > base - 0x7000000) {
        p = mmap((void*)tramp_page, page_size, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
        if (p != MAP_FAILED) break;
        tramp_page -= page_size;
    }
    uint32_t *tramp_base = (uint32_t*)p;
    void *mp_target = (void*)((base + 0x2000) & ~(page_size - 1));
    mprotect(mp_target, page_size, PROT_READ | PROT_WRITE | PROT_EXEC);

    write_branch((uint32_t*)(base + 0x2200), tramp_base, my_mvcc_update, 2);
}
