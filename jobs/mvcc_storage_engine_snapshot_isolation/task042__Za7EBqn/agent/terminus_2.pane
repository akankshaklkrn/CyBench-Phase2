#include <stdio.h>
#include <stdint.h>
#include <sys/mman.h>
#include <unistd.h>
#include <string.h>

extern void hook_init() __attribute__((constructor));

void my_mvcc_is_visible() { printf("Hooked is_visible!\n"); }

void hook_init() {
    FILE *f = fopen("/proc/self/maps", "r");
    char line[256];
    uint64_t base = 0;
    while (fgets(line, sizeof(line), f)) {
        if (strstr(line, "r-xp") && strstr(line, "mvcc_bench")) {
            sscanf(line, "%lx", &base);
            break;
        }
    }
    fclose(f);
    if(!base) return;

    printf("Base: 0x%lx\n", base);

    // Allocate a page nearby
    uint64_t tramp_page = (base & ~0xFFF) - 0x1000;
    void *p = MAP_FAILED;
    while (tramp_page > base - 0x7000000) {
        p = mmap((void*)tramp_page, 0x1000, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
        if (p != MAP_FAILED) break;
        tramp_page -= 0x1000;
    }
    if (p == MAP_FAILED) { printf("mmap failed\n"); return; }

    uint32_t *target = (uint32_t*)(base + 0x21e0);
    mprotect((void*)((uint64_t)target & ~0xFFF), 0x2000, PROT_READ | PROT_WRITE | PROT_EXEC);

    // trampoline for mvcc_is_visible
    uint32_t *tramp = (uint32_t*)p;
    tramp[0] = 0x58000050; // ldr x16, =my_func
    tramp[1] = 0xd61f0200; // br x16
    *(uint64_t*)(&tramp[2]) = (uint64_t)&my_mvcc_is_visible;

    // Write relative branch in original code
    int64_t offset = (int64_t)tramp - (int64_t)target;
    target[0] = 0x14000000 | ((offset >> 2) & 0x03FFFFFF);

    printf("Hook installed.\n");
}
EOF

