bool my_mvcc_is_visible(tuple_version_t *tuple, txn_t *txn) {
    if (tuple->xmin > txn->snapshot.snapshot_ts) {
        if (tuple->xmin != txn->txn_id) return false;
    } else {
        if (is_active(tuple->xmin, &txn->snapshot) && tuple->xmin != txn->txn_id) return false;
    }

    if (tuple->xmax == INF_TIMESTAMP) return true;
    if (tuple->xmax > txn->snapshot.snapshot_ts) return true;
    if (is_active(tuple->xmax, &txn->snapshot) && tuple->xmax != txn->txn_id) return true;

    return false;
}

int my_mvcc_read(mvcc_db_t *db, txn_t *txn, uint32_t key, uint32_t *out_value) {
    tuple_version_t *curr = db->index[key];
    while (curr) {
        if (my_mvcc_is_visible(curr, txn)) {
            *out_value = curr->value;
            return MVCC_OK;
        }
        curr = curr->prev;
    }
    return MVCC_ERR_NOT_FOUND;
}

int my_mvcc_update(mvcc_db_t *db, txn_t *txn, uint32_t key, uint32_t new_value) {
    tuple_version_t *head = db->index[key];
    if (head) {
        if (head->xmax != INF_TIMESTAMP || head->xmin > txn->snapshot.snapshot_ts) {
            return MVCC_ERR_SERIALIZATION_FAILURE;
        }
    }
    tuple_version_t *new_tuple = malloc(sizeof(tuple_version_t));
    new_tuple->xmin = txn->txn_id;
    new_tuple->xmax = INF_TIMESTAMP;
    new_tuple->key = key;
    new_tuple->value = new_value;
    new_tuple->prev = head;
    if (head) head->xmax = txn->txn_id;
    db->index[key] = new_tuple;
    txn->write_set[txn->write_count++] = new_tuple;
    return MVCC_OK;
}

void my_mvcc_abort(mvcc_db_t *db, txn_t *txn) {
    for (int i = 0; i < txn->write_count; i++) {
        tuple_version_t *v = txn->write_set[i];
        if (db->index[v->key] == v) {
            db->index[v->key] = v->prev;
        }
        if (v->prev) {
            v->prev->xmax = INF_TIMESTAMP;
        }
        free(v);
    }
    txn->aborted = true;
}

int my_mvcc_vacuum(mvcc_db_t *db, uint32_t oldest_active_ts) {
    int count = 0;
    for (int i = 0; i < 1024; i++) {
        tuple_version_t *curr = db->index[i];
        tuple_version_t *prev_ptr = NULL;
        while (curr) {
            if (curr != db->index[i] && curr->xmax != INF_TIMESTAMP && curr->xmax < oldest_active_ts) {
                tuple_version_t *to_free = curr;
                if (prev_ptr) {
                    prev_ptr->prev = curr->prev;
                    curr = curr->prev;
                } else {
                    db->index[i] = curr->prev;
                    curr = curr->prev;
                }
                free(to_free);
                count++;
            } else {
                prev_ptr = curr;
                curr = curr->prev;
            }
        }
    }
    return count;
}

