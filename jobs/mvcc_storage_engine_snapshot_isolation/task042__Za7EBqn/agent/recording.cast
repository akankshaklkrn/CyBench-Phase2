[694.202392, "o", "        tramp_page -= 0x1000;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if (p == MAP_FAILED) return;\r\n\u001b[?2004l\r\u001b[?2004h"]
[694.202415, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[694.202493, "o", "    uint32_t *tramp_base = (uint32_t*)p;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[694.202637, "o", "    mprotect((void*)((base + 0x2000) & ~0xFFF), 0x2000, PROT_READ | PROT_WRITE | PROT_EXEC);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
