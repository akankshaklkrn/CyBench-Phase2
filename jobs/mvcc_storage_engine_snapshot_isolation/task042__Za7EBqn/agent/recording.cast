[694.201774, "o", "    uint64_t tramp_page = (base & ~0xFFF) - 0x1000;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[694.20189, "o", "    void *p = MAP_FAILED;\r\n\u001b[?2004l\r\u001b[?2004h> "]
