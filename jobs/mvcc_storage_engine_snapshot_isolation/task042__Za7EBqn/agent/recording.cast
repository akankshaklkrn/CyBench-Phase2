[694.194906, "o", "    while (curr) {\r\n\u001b[?2004l\r\u001b[?2004h>         if (my_mvcc_is_visible(curr, txn)) {\r\n\u001b[?2004l\r\u001b[?2004h>             *out_value = curr->value;\r\n\u001b[?2004l\r\u001b[?2004h>             return MVCC_OK;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         curr = curr->prev;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
