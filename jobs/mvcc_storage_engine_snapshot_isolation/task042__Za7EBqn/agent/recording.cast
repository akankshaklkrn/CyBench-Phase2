[775.874936, "i", "cat << 'EOF' > /tmp/target_hook.c\n#include <stdint.h>\n#include <stdbool.h>\n#include <stdlib.h>\n#include <stdio.h>\n#include <string.h>\n#include <sys/mman.h>\n#include <unistd.h>\n\nextern void hook_init() __attribute__((constructor));\n\nvoid hook_init() {\n    FILE *f = fopen(\"/proc/self/maps\", \"r\");\n    char line[256];\n    uint64_t base = 0;\n    while (fgets(line, sizeof(line), f)) {\n        if (strstr(line, \"mvcc_bench\")) { // Get FIRST mapping\n            sscanf(line, \"%lx\", &base);\n            break;\n        }\n    }\n    fclose(f);\n    if(!base) { printf(\"No base found\\n\"); return; }\n\n    long page_size = sysconf(_SC_PAGESIZE);\n    printf(\"Base: 0x%lx, PAGE_SIZE: %ld\\n\", base, page_size);\n\n    uint64_t tramp_page = (base & ~(page_size - 1)) - page_size;\n    void *p = MAP_FAILED;\n    while (tramp_page > base - 0x7000000) {\n        p = mmap((void*)tramp_page, page_size, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);\n        if (p != MAP_FAILED) break;\n        tramp_p"]
[775.875285, "i", "age -= page_size;\n    }\n    if (p == MAP_FAILED) { printf(\"mmap failed\\n\"); return; }\n    printf(\"Tramp allocated at %p\\n\", p);\n\n    void *mp_target = (void*)((base + 0x2000) & ~(page_size - 1));\n    if(mprotect(mp_target, page_size * 2, PROT_READ | PROT_WRITE | PROT_EXEC) != 0) {\n        perror(\"mprotect failed\");\n    } else {\n        printf(\"mprotect ok\\n\");\n    }\n}\nEOF\n"]
