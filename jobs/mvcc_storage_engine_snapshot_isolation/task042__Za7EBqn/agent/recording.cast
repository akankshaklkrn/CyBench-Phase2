[907.129719, "i", "cat << 'EOF' > /tmp/target_hook3.c\n#define _GNU_SOURCE\n#include <stdint.h>\n#include <stdio.h>\n#include <string.h>\n#include <sys/mman.h>\n#include <unistd.h>\n\nextern void hook_init() __attribute__((constructor));\n\nint my_mvcc_update(void *db, void *txn, uint32_t key, uint32_t new_value) {\n    printf(\"MVCC_UPDATE CALLED k=%u v=%u\\n\", key, new_value);\n    return -2;\n}\n\nvoid write_branch(uint32_t *target, uint32_t *tramp_base, void *func, int tramp_idx) {\n    uint32_t *tramp = tramp_base + (tramp_idx * 4);\n    tramp[0] = 0x58000050; // ldr x16, 8\n    tramp[1] = 0xd61f0200; // br x16\n    *(uint64_t*)(&tramp[2]) = (uint64_t)func;\n    __builtin___clear_cache((char*)tramp, (char*)(tramp + 4));\n\n    int64_t offset = (int64_t)tramp - (int64_t)target;\n    printf(\"Target %p before: 0x%08x\\n\", target, target[0]);\n    target[0] = 0x14000000 | ((offset >> 2) & 0x03FFFFFF);\n    __builtin___clear_cache((char*)target, (char*)(target + 1));\n    printf(\"Target %p after:  0x%08x\\n\", target, target[0]);\n}\n\nvoid hook_init() {\n    FI"]
[907.129876, "i", "LE *f = fopen(\"/proc/self/maps\", \"r\");\n    char line[256];\n    uint64_t base = 0;\n    while (fgets(line, sizeof(line), f)) {\n        if (strstr(line, \"r-xp\") && strstr(line, \"mvcc_bench\")) {\n            sscanf(line, \"%lx\", &base);\n            break;\n        }\n    }\n    fclose(f);\n    if(!base) return;\n\n    long page_size = sysconf(_SC_PAGESIZE);\n    uint64_t tramp_page = (base & ~(page_size - 1)) - page_size;\n    void *p = MAP_FAILED;\n    while (tramp_page > base - 0x7000000) {\n        p = mmap((void*)tramp_page, page_size, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);\n        if (p != MAP_FAILED) break;\n        tramp_page -= page_size;\n    }\n    uint32_t *tramp_base = (uint32_t*)p;\n    void *mp_target = (void*)((base + 0x2000) & ~(page_size - 1));\n    mprotect(mp_target, page_size, PROT_READ | PROT_WRITE | PROT_EXEC);\n\n    write_branch((uint32_t*)(base + 0x2200), tramp_base, my_mvcc_update, 2);\n}\nEOF\n"]
