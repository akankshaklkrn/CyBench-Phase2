[588.382506, "i", "cat << 'EOF' > /tmp/hook.c\n#include <stdio.h>\n#include <stdint.h>\n#include <sys/mman.h>\n#include <unistd.h>\n#include <string.h>\n\nextern void hook_init() __attribute__((constructor));\n\nvoid my_mvcc_is_visible() { printf(\"Hooked is_visible!\\n\"); }\n\nvoid hook_init() {\n    FILE *f = fopen(\"/proc/self/maps\", \"r\");\n    char line[256];\n    uint64_t base = 0;\n    while (fgets(line, sizeof(line), f)) {\n        if (strstr(line, \"r-xp\") && strstr(line, \"mvcc_bench\")) {\n            sscanf(line, \"%lx\", &base);\n            break;\n        }\n    }\n    fclose(f);\n    if(!base) return;\n\n    printf(\"Base: 0x%lx\\n\", base);\n\n    // Allocate a page nearby\n    uint64_t tramp_page = (base & ~0xFFF) - 0x1000;\n    void *p = MAP_FAILED;\n    while (tramp_page > base - 0x7000000) {\n        p = mmap((void*)tramp_page, 0x1000, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);\n        if (p != MAP_FAILED) break;\n        tramp_page -= 0x1000;\n    }\n    if (p == MAP_FAILED) { printf(\"mmap failed\\n\""]
[588.382568, "i", "); return; }\n\n    uint32_t *target = (uint32_t*)(base + 0x21e0);\n    mprotect((void*)((uint64_t)target & ~0xFFF), 0x2000, PROT_READ | PROT_WRITE | PROT_EXEC);\n\n    // trampoline for mvcc_is_visible\n    uint32_t *tramp = (uint32_t*)p;\n    tramp[0] = 0x58000050; // ldr x16, =my_func\n    tramp[1] = 0xd61f0200; // br x16\n    *(uint64_t*)(&tramp[2]) = (uint64_t)&my_mvcc_is_visible;\n\n    // Write relative branch in original code\n    int64_t offset = (int64_t)tramp - (int64_t)target;\n    target[0] = 0x14000000 | ((offset >> 2) & 0x03FFFFFF);\n\n    printf(\"Hook installed.\\n\");\n}\nEOF\n"]
