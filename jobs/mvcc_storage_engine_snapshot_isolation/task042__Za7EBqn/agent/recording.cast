[694.195294, "o", "    tuple_version_t *head = db->index[key];\r\n\u001b[?2004l\r\u001b[?2004h>     if (head) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[694.196461, "o", "        if (head->xmax != INF_TIMESTAMP || head->xmin > txn->snapshot.snapshot_ts) {\r\n\u001b[?2004l\r\u001b[?2004h>             return MVCC_ERR_SERIALIZATION_FAILURE;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     tuple_version_t *new_tuple = malloc(sizeof(tuple_version_t));\r\n\u001b[?2004l\r"]
[694.19672, "o", "\u001b[?2004h>     new_tuple->xmin = txn->txn_id;\r\n\u001b[?2004l\r\u001b[?2004h>     new_tuple->xmax = INF_TIMESTAMP;\r\n\u001b[?2004l\r\u001b[?2004h>     new_tuple->key = key;\r\n\u001b[?2004l\r\u001b[?2004h>     new_tuple->value = new_value;\r\n\u001b[?2004l\r\u001b[?2004h>     new_tuple->prev = head;\r\n\u001b[?2004l\r\u001b[?2004h>     if (head) head->xmax = txn->txn_id;\r\n\u001b[?2004l\r\u001b[?2004h>     db->index[key] = new_tuple;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[694.197487, "o", "    txn->write_set[txn->write_count++] = new_tuple;\r\n\u001b[?2004l\r\u001b[?2004h>     return MVCC_OK;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[694.197534, "o", "void my_mvcc_abort(mvcc_db_t *db, txn_t *txn) {"]
[694.197554, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[694.197936, "o", ">     for (int i = 0; i < txn->write_count; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>         tuple_version_t *v = txn->write_set[i];\r\n\u001b[?2004l\r\u001b[?2004h>         if (db->index[v->key] == v) {\r\n\u001b[?2004l\r\u001b[?2004h>             db->index[v->key] = v->prev;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r"]
[694.198166, "o", "\u001b[?2004h>         if (v->prev) {\r\n\u001b[?2004l\r\u001b[?2004h>             v->prev->xmax = INF_TIMESTAMP;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         free(v);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[694.198273, "o", "    txn->aborted = true;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[694.198418, "o", "int my_mvcc_vacuum(mvcc_db_t *db, uint32_t oldest_active_ts) {\r\n\u001b[?2004l\r\u001b[?2004h>     int count = 0;\r\n\u001b[?2004l\r\u001b[?2004h"]
[694.198487, "o", ">     for (int i = 0; i < 1024; i++) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[694.198579, "o", ">         tuple_version_t *curr = db->index[i];\r\n\u001b[?2004l\r"]
[694.198669, "o", "\u001b[?2004h> "]
[694.198696, "o", "        tuple_version_t *prev_ptr = NULL;\r\n\u001b[?2004l\r\u001b[?2004h>         while (curr) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[694.198872, "o", "            if (curr != db->index[i] && curr->xmax != INF_TIMESTAMP && curr->xmax < oldest_active_ts) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
