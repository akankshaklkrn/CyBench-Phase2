[694.199144, "o", "                    prev_ptr->prev = curr->prev;\r\n\u001b[?2004l\r\u001b[?2004h>                     curr = curr->prev;\r\n\u001b[?2004l\r\u001b[?2004h>                 } else {\r\n\u001b[?2004l\r\u001b[?2004h"]
[694.199167, "o", "> "]
[694.199251, "o", "                    curr = curr->prev;\r\n\u001b[?2004l\r\u001b[?2004h>                 }\r\n\u001b[?2004l\r\u001b[?2004h>                 free(to_free);\r\n"]
[694.199275, "o", "\u001b[?2004l\r\u001b[?2004h"]
[694.199281, "o", "> "]
[694.19935, "o", "                count++;\r\n\u001b[?2004l\r\u001b[?2004h"]
[694.19938, "o", ">             } else {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[694.199457, "o", "                prev_ptr = curr;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[694.199488, "o", "                curr = curr->prev;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[694.199702, "o", "            }\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return count;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[694.199794, "o", "void write_branch(uint32_t *target, uint32_t *tramp_base, void *func, int tramp_idx) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[694.199833, "o", "    uint32_t *tramp = tramp_base + (tramp_idx * 4);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[694.200004, "o", "    tramp[0] = 0x58000050; // ldr x16, 8\r\n\u001b[?2004l\r\u001b[?2004h>     tramp[1] = 0xd61f0200; // br x16\r\n\u001b[?2004l\r"]
[694.200107, "o", "\u001b[?2004h> "]
[694.200201, "o", "    *(uint64_t*)(&tramp[2]) = (uint64_t)func;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[694.200363, "o", "    int64_t offset = (int64_t)tramp - (int64_t)target;\r\n\u001b[?2004l\r\u001b[?2004h>     target[0] = 0x14000000 | ((offset >> 2) & 0x03FFFFFF);\r\n"]
[694.20044, "o", "\u001b[?2004l\r\u001b[?2004h> }"]
