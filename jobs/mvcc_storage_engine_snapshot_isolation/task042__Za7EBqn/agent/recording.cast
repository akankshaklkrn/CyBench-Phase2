[840.198939, "o", "        if (p != MAP_FAILED) break;\r\n\u001b[?2004l\r\u001b[?2004h>         tramp_page -= 0x1000;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
