[1164.725586, "o", "' > /tmp/target_hook.c\r\n#include <stdint.h>\r\n#include <stdbool.h>\r\n#include <stdlib.h>\r\n#include <stdio.h>\r\n#include <string.h>\r\n#include <sys/mman.h>\r\n\r\n#define INF_TIMESTAMP 0xFFFFFFFF\r\n#define MAX_ACTIVE_TXNS 16\r\n#define MVCC_OK 0\r\n#define MVCC_ERR_NOT_FOUND -1\r\n#define MVCC_ERR_SERIALIZATION_FAILURE -2\r\n\r\ntypedef struct tuple_version_t {\r\n    uint32_t xmin;\r\n    uint32_t xmax;\r\n    uint32_t key;\r\n    uint32_t value;\r\n    struct tuple_version_t *prev;\r\n} tuple_version_t;\r\n\r\ntypedef struct snapshot_t {\r\n    uint32_t snapshot_ts;\r\n    uint32_t active_txns[MAX_ACTIVE_TXNS];\r\n    int num_active;\r\n} snapshot_t;\r\n\r\ntypedef struct txn_t {\r\n    uint32_t txn_id;\r\n    snapshot_t snapshot;\r\n    bool aborted;\r\n    uint8_t pad[3];\r\n    int write_count;\r\n    tuple_version_t *write_set[64];\r\n} txn_t;\r\n\r\ntypedef struct mvcc_db_t {\r\n    tuple_version_t *index[1024];\r\n} mvcc_db_t;\r\n\r\nextern void hook_init() __attribute__((constructor));\r\n\r\nstatic bool is_active(uint32_t txn_id, snapshot_t *snap) {\r\n    for (int i = 0; i < s"]
[1164.725593, "o", "nap->num_active; i++) {\r\n        if (snap->active_txns[i] == txn_id) return true;\r\n    }\r\n    return false;\r\n}\r\n\r\nbool my_mvcc_is_visible(tuple_version_t *tuple, txn_t *txn) {\r\n    if (tuple->xmin > txn->snapshot.snapshot_ts) {\r\n        if (tuple->xmin != txn->txn_id) return false;\r\n    } else {\r\n        if (is_active(tuple->xmin, &txn->snapshot) && tuple->xmin != txn->txn_id) return false;\r\n    }\r\n\r\n    if (tuple->xmax == INF_TIMESTAMP) return true;\r\n    if (tuple->xmax > txn->snapshot.snapshot_ts) return true;\r\n    if (is_active(tuple->xmax, &txn->snapshot) && tuple->xmax != txn->txn_id) return true;\r\n\r\n    return false;\r\n}\r\n\r\nint my_mvcc_read(mvcc_db_t *db, txn_t *txn, uint32_t key, uint32_t *out_value) {\r\n    tuple_version_t *curr = db->index[key];\r\n    while (curr) {\r\n        if (my_mvcc_is_visible(curr, txn)) {\r\n            *out_value = curr->value;\r\n            return MVCC_OK;\r\n        }\r\n        curr = curr->prev;\r\n    }\r\n    return MVCC_ERR_NOT_FOUND;\r\n}\r\n\r\nint my_mvcc_update(mvcc_db_t *db, txn_t *tx"]
[1164.725605, "o", "n, uint32_t key, uint32_t new_value) {\r\n    tuple_version_t *head = db->index[key];\r\n    if (head) {\r\n        if (head->xmax != INF_TIMESTAMP || head->xmin > txn->snapshot.snapshot_ts) {\r\n            return MVCC_ERR_SERIALIZATION_FAILURE;\r\n        }\r\n    }\r\n    tuple_version_t *new_tuple = malloc(sizeof(tuple_version_t));\r\n    new_tuple->xmin = txn->txn_id;\r\n    new_tuple->xmax = INF_TIMESTAMP;\r\n    new_tuple->key = key;\r\n    new_tuple->value = new_value;\r\n    new_tuple->prev = head;\r\n    if (head) head->xmax = txn->txn_id;\r\n    db->index[key] = new_tuple;\r\n    txn->write_set[txn->write_count++] = new_tuple;\r\n    return MVCC_OK;\r\n}\r\n\r\nvoid my_mvcc_abort(mvcc_db_t *db, txn_t *txn) {\r\n    for (int i = 0; i < txn->write_count; i++) {\r\n        tuple_version_t *v = txn->write_set[i];\r\n        if (db->index[v->key] == v) {\r\n            db->index[v->key] = v->prev;\r\n        }\r\n        if (v->prev) {\r\n            v->prev->xmax = INF_TIMESTAMP;\r\n        }\r\n        free(v);\r\n    }\r\n    txn->aborted = true;\r\n}\r\n\r\nint my"]
[1164.725618, "o", "_mvcc_vacuum(mvcc_db_t *db, uint32_t oldest_active_ts) {\r\n    int count = 0;\r\n    for (int i = 0; i < 1024; i++) {\r\n        tuple_version_t *curr = db->index[i];\r\n        tuple_version_t *prev_ptr = NULL;\r\n        while (curr) {\r\n            if (curr != db->index[i] && curr->xmax != INF_TIMESTAMP && curr->xmax < oldest_active_ts) {\r\n                tuple_version_t *to_free = curr;\r\n                if (prev_ptr) {\r\n                    prev_ptr->prev = curr->prev;\r\n                    curr = curr->prev;\r\n                } else {\r\n                    curr = curr->prev;\r\n                }\r\n                free(to_free);\r\n                count++;\r\n            } else {\r\n                prev_ptr = curr;\r\n                curr = curr->prev;\r\n            }\r\n        }\r\n    }\r\n    return count;\r\n}\r\n\r\nvoid write_branch(uint32_t *target, uint32_t *tramp_base, void *func, int tramp_idx) {\r\n    uint32_t *tramp = tramp_base + (tramp_idx * 4);\r\n    tramp[0] = 0x58000050; // ldr x16, 8\r\n    tramp[1] = 0xd61f0200; // br x16\r\n   "]
[1164.725627, "o", " *(uint64_t*)(&tramp[2]) = (uint64_t)func;\r\n    int64_t offset = (int64_t)tramp - (int64_t)target;\r\n    target[0] = 0x14000000 | ((offset >> 2) & 0x03FFFFFF);\r\n}\r\n\r\nvoid hook_init() {\r\n    FILE *f = fopen(\"/proc/self/maps\", \"r\");\r\n    char line[256];\r\n    uint64_t base = 0;\r\n    while (fgets(line, sizeof(line), f)) {\r\n        if (strstr(line, \"r-xp\") && strstr(line, \"mvcc_bench\")) {\r\n            sscanf(line, \"%lx\", &base);\r\n            break;\r\n        }\r\n    }\r\n    fclose(f);\r\n    if(!base) return;\r\n\r\n    uint64_t tramp_page = (base & ~0xFFF) - 0x1000;\r\n    void *p = MAP_FAILED;\r\n    while (tramp_page > base - 0x7000000) {\r\n        p = mmap((void*)tramp_page, 0x1000, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);\r\n        if (p != MAP_FAILED) break;\r\n        tramp_page -= 0x1000;\r\n    }\r\n    if (p == MAP_FAILED) return;\r\n\r\n    uint32_t *tramp_base = (uint32_t*)p;\r\n    mprotect((void*)((base + 0x2000) & ~0xFFF), 0x2000, PROT_READ | PROT_WRITE | PROT_EXEC);\r\n\r\n   "]
