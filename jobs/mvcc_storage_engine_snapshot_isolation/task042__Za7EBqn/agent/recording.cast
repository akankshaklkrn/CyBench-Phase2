[840.198281, "o", "        if (strstr(line, \"r-xp\") && strstr(line, \"mvcc_bench\")) {\r\n\u001b[?2004l\r\u001b[?2004h>             sscanf(line, \"%lx\", &base);\r\n\u001b[?2004l\r\u001b[?2004h>             break;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h"]
