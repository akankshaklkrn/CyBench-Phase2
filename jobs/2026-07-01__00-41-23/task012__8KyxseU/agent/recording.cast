[130.852906, "i", "cat << 'EOF' > target.c\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n\nstruct avl_node {\n    int value;\n    int height;\n    struct avl_node *left;\n    struct avl_node *right;\n};\n\nstruct avl_node *root = NULL;\n\nstatic int avl_height(struct avl_node *n) {\n    return n ? n->height : 0;\n}\n\nstatic int avl_max(int a, int b) {\n    return (a > b) ? a : b;\n}\n\nstatic struct avl_node* new_node(int value) {\n    struct avl_node* node = (struct avl_node*)malloc(sizeof(struct avl_node));\n    if (!node) exit(1);\n    node->value = value;\n    node->left = NULL;\n    node->right = NULL;\n    node->height = 1;\n    return node;\n}\n\nstatic struct avl_node *right_rotate(struct avl_node *y) {\n    struct avl_node *x = y->left;\n    struct avl_node *T2 = x->right;\n    \n    x->right = y;\n    y->left = T2;\n    \n    y->height = avl_max(avl_height(y->left), avl_height(y->right)) + 1;\n    x->height = avl_max(avl_height(x->left), avl_height(x->right)) + 1;\n    \n    return x;\n}\n\nstatic struct avl_node *left_rotate(struct avl_node *"]
[130.852962, "i", "x) {\n    struct avl_node *y = x->right;\n    struct avl_node *T2 = y->left;\n    \n    y->left = x;\n    x->right = T2;\n    \n    x->height = avl_max(avl_height(x->left), avl_height(x->right)) + 1;\n    y->height = avl_max(avl_height(y->left), avl_height(y->right)) + 1;\n    \n    return y;\n}\n\nstatic int get_balance(struct avl_node *n) {\n    return n ? avl_height(n->left) - avl_height(n->right) : 0;\n}\n\nstatic struct avl_node* avl_insert_node(struct avl_node* node, int value) {\n    if (node == NULL)\n        return new_node(value);\n        \n    if (value < node->value)\n        node->left = avl_insert_node(node->left, value);\n    else if (value > node->value)\n        node->right = avl_insert_node(node->right, value);\n    else \n        return node;\n        \n    node->height = 1 + avl_max(avl_height(node->left), avl_height(node->right));\n    \n    int balance = get_balance(node);\n    \n    if (balance > 1 && value < node->left->value)\n        return right_rotate(node);\n        \n    if (balance < -1 && value > node->right->v"]
[130.852968, "i", "alue)\n        return left_rotate(node);\n        \n    if (balance > 1 && value > node->left->value) {\n        node->left = left_rotate(node->left);\n        return right_rotate(node);\n    }\n    \n    if (balance < -1 && value < node->right->value) {\n        node->right = right_rotate(node->right);\n        return left_rotate(node);\n    }\n    \n    return node;\n}\n\nvoid avl_insert(int value) {\n    root = avl_insert_node(root, value);\n}\n\nstatic struct avl_node *min_value_node(struct avl_node *node) {\n    struct avl_node *current = node;\n    while (current->left != NULL)\n        current = current->left;\n    return current;\n}\n\nstatic struct avl_node* avl_delete_node(struct avl_node* node, int value) {\n    if (node == NULL)\n        return node;\n        \n    if (value < node->value)\n        node->left = avl_delete_node(node->left, value);\n    else if (value > node->value)\n        node->right = avl_delete_node(node->right, value);\n    else {\n        if ((node->left == NULL) || (node->right == NULL)) {\n            struct a"]
[130.852975, "i", "vl_node *temp = node->left ? node->left : node->right;\n            if (temp == NULL) {\n                temp = node;\n                node = NULL;\n            } else {\n                *node = *temp;\n            }\n            free(temp);\n        } else {\n            struct avl_node *temp = min_value_node(node->right);\n            node->value = temp->value;\n            node->right = avl_delete_node(node->right, temp->value);\n        }\n    }\n    \n    if (node == NULL)\n        return node;\n        \n    node->height = 1 + avl_max(avl_height(node->left), avl_height(node->right));\n    int balance = get_balance(node);\n    \n    if (balance > 1 && get_balance(node->left) >= 0)\n        return right_rotate(node);\n        \n    if (balance > 1 && get_balance(node->left) < 0) {\n        node->left = left_rotate(node->left);\n        return right_rotate(node);\n    }\n    \n    if (balance < -1 && get_balance(node->right) <= 0)\n        return left_rotate(node);\n        \n    if (balance < -1 && get_balance(node->right) > 0) {\n      "]
[130.852979, "i", "  node->right = right_rotate(node->right);\n        return left_rotate(node);\n    }\n    \n    return node;\n}\n\nvoid avl_delete(int value) {\n    root = avl_delete_node(root, value);\n}\n\nstatic bool verify_bst(struct avl_node *node, int min, int max) {\n    if (node == NULL) return true;\n    if (node->value <= min || node->value >= max) return false;\n    return verify_bst(node->left, min, node->value) && verify_bst(node->right, node->value, max);\n}\n\nstatic bool verify_balance(struct avl_node *node) {\n    if (node == NULL) return true;\n    int lh = avl_height(node->left);\n    int rh = avl_height(node->right);\n    if (abs(lh - rh) > 1) return false;\n    if (node->height != 1 + avl_max(lh, rh)) return false;\n    return verify_balance(node->left) && verify_balance(node->right);\n}\n\nint main(void) {\n    for (int i = 1; i <= 1000; i++) {\n        avl_insert(i);\n    }\n    for (int i = 1; i <= 500; i++) {\n        avl_delete(i * 2); \n    }\n    if (!verify_bst(root, -1000000, 1000000)) {\n        printf(\"BST property failed!\\n\""]
[130.853223, "i", ");\n        return 1;\n    }\n    if (!verify_balance(root)) {\n        printf(\"Balance property failed!\\n\");\n        return 1;\n    }\n    printf(\"FLAG: AVL-Tree Success!\\n\");\n    return 0;\n}\nEOF\n"]
