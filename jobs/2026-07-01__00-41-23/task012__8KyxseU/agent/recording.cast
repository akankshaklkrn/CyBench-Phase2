[130.864458, "o", "static bool verify_bst(struct avl_node *node, int min, int max) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[130.86455, "o", ">     if (node == NULL) return true;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.864704, "o", "    if (node->value <= min || node->value >= max) return false;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.864826, "o", "    return verify_bst(node->left, min, node->value) && verify_bst(node->right, node->value, max);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
