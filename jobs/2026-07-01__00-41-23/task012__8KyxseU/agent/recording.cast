[130.865219, "o", "    int rh = avl_height(node->right);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[130.865311, "o", "    if (abs(lh - rh) > 1) return false;\r\n\u001b[?2004l\r\u001b[?2004h> "]
