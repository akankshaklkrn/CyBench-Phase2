[943.27984, "o", "        if (ctx->tlb_entries[i].valid && ctx->tlb_entries[i].gva_tag == tag) {\r\n\u001b[?2004l\r\u001b[?2004h>             ctx->tlb_entries[i].valid = false;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h"]
[943.279944, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
