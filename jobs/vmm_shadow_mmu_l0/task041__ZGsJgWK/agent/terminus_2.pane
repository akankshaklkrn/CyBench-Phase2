void mmu_tlb_flush(mmu_ctx_t *ctx) {
    for (int i = 0; i < 16; i++) ctx->tlb_entries[i].valid = false;
}

void mmu_invlpg(mmu_ctx_t *ctx, uint32_t gva) {
    uint32_t tag = gva & ~0xFFF;
    for (int i = 0; i < 16; i++) {
        if (ctx->tlb_entries[i].valid && ctx->tlb_entries[i].gva_tag == tag) {
            ctx->tlb_entries[i].valid = false;
        }
    }
}
