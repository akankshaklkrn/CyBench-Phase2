void bloom_add(bloom_filter_t *filter, const char *key) {
    uint32_t h1 = hash_fnv1a(key);
    uint32_t h2 = hash_murmur3(key);
    for(int i=0; i<3; i++) { 
        uint32_t bit = (h1 + i * h2) % BLOOM_BITS;
        filter->bits[bit / 8] |= (1 << (bit % 8));
    }
}

bool bloom_check(const bloom_filter_t *filter, const char *key) {
    uint32_t h1 = hash_fnv1a(key);
    uint32_t h2 = hash_murmur3(key);
    for(int i=0; i<3; i++) {
        uint32_t bit = (h1 + i * h2) % BLOOM_BITS;
        if ((filter->bits[bit / 8] & (1 << (bit % 8))) == 0) {
            return false;
        }
    }
    return true;
}

