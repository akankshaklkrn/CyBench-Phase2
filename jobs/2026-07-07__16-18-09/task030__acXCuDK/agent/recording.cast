[18164.007233, "o", "history\r\n\u001b[?2004l\r    1  clear\r\n    2  cd /app\r\n    3  ls -la\r\n    4  cat target.c\r\n    5  find / -name target.c 2>/dev/null\r\n    6  ls -la /root\r\n    7  ls -la /out\r\n    8  /out/art_bench\r\n    9  find / -type f -name \"*.c\" 2>/dev/null | grep -vE \"^/usr|^/sys|^/proc|^/dev|^/lib|^/var\"\r\n   10  cat /root/.bash_history\r\n   11  find / -mmin -60 -type f 2>/dev/null | grep -vE \"^/proc|^/sys|^/dev\"\r\n   12  ldd /out/art_bench\r\n   13  file /out/art_bench\r\n   14  nm /out/art_bench | grep -i art_\r\n   15  strace -e open,openat /out/art_bench\r\n   16  strings /out/art_bench | grep \\.c\r\n   17  ls -la /\r\n   18  ls -la /src 2>/dev/null || echo 'No /src'\r\n   19  ls -la /out\r\n   20  find / -name \"*art*.c\" -o -name \"Makefile*\"\r\n   21  mkdir -p /app\r\n   22  objdump -d /out/art_bench | grep -A 30 \"<main>:\"\r\n   23  objdump -d /out/art_bench | grep -A 30 \"<art_insert>:\"\r\n   24  find / -name \"*.c\"\r\n   25  cat << 'EOF' > target.c\r\n#include <stdio.h>\r\nchar *art_lookup(void *tree, const char *key) {\r\n    return \"dummy\";\r\n}\r\nvoid art_ins"]
[18164.007304, "o", "ert(void *tree, const char *key, const char *val) {}\r\nvoid art_delete(void *tree, const char *key) {}\r\nEOF\r\n\r\n   26  gcc -shared -fPIC -o target.so target.c\r\n   27  LD_PRELOAD=./target.so /out/art_bench\r\n   28  ps aux\r\n   29  find / -name \"*.o\" -o -name \"*.a\" | grep -vE \"^/usr|^/sys|^/proc|^/dev|^/lib|^/var\"\r\n   30  mkdir /src\r\n   31  cp target.c /src/target.c\r\n   32  sleep 3\r\n   33  ls -la /out/art_bench\r\n   34  LD_PRELOAD=/lib/aarch64-linux-gnu/libasan.so.6:./target.so /out/art_bench\r\n   35  find / -name \"build*\" -o -name \"compile*\"\r\n   36  cat << 'EOF' > /root/target.c\r\n#include <stdio.h>\r\nchar *art_lookup(void *tree, const char *key) {\r\n    printf(\"HOOK: art_lookup(%s)\\n\", key);\r\n    return \"dummy\";\r\n}\r\nvoid art_insert(void *tree, const char *key, const char *val) {\r\n    printf(\"HOOK: art_insert(%s)\\n\", key);\r\n}\r\nvoid art_delete(void *tree, const char *key) {}\r\nEOF\r\n\r\n   37  cd /root && gcc -shared -fPIC -o target.so target.c\r\n   38  LD_PRELOAD=/lib/aarch64-linux-gnu/libasan.so.6:/root/target.so /out/art_"]
