[216.881832, "i", "cat << 'EOF' > /target.c\n#include <stdint.h>\n#include <stddef.h>\n\n#define BPF_MAX_REG 11\n#define BPF_MAX_INSNS 64\n\ntypedef enum {\n    BPF_REG_NOT_INIT = 0,\n    BPF_REG_SCALAR = 1,\n    BPF_REG_PTR_TO_CTX = 2,\n    BPF_REG_PTR_TO_MAP_VALUE = 3,\n    BPF_REG_PTR_TO_STACK = 4\n} bpf_reg_type_t;\n\ntypedef struct {\n    bpf_reg_type_t type;\n    int64_t smin_val;\n    int64_t smax_val;\n    uint32_t map_value_size;\n    int64_t ptr_offset;\n} bpf_reg_state_t;\n\ntypedef struct {\n    bpf_reg_state_t regs[BPF_MAX_REG];\n    uint8_t stack_init[512]; \n} bpf_verifier_state_t;\n\ntypedef enum {\n    BPF_OP_MOV = 0,      \n    BPF_OP_ADD = 1,      \n    BPF_OP_SUB = 2,      \n    BPF_OP_LDX = 3,      \n    BPF_OP_STX = 4,      \n    BPF_OP_JEQ = 5,      \n    BPF_OP_JGT = 6,      \n    BPF_OP_EXIT = 7      \n} bpf_opcode_t;\n\ntypedef struct {\n    bpf_opcode_t opcode;\n    uint8_t dst_reg;\n    uint8_t src_reg;\n    int16_t off;\n    int64_t imm;\n    uint32_t map_size_meta; \n} bpf_insn_t;\n\nvoid bpf_init_state(bpf_verifier_state_t *st) {\n    for (int i"]
[216.881877, "i", " = 0; i < BPF_MAX_REG; i++) {\n        st->regs[i].type = BPF_REG_NOT_INIT;\n        st->regs[i].smin_val = 0;\n        st->regs[i].smax_val = 0;\n        st->regs[i].map_value_size = 0;\n        st->regs[i].ptr_offset = 0;\n    }\n    st->regs[1].type = BPF_REG_PTR_TO_CTX;\n    st->regs[1].ptr_offset = 0;\n    st->regs[1].smin_val = 0;\n    st->regs[1].smax_val = 0;\n\n    st->regs[10].type = BPF_REG_PTR_TO_STACK;\n    st->regs[10].ptr_offset = 0;\n    st->regs[10].smin_val = 0;\n    st->regs[10].smax_val = 0;\n\n    for (int i = 0; i < 512; i++) {\n        st->stack_init[i] = 0;\n    }\n}\n\nint bpf_check_reg_read(const bpf_verifier_state_t *st, uint8_t regno) {\n    if (regno >= BPF_MAX_REG) return -1;\n    if (st->regs[regno].type == BPF_REG_NOT_INIT) return -1;\n    return 0;\n}\n\nint bpf_verify_alu(bpf_verifier_state_t *st, const bpf_insn_t *insn) {\n    if (insn->dst_reg >= BPF_MAX_REG || insn->dst_reg == 10) return -1;\n    \n    int is_imm = (insn->src_reg == 255);\n    int is_map_imm = (insn->src_reg == 254);\n    \n    if (!is_imm"]
[216.882079, "i", " && !is_map_imm) {\n        if (insn->src_reg >= BPF_MAX_REG) return -1;\n        if (bpf_check_reg_read(st, insn->src_reg) < 0) return -1;\n    }\n\n    if (insn->opcode == BPF_OP_MOV) {\n        if (!is_imm && !is_map_imm) {\n            st->regs[insn->dst_reg] = st->regs[insn->src_reg];\n        } else if (is_imm) {\n            st->regs[insn->dst_reg].type = BPF_REG_SCALAR;\n            st->regs[insn->dst_reg].smin_val = insn->imm;\n            st->regs[insn->dst_reg].smax_val = insn->imm;\n            st->regs[insn->dst_reg].ptr_offset = 0;\n            st->regs[insn->dst_reg].map_value_size = 0;\n        } else if (is_map_imm) {\n            st->regs[insn->dst_reg].type = BPF_REG_PTR_TO_MAP_VALUE;\n            st->regs[insn->dst_reg].map_value_size = insn->map_size_meta;\n            st->regs[insn->dst_reg].ptr_offset = insn->imm;\n            st->regs[insn->dst_reg].smin_val = 0;\n            st->regs[insn->dst_reg].smax_val = 0;\n        }\n        return 0;\n    } else if (insn->opcode == BPF_OP_ADD || insn->opcode == BPF"]
[216.882106, "o", "cat << 'EOF' > /target.c\r\n\u001b[?2004l\r\u001b[?2004h> #include <stdint.h>\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.882189, "i", "_OP_SUB) {\n        bpf_reg_state_t *dst = &st->regs[insn->dst_reg];\n        bpf_reg_state_t src_reg_st;\n        if (!is_imm && !is_map_imm) src_reg_st = st->regs[insn->src_reg];\n\n        if (dst->type == BPF_REG_PTR_TO_MAP_VALUE || dst->type == BPF_REG_PTR_TO_STACK || dst->type == BPF_REG_PTR_TO_CTX) {\n            if (!is_imm && src_reg_st.type != BPF_REG_SCALAR) return -2;\n            int64_t op_val = is_imm ? insn->imm : src_reg_st.smin_val;\n            \n            if (insn->opcode == BPF_OP_ADD) {\n                dst->ptr_offset += op_val;\n            } else {\n                dst->ptr_offset -= op_val;\n            }\n\n            if (dst->type == BPF_REG_PTR_TO_MAP_VALUE) {\n                if (dst->ptr_offset < 0 || dst->ptr_offset >= (int64_t)dst->map_value_size) return -3;\n            }\n            return 0;\n        } else if (dst->type == BPF_REG_SCALAR) {\n            if (!is_imm && src_reg_st.type != BPF_REG_SCALAR) return -2;\n            int64_t op_smin = is_imm ? insn->imm : src_reg_st.smin_val;\n    "]
[216.882254, "o", "#include <stddef.h>\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> #define BPF_MAX_REG 11\r\n\u001b[?2004l\r\u001b[?2004h> #define BPF_MAX_INSNS 64\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
