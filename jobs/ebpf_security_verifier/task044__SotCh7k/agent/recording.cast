[216.902806, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> int bpf_verify_prog(const bpf_insn_t *insns, int num_insns) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.902917, "o", "    bpf_verifier_state_t st;\r\n\u001b[?2004l\r\u001b[?2004h>     bpf_init_state(&st);\r\n\u001b[?2004l\r\u001b[?2004h>     int pc = 0;\r\n\u001b[?2004l\r\u001b[?2004h>     while (pc < num_insns) {\r\n\u001b[?2004l\r\u001b[?2004h>         if (pc < 0 || pc >= num_insns) return -7;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.903021, "o", "        const bpf_insn_t *insn = &insns[pc];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.903171, "o", "        if (insn->opcode == BPF_OP_MOV || insn->opcode == BPF_OP_ADD || insn->opcode == BPF_OP_SUB) {\r\n\u001b[?2004l\r\u001b[?2004h>             int ret = bpf_verify_alu(&st, insn);\r\n\u001b[?2004l\r\u001b[?2004h>             if (ret < 0) return ret;\r\n\u001b[?2004l\r"]
[216.903389, "o", "\u001b[?2004h>         } else if (insn->opcode == BPF_OP_LDX || insn->opcode == BPF_OP_STX) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.903447, "o", "            int ret = bpf_verify_mem(&st, insn);\r\n\u001b[?2004l\r\u001b[?2004h>             if (ret < 0) return ret;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.903721, "o", "        } else if (insn->opcode == BPF_OP_JEQ || insn->opcode == BPF_OP_JGT) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.903953, "o", "            if (insn->dst_reg >= BPF_MAX_REG) return -1;\r\n\u001b[?2004l\r\u001b[?2004h"]
[216.904164, "o", ">             if (bpf_check_reg_read(&st, insn->dst_reg) < 0) return -1;\r\n\u001b[?2004l\r"]
[216.90422, "o", "\u001b[?2004h>             int target_pc = pc + 1 + insn->off;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.904345, "o", "            if (target_pc < 0 || target_pc >= num_insns) return -7;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.904475, "o", "        } else if (insn->opcode == BPF_OP_EXIT) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.904501, "o", "            if (bpf_check_reg_read(&st, 0) < 0) return -1;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.904664, "o", "            if (st.regs[0].type != BPF_REG_SCALAR) return -8;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.90477, "o", "            return 0;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         pc++;\r\n\u001b[?2004l\r"]
