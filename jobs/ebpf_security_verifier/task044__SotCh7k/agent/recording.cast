[216.899162, "o", "            st->regs[insn->dst_reg].type = BPF_REG_SCALAR;\r\n\u001b[?2004l\r\u001b[?2004h>             st->regs[insn->dst_reg].smin_val = 0;\r\n\u001b[?2004l\r\u001b[?2004h> "]
