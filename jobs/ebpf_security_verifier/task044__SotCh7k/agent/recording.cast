[216.897835, "o", "        int64_t e_off = src->ptr_offset + insn->off;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[216.89805, "o", "        if (src->type == BPF_REG_PTR_TO_MAP_VALUE || src->type == BPF_REG_PTR_TO_CTX) {\r\n\u001b[?2004l\r\u001b[?2004h>             if (src->type == BPF_REG_PTR_TO_MAP_VALUE) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
